{% extends "_layout.twig" %}

{% block body %}

	<h3>{% if categorie.id %}Modifier{% else %}Nouvelle{% endif %} catégorie</h3>
	<hr>

	{# Affichage des erreurs de validation #}
	{% if form_errors is defined and form_errors %}
		{% for key, message in form_errors %}
			<div class="alert alert-danger">
				<i class="fas fa-exclamation-triangle"></i> {{ message }}
			</div>
		{% endfor %}
	{% endif %}

	<form method="post" enctype="multipart/form-data">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">

		<div class="mb-3">
			<label for="libelle">Libellé * :</label>
			<input type="text"
			       id="libelle"
			       name="libelle"
			       value="{{ categorie.libelle }}"
			       class="form-control{% if form_errors.libelle is defined and form_errors.libelle %} is-invalid{% endif %}"
			       maxlength="32"
			       required>
			{% if form_errors.libelle is defined and form_errors.libelle %}
				<div class="invalid-feedback d-block">{{ form_errors.libelle }}</div>
			{% endif %}
		</div>

		<div class="mb-3">
			<label for="code">Code :</label>
			<input type="text"
			       id="code"
			       name="code"
			       value="{{ categorie.code }}"
			       class="form-control{% if form_errors.code is defined and form_errors.code %} is-invalid{% endif %}"
			       maxlength="8"
			       style="max-width: 12rem; text-transform: uppercase;"
			       placeholder="ex. COR">
			<small class="form-text text-muted">
				Code utilisé dans la référence automatique des équipements (2 à 8 caractères, lettres sans accent ou chiffres).
				Laisser vide pour une suggestion automatique à partir du libellé.
			</small>
			{% if form_errors.code is defined and form_errors.code %}
				<div class="invalid-feedback d-block">{{ form_errors.code }}</div>
			{% endif %}
		</div>

		<div class="mb-3">
			<label for="description">Description :</label>
			<textarea id="description" name="description" class="form-control" rows="3">{{ categorie.description }}</textarea>
		</div>

		<div class="mb-3 form-check">
			<input type="checkbox" id="est_epi" name="est_epi" class="form-check-input" {% if categorie.est_epi %}checked{% endif %}>
			<label class="form-check-label" for="est_epi">Classée EPI</label>
		</div>

		<div class="mb-3 form-check">
			<input type="checkbox" id="duree_max_utilisation" name="duree_max_utilisation" class="form-check-input" {% if categorie.duree_max_utilisation %}checked{% endif %}>
			<label class="form-check-label" for="duree_max_utilisation">Durée maximum d'utilisation</label>
			<small class="form-text text-muted d-block">
				Cocher si les équipements de cette catégorie ont une durée de vie limitée par le fabricant
				(généralement 10 ans, date de péremption). Valeur par défaut, modifiable sur chaque fiche équipement.
			</small>
		</div>

		<div class="mb-3 form-check">
			<input type="checkbox" id="textile_remplacable" name="textile_remplacable" class="form-check-input" {% if categorie.textile_remplacable|default(false) %}checked{% endif %}>
			<label class="form-check-label" for="textile_remplacable">Élément textile remplaçable</label>
			<small class="form-text text-muted d-block">
				Cocher si l'élément textile de ces équipements peut être changé (ex. sangle de dégaine). Un équipement
				en maintenance dont le contrôleur constate le remplacement repart alors pour 10 ans. Valeur par défaut,
				modifiable sur chaque fiche équipement.
			</small>
		</div>

		<div class="mb-3">
			<label for="image">Image :</label>
			<input type="file"
			       id="image"
			       name="image"
			       accept="image/jpeg,image/png,image/webp,image/gif,image/avif"
			       class="form-control{% if form_errors.image is defined and form_errors.image %} is-invalid{% endif %}">
			{% if form_errors.image is defined and form_errors.image %}
				<div class="invalid-feedback d-block">{{ form_errors.image }}</div>
			{% endif %}
			{% if categorie.image %}
				<small class="form-text text-muted">Image actuelle : {{ categorie.image }}</small>
			{% endif %}
		</div>

		<div class="form-actions">
			<button type="submit" class="btn btn-primary">Enregistrer</button>
			<a href="/admin/categories" class="btn btn-secondary">Annuler</a>
		</div>
	</form>

	<script>
	// Pré-remplissage du code à partir du libellé : 3 premières lettres
	// normalisées (majuscules, accents retirés), tant que le champ code
	// n'a pas été modifié manuellement. La suggestion définitive (avec
	// gestion des collisions CO1, CO2…) est faite côté serveur.
	(function () {
		var libelle = document.getElementById('libelle');
		var code = document.getElementById('code');
		var codeTouche = code.value !== '';

		code.addEventListener('input', function () {
			codeTouche = code.value !== '';
		});

		libelle.addEventListener('input', function () {
			if (codeTouche) {
				return;
			}
			var normalise = libelle.value
				.normalize('NFD')
				.replace(/[̀-ͯ]/g, '') // diacritiques U+0300–U+036F
				.toUpperCase()
				.replace(/[^A-Z0-9]/g, '');
			code.value = normalise.substring(0, 3);
		});
	})();
	</script>

{% endblock %}