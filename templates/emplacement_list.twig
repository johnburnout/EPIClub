{% extends "_layout.twig" %}

{% block body %}
	<h3>Emplacements</h3>
	<hr>
	{% if isGranted('ROLE_ADMIN') %}
	<a href="/admin/emplacements/nouveau" class="btn btn-primary">Saisir un emplacement</a>
	<hr>
	{% endif %}
	{% include '_filtres_referentiel.twig' with {
		url: '/admin/emplacements', placeholder: 'Libellé, description',
		tris: {'libelle': 'Libellé', 'equipements': 'Nombre d\'équipements'},
		affiches: emplacements|length, element: 'emplacement', elements: 'emplacements'
	} %}
	<table class="table table-striped">
		<thead>
			<tr>
				<th>Libellé</th>
				<th>Description</th>
				<th>Équipements</th>
				<th>Actions</th>
			</tr>
		</thead>
		<tbody>
			{% for emplacement in emplacements %}
				<tr>
					<td>{{ emplacement.libelle }}</td>
					<td>{{ emplacement.description }}</td>
					<td>
						{% set nb = nb_equipements[emplacement.id]|default(0) %}
						{% if nb > 0 %}
							<a href="/equipements?emplacement={{ emplacement.id }}" title="Afficher ces équipements">{{ nb }} équipement{{ nb > 1 ? 's' : '' }}</a>
						{% else %}
							<span class="text-muted">Aucun</span>
						{% endif %}
					</td>
					<td>
						<a href="/admin/emplacements/emplacement-{{ emplacement.id }}" class="btn btn-sm btn-primary">Voir</a>
						{% if isGranted('ROLE_ADMIN') %}
						<a href="/admin/emplacements/emplacement_modification-{{ emplacement.id }}" class="btn btn-sm btn-warning">Modifier</a>
						<form method="post" action="/admin/emplacements/supprimer" style="display:inline;">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
							<input type="hidden" name="id" value="{{ emplacement.id }}">
							<button type="submit" class="btn btn-sm btn-danger"
							        onclick="return confirm('Supprimer cet emplacement ?')">
								Supprimer
							</button>
						</form>
						{% endif %}
					</td>
				</tr>
			{% else %}
				<tr><td colspan="4" class="text-muted">Aucun emplacement ne correspond à ces critères.</td></tr>
			{% endfor %}
		</tbody>
	</table>
{% endblock %}