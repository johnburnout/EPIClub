{% extends "_layout.twig" %}

{% block body %}

	<h3>Gestion du club</h3>
	<hr>

	<form method="post">
		<div class="mb-3">
			<label for="nom">Nom du club * :</label>
			<input type="text" id="nom" name="nom" value="{{ club.nom }}" class="form-control {% if form_errors.nom %}is-invalid{% endif %}">
			{% if form_errors.nom %}<div class="invalid-feedback">{{ form_errors.nom }}</div>{% endif %}
		</div>

		<div class="mb-3">
			<label for="activite">Activité :</label>
			<select id="activite" name="activite" class="form-control {% if form_errors.activite %}is-invalid{% endif %}">
				<option value="">-- Sélectionnez une activité --</option>
				{% for activite in activites|tri_alpha %}
					<option value="{{ activite }}" {% if club.activite == activite %}selected{% endif %}>
						{{ activite }}
					</option>
				{% endfor %}
			</select>
			{% if form_errors.activite %}<div class="invalid-feedback">{{ form_errors.activite }}</div>{% endif %}
		</div>

		<div class="mb-3">
			<label for="email">Email :</label>
			<input type="email" id="email" name="email" value="{{ club.email }}" class="form-control {% if form_errors.email %}is-invalid{% endif %}">
			{% if form_errors.email %}<div class="invalid-feedback">{{ form_errors.email }}</div>{% endif %}
		</div>

		<div class="mb-3">
			<label for="phone">Téléphone :</label>
			<input type="tel" id="phone" name="phone" value="{{ club.phone }}" class="form-control {% if form_errors.phone %}is-invalid{% endif %}">
			{% if form_errors.phone %}<div class="invalid-feedback">{{ form_errors.phone }}</div>{% endif %}
		</div>

		<div class="mb-3">
			<label for="description">Description :</label>
			<textarea id="description" name="description" class="form-control" rows="5">{{ club.description }}</textarea>
		</div>

		<h5 class="mt-4">Modules</h5>
		<div class="mb-3 form-check">
			<input type="checkbox" class="form-check-input" id="pret_actif" name="pret_actif" value="1"
				{% if club.pret_actif|default(false) %}checked{% endif %}>
			<label class="form-check-label" for="pret_actif"><strong>Gestionnaire de prêt de matériel</strong></label>
			<small class="form-text text-muted d-block">
				Fiches de prêt (emprunteur, dates, matériel, signature, export PDF), statuts « Prêté » et « Égaré ».
				Accessible aux contrôleurs et administrateurs (menu « Prêts »).
			</small>
		</div>

		<h5 class="mt-4">Équipements</h5>
		<div class="mb-3" style="max-width: 24rem;">
			<label for="delai_suppression_egare_mois" class="form-label">Délai avant suppression d'un équipement égaré (mois)</label>
			<input type="number" min="1" max="120" step="1" id="delai_suppression_egare_mois" name="delai_suppression_egare_mois"
				value="{{ club.delai_suppression_egare_mois|default(12) }}"
				class="form-control {% if form_errors.delai_suppression_egare_mois is defined %}is-invalid{% endif %}">
			{% if form_errors.delai_suppression_egare_mois is defined %}<div class="invalid-feedback">{{ form_errors.delai_suppression_egare_mois }}</div>{% endif %}
			<small class="form-text text-muted">Un équipement « Égaré » peut être supprimé par un administrateur une fois ce délai écoulé depuis sa déclaration (12 mois par défaut).</small>
		</div>

		<div class="form-actions">
			<input type="hidden" name="csrf_token" value="{{ csrf_token }}">
			<button type="submit" class="btn btn-primary">Enregistrer</button>
			<a href="/tableau_de_bord" class="btn btn-secondary">Retour au tableau de bord</a>
		</div>
	</form>

{% endblock %}