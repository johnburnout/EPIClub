{# [Localisation] Sélecteur de langue (cf. LangueController), inclus par
   _layout.twig et par les pages de connexion qui ne l'étendent pas.
   classe_bouton : style du bouton (clair sur le bandeau, contour bleu ailleurs). #}
<div class="dropdown me-2">
	<button class="btn {{ classe_bouton|default('btn-outline-light') }} dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="{{ 'Langue'|trans }}" aria-label="{{ 'Langue'|trans }}">🌐 <span class="text-uppercase">{{ langue() }}</span></button>
	<form method="post" action="/langue" class="dropdown-menu dropdown-menu-end">
		<input type="hidden" name="csrf_token" value="{{ csrf_token }}">
		{% for code, nom in langues_disponibles %}
		<button type="submit" name="langue" value="{{ code }}" lang="{{ code }}" class="dropdown-item{{ code == langue() ? ' active' }}">{{ nom }}</button>
		{% endfor %}
	</form>
</div>
