{% extends "_layout.twig" %}

{% block body %}
	<h3>📷 Scanner — prêt n° {{ pret.id }} ({{ pret.emprunteur_prenom }} {{ pret.emprunteur_nom }})</h3>
	<hr>

	<div id="scanner-alerte-https" class="alert alert-danger" style="display:none; max-width: 40rem;">
		<strong>Caméra indisponible :</strong> le navigateur n'autorise la caméra que sur une
		page servie en <strong>HTTPS</strong> (ou en localhost). Ajoutez le matériel depuis la fiche du prêt.
	</div>

	<div class="alert alert-info" style="max-width: 40rem;">
		Chaque matériel scanné est ajouté au prêt (s'il est disponible) ; enchaînez les scans,
		puis revenez à la fiche du prêt.
	</div>

	<div id="scanner-zone" style="max-width: 40rem;">
		<div id="qr-reader" style="width: 100%;"></div>
	</div>

	<div id="scan-messages" class="mt-3" style="max-width: 40rem;"></div>

	<h6 class="mt-3">Matériel du prêt :</h6>
	<ul id="scan-liste" class="list-group" style="max-width: 40rem;">
		{% for l in lignes %}
			<li class="list-group-item">{{ l.reference }} — {{ l.libelle }}</li>
		{% endfor %}
	</ul>
	<div class="mt-3">
		<a href="/prets/pret-{{ pret.id }}" class="btn btn-primary">✅ Terminer — revenir à la fiche du prêt</a>
	</div>
{% endblock %}

{% block javascripts %}
	{{ parent() }}
	<script src="/assets/js/html5-qrcode.min.js"></script>
	<script>
	(function () {
		const pretId = {{ pret.id|json_encode|raw }};
		const csrfToken = {{ csrf_token|json_encode|raw }};
		const messages = document.getElementById('scan-messages');
		const liste = document.getElementById('scan-liste');

		if (!window.isSecureContext) {
			document.getElementById('scanner-alerte-https').style.display = 'block';
			document.getElementById('scanner-zone').style.display = 'none';
			return;
		}

		function bip(ok) {
			try {
				const ctx = new (window.AudioContext || window.webkitAudioContext)();
				const osc = ctx.createOscillator();
				const gain = ctx.createGain();
				osc.frequency.value = ok ? 880 : 220;
				gain.gain.value = 0.08;
				osc.connect(gain).connect(ctx.destination);
				osc.start();
				osc.stop(ctx.currentTime + 0.12);
			} catch (e) { /* audio indisponible */ }
		}

		function afficher(type, texte) {
			const div = document.createElement('div');
			div.className = 'alert alert-' + type + ' py-2';
			div.textContent = texte;
			messages.prepend(div);
			while (messages.children.length > 3) {
				messages.removeChild(messages.lastChild);
			}
		}

		let enCours = false;
		let dernierScan = '';
		let dernierScanAt = 0;

		function onScanSuccess(decodedText) {
			const match = decodedText.match(/\/qr\/(\d+)/) || decodedText.match(/^(\d+)$/);
			if (!match) {
				return;
			}
			const now = Date.now();
			if (enCours || (decodedText === dernierScan && now - dernierScanAt < 3000)) {
				return;
			}
			enCours = true;
			dernierScan = decodedText;
			dernierScanAt = now;

			const body = new URLSearchParams();
			body.set('pret_id', pretId);
			body.set('equipement_id', match[1]);
			body.set('csrf_token', csrfToken);

			fetch('/prets/scanner/ajouter', {
				method: 'POST',
				headers: {'Content-Type': 'application/x-www-form-urlencoded'},
				body: body.toString()
			})
				.then((r) => r.json())
				.then((data) => {
					if (data.statut === 'ajoute') {
						bip(true);
						afficher('success', '✅ ' + data.reference + ' — ' + data.libelle + ' : ajouté au prêt.');
						const li = document.createElement('li');
						li.className = 'list-group-item list-group-item-success';
						li.textContent = data.reference + ' — ' + data.libelle;
						liste.prepend(li);
					} else if (data.statut === 'deja') {
						bip(false);
						afficher('warning', '⚠️ ' + data.reference + ' — ' + data.libelle + ' : déjà sur ce prêt.');
					} else {
						bip(false);
						afficher('danger', '❌ ' + (data.message || 'Ajout impossible.'));
					}
				})
				.catch(() => {
					bip(false);
					afficher('danger', '❌ Erreur réseau — vérifiez la connexion et réessayez.');
				})
				.finally(() => { enCours = false; });
		}

		const scanner = new Html5Qrcode('qr-reader');
		scanner.start(
			{ facingMode: 'environment' },
			{ fps: 10, qrbox: { width: 250, height: 250 } },
			onScanSuccess,
			undefined
		).catch(() => {
			afficher('danger', 'Impossible d\'accéder à la caméra. Vérifiez les autorisations du navigateur.');
		});
	})();
	</script>
{% endblock %}
