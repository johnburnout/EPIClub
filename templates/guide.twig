{% extends "_layout.twig" %}

{% block body %}
<div class="container mt-4">
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h4 class="mb-0"><i class="fas fa-book"></i> Guide d'utilisation</h4>
                    <button onclick="window.print()" class="btn btn-light btn-sm">
                        <i class="fas fa-print"></i> Imprimer
                    </button>
                </div>
                <div class="card-body guide-content">
                    {{ guide_content|raw }}
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .guide-content h1 {
        font-size: 2rem;
        margin-top: 1.5rem;
        margin-bottom: 1rem;
        border-bottom: 2px solid #3498db;
        padding-bottom: 0.5rem;
    }
    .guide-content h2 {
        font-size: 1.5rem;
        margin-top: 1.2rem;
        margin-bottom: 0.8rem;
        border-bottom: 1px solid #dee2e6;
        padding-bottom: 0.3rem;
    }
    .guide-content h3 {
        font-size: 1.2rem;
        margin-top: 1rem;
        margin-bottom: 0.5rem;
    }
    .guide-content ul, .guide-content ol {
        margin-bottom: 1rem;
        padding-left: 2rem;
    }
    .guide-content li {
        margin-bottom: 0.3rem;
    }
    .guide-content blockquote {
        border-left: 4px solid #3498db;
        padding-left: 1rem;
        margin: 1rem 0;
        color: #6c757d;
    }
    .guide-content code {
        background: #f8f9fa;
        padding: 0.2rem 0.4rem;
        border-radius: 3px;
        font-size: 0.9rem;
        color: #dc3545;
    }
    .guide-content pre {
        background: #f8f9fa;
        padding: 1rem;
        border-radius: 5px;
        overflow-x: auto;
        margin: 1rem 0;
    }
    .guide-content table {
        width: 100%;
        border-collapse: collapse;
        margin: 1rem 0;
    }
    .guide-content th, .guide-content td {
        border: 1px solid #dee2e6;
        padding: 0.5rem;
    }
    .guide-content th {
        background: #f8f9fa;
    }
    @media print {
        .navbar, .btn, .footer {
            display: none !important;
        }
        .card-header {
            background-color: #fff !important;
            color: #000 !important;
        }
    }
</style>
{% endblock %}