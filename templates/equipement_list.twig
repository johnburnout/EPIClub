{% extends "_layout.twig" %}

{% block body %}
	<h3>Equipements</h3>
    <hr>

    {% if filtres.fin_avant %}
    <div class="alert alert-warning d-flex flex-wrap justify-content-between align-items-center gap-2">
        <span>
            ⚠️ <strong>Équipements à renouveler</strong> : date de fin d'utilisation au plus tard le
            {{ filtres.fin_avant|date('d/m/Y') }} (y compris les équipements déjà échus).
        </span>
        <a href="/equipements" class="btn btn-sm btn-outline-secondary">Retirer ce filtre</a>
    </div>
    {% endif %}

    {# [2026-10-25] Équipements d'un fournisseur (depuis la liste des fournisseurs) #}
    {% if fournisseur_filtre|default(null) %}
    <div class="alert alert-info d-flex flex-wrap justify-content-between align-items-center gap-2">
        <span>🏷️ Équipements du fournisseur <strong>{{ fournisseur_filtre.nom }}</strong></span>
        <a href="/equipements" class="btn btn-sm btn-outline-secondary">Retirer ce filtre</a>
    </div>
    {% endif %}

    <!-- Filtres + Tri + Limite -->
    <form method="get" class="mb-3">
        {% if filtres.fin_avant %}
        <input type="hidden" name="fin_avant" value="{{ filtres.fin_avant }}">
        {% endif %}
        {% if filtres.fournisseur|default(null) %}
        <input type="hidden" name="fournisseur" value="{{ filtres.fournisseur }}">
        {% endif %}
        <!-- LIGNE 1 : Filtres -->
        <div class="row g-3">
            <div class="col-md-2">
                <label for="categorie" class="form-label">Catégorie</label>
                <select name="categorie" id="categorie" class="form-select">
                    <option value="">Toutes</option>
                    {% for categorie in categories|tri_alpha('libelle') %}
                    <option value="{{ categorie.id }}" {% if filtres.categorie_id == categorie.id %}selected{% endif %}>
                        {{ categorie.libelle }}
                    </option>
                    {% endfor %}
                </select>
            </div>
            
            <div class="col-md-2">
                <label for="emplacement" class="form-label">Emplacement</label>
                <select name="emplacement" id="emplacement" class="form-select">
                    <option value="">Tous</option>
                    <option value="null" {% if filtres.emplacement_id == 'null' %}selected{% endif %}>Non défini</option>
                    {% for emplacement in emplacements|tri_alpha('libelle') %}
                    <option value="{{ emplacement.id }}" {% if filtres.emplacement_id == emplacement.id %}selected{% endif %}>
                        {{ emplacement.libelle }}
                    </option>
                    {% endfor %}
                </select>
            </div>
            
            <div class="col-md-1">
                <label for="epi" class="form-label">EPI</label>
                <select name="epi" id="epi" class="form-select">
                    <option value="">Tous</option>
                    <option value="1" {% if filtres.epi == '1' %}selected{% endif %}>Oui</option>
                    <option value="0" {% if filtres.epi == '0' %}selected{% endif %}>Non</option>
                </select>
            </div>
            
            <div class="col-md-2">
                <label for="en_service" class="form-label">Statut</label>
                <select name="en_service" id="en_service" class="form-select">
                    <option value="">Tous</option>
                    <option value="oui" {% if filtres.en_service == 'oui' %}selected{% endif %}>En service</option>
                    <option value="non" {% if filtres.en_service == 'non' %}selected{% endif %}>Hors service</option>
                </select>
            </div>
            <!-- Recherche (référence ou libellé) -->
            <div class="col-md-3">
                <label for="q" class="form-label">Recherche</label>
                <input type="search" name="q" id="q" value="{{ filtres.q }}" maxlength="100"
                       class="form-control" placeholder="Libellé ou référence">
            </div>
            <!-- Filtre Dernier contrôle -->
            <div class="col-md-2">
                <label for="dernier_controle" class="form-label">Dernier contrôle</label>
                <select name="dernier_controle" id="dernier_controle" class="form-select">
                    <option value="">Tous</option>
                    <option value="plus_1_an" {% if filtres.dernier_controle == 'plus_1_an' %}selected{% endif %}>Plus d'un an</option>
                    <option value="moins_1_an" {% if filtres.dernier_controle == 'moins_1_an' %}selected{% endif %}>Moins d'un an</option>
                </select>
            </div>
        </div>

        <!-- LIGNE 2 : Tri, limite et boutons -->
        <div class="row g-3 mt-2">
            <div class="col-md-2">
                <label for="order_by" class="form-label">Trier par</label>
                <select name="order_by" id="order_by" class="form-select">
                    <option value="categorie" {% if filtres.order_by == 'categorie' %}selected{% endif %}>Catégorie</option>
                    <option value="date_fin" {% if filtres.order_by == 'date_fin' %}selected{% endif %}>Date de fin</option>
                    <option value="date_dernier_controle" {% if filtres.order_by == 'date_dernier_controle' %}selected{% endif %}>Dernier contrôle</option>
                </select>
            </div>
            
            <div class="col-md-2">
                <label for="order_dir" class="form-label">Ordre</label>
                <select name="order_dir" id="order_dir" class="form-select">
                    <option value="asc" {% if filtres.order_dir == 'asc' %}selected{% endif %}>Croissant</option>
                    <option value="desc" {% if filtres.order_dir == 'desc' %}selected{% endif %}>Décroissant</option>
                </select>
            </div>
            
            {% if pagination.total > 5 %}
            <div class="col-md-2">
                <label for="limit" class="form-label">Lignes par page</label>
                <select name="limit" id="limit" class="form-select" onchange="this.form.submit()">
                    <option value="5" {% if filtres.limit == 5 %}selected{% endif %}>5</option>
                    <option value="10" {% if filtres.limit == 10 %}selected{% endif %}>10</option>
                    <option value="25" {% if filtres.limit == 25 %}selected{% endif %}>25</option>
                    <option value="50" {% if filtres.limit == 50 %}selected{% endif %}>50</option>
                    <option value="100" {% if filtres.limit == 100 %}selected{% endif %}>100</option>
                </select>
            </div>
            {% endif %}
            
            <!-- Boutons : Appliquer + Menu Export -->
            <div class="col-md-4 d-flex align-items-end gap-2">
                <button type="submit" name="action" value="filter" class="btn btn-secondary">Appliquer</button>
                <div class="input-group">
                    <select name="export_type" class="form-select" style="max-width: 180px;">
                        <option value="pdf">PDF</option>
                        <option value="excel">Excel (photos + QR)</option>
                        <option value="etiquettes">Étiquettes</option>
                        <option value="donnees_excel">Excel (données)</option>
                        <option value="donnees_csv">CSV (données)</option>
                    </select>
                    <button type="submit" name="action" value="export" class="btn btn-primary" formtarget="_blank">
                        <i class="fas fa-file-export"></i> Exporter
                    </button>
                </div>
            </div>
        </div>
    </form>

    <hr>

    {% set photoGroupee = isGranted('ROLE_ADMIN') and equipements is not empty %}
    {# [Prêt de matériel] les cases servent aussi à « Ajouter au prêt » #}
    {% set pretSelection = prets_en_saisie|default([]) is not empty and equipements is not empty %}
    {% set selection = photoGroupee or pretSelection %}
    {% if pretSelection %}
    <form method="post" action="/prets/ajouter" id="form-pret" class="d-flex flex-wrap align-items-center gap-2 mb-3">
        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
        <input type="hidden" name="retour" value="/equipements{{ retour_query ? '?' ~ retour_query : '' }}">
        <select name="pret_id" class="form-select" style="max-width: 22rem;" aria-label="Prêt en saisie">
            {% for p in prets_en_saisie %}
                <option value="{{ p.id }}">Prêt n° {{ p.id }} — {{ p.emprunteur_prenom }} {{ p.emprunteur_nom }}</option>
            {% endfor %}
        </select>
        <button type="submit" id="btn-pret" class="btn btn-outline-primary" disabled>
            🤝 Ajouter la sélection au prêt (<span class="nb-coches-pret">0</span>)
        </button>
        <span class="small text-body-secondary">Seul le matériel disponible (hors contrôle, non périmé) est ajouté.</span>
    </form>
    {% endif %}
    {% if photoGroupee %}
    {# [Modification groupée] Les équipements cochés sont modifiés ensemble #}
    <form method="get" action="/equipements/modification-groupee" id="form-selection"
          class="d-flex flex-wrap align-items-center gap-3 mb-3">
        <input type="hidden" name="retour" value="{{ retour_query }}">
        <button type="submit" id="btn-selection" class="btn btn-primary" disabled>
            ✏️ Modifier la sélection (<span id="nb-coches">0</span>)
        </button>
        <span class="small text-body-secondary">
            Cochez les équipements à modifier ensemble (statut, emplacement, dates, photo…).
            Astuce : filtrez puis augmentez « Lignes par page » pour tout cocher d'un coup.
        </span>
    </form>
    {% endif %}

    <table class="table table-striped">
		<thead>
			<tr>
				{% if selection %}
				<th style="width: 2rem;">
					<input type="checkbox" class="form-check-input" id="tout-cocher"
					       title="Tout cocher / décocher" aria-label="Tout cocher">
				</th>
				{% endif %}
				<th>Référence</th>
				<th>Nom</th>
				<th>Photo</th>
				<th>Catégorie</th>
				<th>EPI</th>
				<th>Emplacement</th>
				<th>Mise en service</th>
				<th>Fin d'utilisation</th>
				<th>Statut</th>
				<th>Actions</th>
			</tr>
		</thead>
        <tbody>
            {% for equipement in equipements %}
                <tr>
                    {% if selection %}
                    <td>
                        <input type="checkbox" class="form-check-input case-equipement" name="ids[]"
                               value="{{ equipement.id }}" {% if photoGroupee %}form="form-selection"{% else %}form="form-pret"{% endif %}
                               aria-label="Sélectionner {{ equipement.reference }}">
                    </td>
                    {% endif %}
                    <td>{{ equipement.reference }}</td>
                    <td>
                        {{ equipement.libelle }}
                        {% if equipement.nombre_initial is defined and equipement.nombre_initial > 1 %}
                            <span class="badge bg-info text-dark" title="Lot : {{ equipement.nombre }} élément(s) restant(s) sur {{ equipement.nombre_initial }} initiaux">
                                Lot : {{ equipement.nombre }}/{{ equipement.nombre_initial }}
                            </span>
                        {% endif %}
                    </td>
                    <td>
                        {% if equipement.photo %}
                            <img src="{{ equipement.photo }}" alt="Photo" style="max-width: 50px; max-height: 50px;" class="img-thumbnail">
                        {% else %}
                            <span class="text-muted">—</span>
                        {% endif %}
                    </td>
                    <td>{{ equipement.categorie.libelle|default('N/A') }}</td>
                    <td>
                        {% if equipement.categorie and equipement.categorie.est_epi %}
                            <span class="badge bg-success">EPI</span>
                        {% elseif equipement.categorie and not equipement.categorie.est_epi %}
                            <span class="badge bg-secondary">Non EPI</span>
                        {% else %}
                            <span class="badge bg-secondary">Non défini</span>
                        {% endif %}
                    </td>
                    <td>{{ equipement.emplacement.libelle|default('Non défini') }}</td>
                    <td>
                        {% if equipement.date_mise_en_service %}
                            {{ equipement.date_mise_en_service|date("d/m/Y") }}
                        {% else %}
                            -
                        {% endif %}
                    </td>
                    <td>
                        {% if not equipement.date_fin_utilisation or equipement.date_fin_utilisation > "now"|date("Y-m-d") %}
                        <a href="#" 
                            onclick="alert('Date de fin d\'utilisation : {% if equipement.date_fin_utilisation %}{{ equipement.date_fin_utilisation|date('d/m/Y') }}{% else %}Non définie{% endif %}'); return false;" 
                            style="text-decoration: none; color: inherit;">
                            Toujours en service
                        </a>
                        {% else %}
                        {{ equipement.date_fin_utilisation|date("d/m/Y") }}
                        {% endif %}
                    </td>
                    <td class="text-center">
                        {# Statut : carré de couleur (EquipementStatut::couleur()) #}
                        {% set s = equipement.statut is not null ? statut_equipement(equipement.statut) : null %}
                        {% if s and s.libelle != 'Inconnu' %}
                            <span class="d-inline-block rounded-1 border" style="width: 1rem; height: 1rem; vertical-align: middle; background-color: {{ s.couleur }};"
                                  title="{{ s.libelle }}" role="img" aria-label="{{ s.libelle }}"></span>
                        {% else %}
                            -
                        {% endif %}
                    </td>
                    <td>
                        <a href="/equipements/equipement-{{ equipement.id }}" class="btn btn-sm btn-primary">Voir</a>
                        {% if isGranted('ROLE_CONTROLLEUR') %}
                        <a href="/equipements/equipement_modification-{{ equipement.id }}" class="btn btn-sm btn-warning">Modifier</a>
                        {% endif %}
                        {% if isGranted('ROLE_ADMIN') and not equipement.controle_en_cours and (equipement.statut == 2
                              or (equipement.statut == 4 and equipement.date_egare|default(null) and date_limite_egare|default(null) and equipement.date_egare|date('Y-m-d') <= date_limite_egare)) %}
                        <form method="post" action="/equipements/equipement_supprimer-{{ equipement.id }}" style="display:inline;">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                            <button type="submit" class="btn btn-sm btn-danger"
                                onclick="return confirm('Confirmer la suppression de « {{ equipement.reference }} » ?');">
                                Supprimer
                            </button>
                        </form>
                        {% endif %}
                    </td>
                </tr>
            {% endfor %}
        </tbody>
	</table>

    <!-- Pagination sous la liste (uniquement si plusieurs pages) -->
    {% if pagination.totalPages > 1 %}
    <div class="row mt-3">
        <div class="col-md-12">
            <nav aria-label="Pagination">
                <ul class="pagination">
                    {% if pagination.hasPrevious %}
                    <li class="page-item"><a class="page-link" href="{{ paginationUrls.first }}">Premier</a></li>
                    <li class="page-item"><a class="page-link" href="{{ paginationUrls.previous }}">Précédent</a></li>
                    {% else %}
                    <li class="page-item disabled"><span class="page-link">Premier</span></li>
                    <li class="page-item disabled"><span class="page-link">Précédent</span></li>
                    {% endif %}
                    
                    <li class="page-item disabled"><span class="page-link">Page {{ pagination.page }} sur {{ pagination.totalPages }}</span></li>
                    
                    {% if pagination.hasNext %}
                    <li class="page-item"><a class="page-link" href="{{ paginationUrls.next }}">Suivant</a></li>
                    <li class="page-item"><a class="page-link" href="{{ paginationUrls.last }}">Dernier</a></li>
                    {% else %}
                    <li class="page-item disabled"><span class="page-link">Suivant</span></li>
                    <li class="page-item disabled"><span class="page-link">Dernier</span></li>
                    {% endif %}
                </ul>
            </nav>
            <p class="text-muted">Affichage de {{ equipements|length }} équipements sur {{ pagination.total }} (page {{ pagination.page }}/{{ pagination.totalPages }})</p>
        </div>
    </div>
    {% endif %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        // [Modification groupée] compteur + « tout cocher »
        document.addEventListener('DOMContentLoaded', function () {
            const toutCocher = document.getElementById('tout-cocher');
            const bouton = document.getElementById('btn-selection');
            const boutonPret = document.getElementById('btn-pret');
            const formPret = document.getElementById('form-pret');
            if (!toutCocher || (!bouton && !boutonPret)) {
                return;
            }
            const cases = Array.from(document.querySelectorAll('.case-equipement'));
            const compteur = document.getElementById('nb-coches');
            const compteurPret = document.querySelector('.nb-coches-pret');
            // [Prêt de matériel] les cases cochées sont recopiées dans le
            // formulaire « Ajouter au prêt » à l'envoi.
            if (formPret && bouton) {
                formPret.addEventListener('submit', function () {
                    formPret.querySelectorAll('input.copie-id').forEach(i => i.remove());
                    cases.filter(c => c.checked).forEach(function (c) {
                        const h = document.createElement('input');
                        h.type = 'hidden'; h.name = 'ids[]'; h.value = c.value; h.className = 'copie-id';
                        formPret.appendChild(h);
                    });
                });
            }
            function majCompteur() {
                const nb = cases.filter(c => c.checked).length;
                if (compteur) compteur.textContent = nb;
                if (bouton) bouton.disabled = nb === 0;
                if (compteurPret) compteurPret.textContent = nb;
                if (boutonPret) boutonPret.disabled = nb === 0;
                toutCocher.checked = nb > 0 && nb === cases.length;
                toutCocher.indeterminate = nb > 0 && nb < cases.length;
            }
            toutCocher.addEventListener('change', function () {
                cases.forEach(c => { c.checked = toutCocher.checked; });
                majCompteur();
            });
            cases.forEach(c => c.addEventListener('change', majCompteur));
            majCompteur();
        });
    </script>
{% endblock %}
