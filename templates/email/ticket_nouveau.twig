{% extends "email/email_layout.twig" %}

{% block body %}
<h1>{{ 'Demande de modification'|trans }}</h1>
<p>{{ 'Bonjour {prenom},'|trans({prenom: personne.prenom}) }}</p>
<p>
    {{ "{prenom} {nom} demande une modification de l'équipement <strong>{reference}</strong> ({libelle})."|trans({prenom: (demandeur.prenom|default(''))|e, nom: (demandeur.nom|default(''))|e, reference: (equipement.reference)|e, libelle: (equipement.libelle)|e})|raw }}
</p>
<p>
    {% for lien in liens %}
        <a href="{{ lien }}">{{ 'Voir la demande'|trans }}{% if liens|length > 1 %} {{ 'n° {index}'|trans({index: loop.index}) }}{% endif %}</a><br>
    {% endfor %}
</p>
<p>
    {{ "Les demandes en attente sont aussi listées sur votre <a href=\"{lien}\">tableau de bord</a>. Vous ne recevrez pas d'autre mail de demande avant votre prochaine connexion."|trans({lien: lien_tableau_de_bord|e})|raw }}
</p>
<p>{{ "L'équipe {nom}"|trans({nom: club.nom}) }}</p>
{% endblock %}
