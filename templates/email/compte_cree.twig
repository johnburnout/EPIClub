{% extends "email/email_layout.twig" %}

{% block body %}
<h1>{{ 'Votre compte a été créé'|trans }}</h1>
<p>{{ 'Bonjour {prenom},'|trans({prenom: utilisateur.prenom}) }}</p>
<p>{{ "Un compte vient d'être créé pour vous sur l'application de gestion des équipements de {nom}."|trans({nom: club.nom}) }}</p>
<ul>
    <li>{{ 'Identifiant : <strong>{username}</strong>'|trans({username: (utilisateur.username)|e})|raw }}</li>
    <li>{{ 'Rôle : {role}'|trans({role: role}) }}</li>
</ul>
<p>
    {{ "Votre mot de passe vous est communiqué par l'administrateur qui a créé le compte. Vous pouvez aussi en choisir un vous-même avec <a href=\"{lien}\">« Mot de passe oublié »</a>."|trans({lien: lien_mot_de_passe|e})|raw }}
</p>
<p><a href="{{ lien_connexion }}">{{ 'Se connecter'|trans }}</a></p>
<p>{{ "L'équipe {nom}"|trans({nom: club.nom}) }}</p>
{% endblock %}
