{% extends "email/email_layout.twig" %}

{% block body %}
<h1>{{ 'Réinitialisation de votre mot de passe'|trans }}</h1>
<p>{{ 'Bonjour {prenom},'|trans({prenom: user.prenom}) }}</p>
<p>{{ 'Vous avez demandé la réinitialisation de votre mot de passe.'|trans }}</p>
<p>
    <a href="{{ reset_url }}">{{ 'Cliquez ici pour réinitialiser votre mot de passe'|trans }}</a>
</p>
<p>{{ "Ce lien est valable jusqu'au {expiration_date}."|trans({expiration_date: (expiration_date|date('d/m/Y H:i'))}) }}</p>
<p>{{ "L'équipe {nom}"|trans({nom: club.nom}) }}</p>
{% endblock %}