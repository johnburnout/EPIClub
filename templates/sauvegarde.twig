{% extends "_layout.twig" %}

{% macro taille(octets) %}{% if octets >= 1048576 %}{{ '{p} Mo'|trans({p: ((octets / 1048576)|number_format(1, ',', ' '))}) }}{% else %}{{ '{p} Ko'|trans({p: ((octets / 1024)|number_format(0, ',', ' '))}) }}{% endif %}{% endmacro %}

{% block body %}
<div class="container mt-4">
    <h3>{{ 'Sauvegarde et restauration'|trans }}</h3>
    <hr>

    {% if erreur_dossier %}
        <div class="alert alert-danger">{{ erreur_dossier }}</div>
    {% endif %}

    <div class="row g-4">
        {# ------------------------------------------------------------ #}
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header bg-primary text-white">
                    <i class="fas fa-download"></i> {{ 'Sauvegarder'|trans }}
                </div>
                <div class="card-body">
                    <p>{{ 'Télécharge une archive <code>.zip</code> contenant :'|trans|raw }}</p>
                    <ul>
                        <li>{{ 'toute la base de données (équipements, contrôles, acquisitions, utilisateurs, réglages…) ;'|trans }}</li>
                        <li>{{ 'les photos des équipements, les images du club et des catégories, les QR codes enregistrés ;'|trans }}</li>
                        <li>{{ 'les factures jointes aux acquisitions.'|trans }}</li>
                    </ul>
                    <p class="text-muted">{{ "<small> La configuration du serveur (<code>.env.local.php</code> : accès à la base, SMTP, clé de chiffrement) n'est pas incluse. Conservez-en une copie à part : sa clé <code>SECRET_KEY</code> est indispensable pour restaurer sur une nouvelle installation. </small>"|trans|raw }}</p>
                    <form method="post" action="/admin/sauvegarde/exporter">
                        <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-file-archive"></i> {{ 'Télécharger une sauvegarde'|trans }}
                        </button>
                    </form>
                </div>
            </div>
        </div>

        {# ------------------------------------------------------------ #}
        <div class="col-lg-6">
            <div class="card h-100 border-danger">
                <div class="card-header bg-danger text-white">
                    <i class="fas fa-upload"></i> {{ 'Restaurer'|trans }}
                </div>
                <div class="card-body">
                    <p>
                        {{ "Remplace <strong>toutes</strong> les données actuelles (base et fichiers) par celles d'une sauvegarde. L'archive est d'abord vérifiée sans rien modifier ; la restauration ne démarre qu'après votre confirmation. L'état actuel est sauvegardé automatiquement juste avant."|trans|raw }}
                    </p>
                    <form method="post" action="/admin/sauvegarde/televerser" enctype="multipart/form-data">
                        <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                        <div class="mb-2">
                            <input type="file" name="archive" accept=".zip,application/zip" class="form-control" required>
                        </div>
                        <button type="submit" class="btn btn-outline-danger">
                            <i class="fas fa-search"></i> {{ "Vérifier l'archive"|trans }}
                        </button>
                    </form>
                    <p class="text-muted mt-2 mb-0">{{ "<small> Taille maximale acceptée par le serveur : <strong>{limite_upload}</strong> (64 Mo prévus par EPIClub ; si la valeur affichée est plus basse, l'hébergement ignore <code>public/.user.ini</code> : réglez <code>upload_max_filesize</code> et <code>post_max_size</code> dans les options PHP du domaine). Au-delà, déposez l'archive par FTP dans le dossier <code>var/backups/</code> d'EPIClub : elle apparaîtra ci-dessous. </small>"|trans({limite_upload: (limite_upload)|e})|raw }}</p>
                </div>
            </div>
        </div>
    </div>

    {# ---------------------------------------------------------------- #}
    <div class="card mt-4">
        <div class="card-header">
            <i class="fas fa-archive"></i> {{ 'Sauvegardes conservées sur le serveur'|trans }}
        </div>
        <div class="card-body">
            {% if archives is empty %}
                <p class="text-muted mb-0">
                    {{ 'Aucune. Les sauvegardes automatiques faites avant chaque restauration (les 3 dernières) apparaîtront ici.'|trans }}
                </p>
            {% else %}
                <div class="table-responsive">
                    <table class="table table-sm align-middle">
                        <thead>
                            <tr>
                                <th>{{ 'Archive'|trans }}</th>
                                <th>{{ 'Date'|trans }}</th>
                                <th>{{ 'Taille'|trans }}</th>
                                <th class="text-end">{{ 'Actions'|trans }}</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for a in archives %}
                            <tr>
                                <td>
                                    <code>{{ a.nom }}</code>
                                    {% if a.type == 'avant-restauration' %}
                                        <span class="badge bg-secondary">{{ 'avant restauration'|trans }}</span>
                                    {% elseif a.type == 'planifiee' %}
                                        <span class="badge bg-info text-dark">{{ 'planifiée'|trans }}</span>
                                    {% elseif a.type == 'televersee' %}
                                        <span class="badge bg-warning text-dark">{{ 'téléversée, non restaurée'|trans }}</span>
                                    {% endif %}
                                </td>
                                <td>{{ a.date|date('d/m/Y H:i') }}</td>
                                <td>{{ _self.taille(a.taille) }}</td>
                                <td class="text-end text-nowrap">
                                    <a class="btn btn-sm btn-outline-danger" href="/admin/sauvegarde/verifier/{{ a.nom|url_encode }}" title="{{ 'Vérifier puis restaurer'|trans }}">
                                        <i class="fas fa-undo"></i> {{ 'Restaurer…'|trans }}
                                    </a>
                                    <a class="btn btn-sm btn-outline-secondary" href="/admin/sauvegarde/telecharger/{{ a.nom|url_encode }}" title="{{ 'Télécharger'|trans }}">
                                        <i class="fas fa-download"></i>
                                    </a>
                                    <form method="post" action="/admin/sauvegarde/supprimer/{{ a.nom|url_encode }}" class="d-inline"
                                          data-confirm="{{ 'Supprimer définitivement {nom} ?'|trans({nom: a.nom}) }}">
                                        <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                                        <button type="submit" class="btn btn-sm btn-outline-secondary" title="{{ 'Supprimer'|trans }}">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
