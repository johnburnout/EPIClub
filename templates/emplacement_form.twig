{% extends "_layout.twig" %}

{% block body %}
	<h3>{% if emplacement.id %}{{ 'Modifier emplacement'|trans }}{% else %}{{ 'Nouvel emplacement'|trans }}{% endif %}</h3>
	<hr>

	<form method="post">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
		<div class="mb-3">
			<label for="libelle">{{ 'Libellé *'|trans }}</label>
			<input type="text" id="libelle" name="libelle" value="{{ emplacement.libelle }}" class="form-control">
		</div>
		<div class="mb-3">
			<label for="description">{{ 'Description'|trans }}</label>
			<textarea id="description" name="description" class="form-control" rows="3">{{ emplacement.description }}</textarea>
		</div>
		<div class="mb-3">
			<label for="image">{{ 'Image (URL)'|trans }}</label>
			<input type="text" id="image" name="image" value="{{ emplacement.image }}" class="form-control">
		</div>
		<button type="submit" class="btn btn-primary">{{ 'Enregistrer'|trans }}</button>
		<a href="{{ url_liste('/admin/emplacements') }}" class="btn btn-secondary">{{ 'Annuler'|trans }}</a>
	</form>
{% endblock %}