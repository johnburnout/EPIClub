{% extends "_layout.twig" %}

{% block body %}

	<h3>Détail de l'équipement</h3>
	<hr>

	{% if equipement %}
		<div class="card">
			<div class="card-header d-flex justify-content-between align-items-center">
				<h5 class="card-title mb-0">{{ equipement.libelle }}</h5>
				<span class="badge bg-primary">{{ equipement.reference }}</span>
			</div>
			<div class="card-body">
				<div class="row">
					<div class="col-md-6">
						<p><strong>Référence :</strong> {{ equipement.reference }}
							{% if isGranted('ROLE_SUPER_ADMIN') %}
								<button type="button" class="btn btn-sm btn-outline-danger ms-2" data-bs-toggle="modal" data-bs-target="#modal-reference">
									<i class="fas fa-pen"></i> Changer
								</button>
							{% endif %}
						</p>
						{% if equipement.nombre_initial is defined and equipement.nombre_initial > 1 %}
							<p><strong>Lot :</strong> {{ equipement.nombre }} élément(s) restant(s) sur {{ equipement.nombre_initial }} initiaux</p>
						{% endif %}
						<p><strong>Catégorie :</strong> 
							{% if equipement.categorie %}
								{{ equipement.categorie.libelle }}
							{% else %}
								<span class="text-muted">Non définie</span>
							{% endif %}
						</p>
						<p><strong>EPI :</strong>
							{% if equipement.categorie and equipement.categorie.est_epi %}
								<span class="badge bg-success">Oui</span>
							{% elseif equipement.categorie and not equipement.categorie.est_epi %}
								<span class="badge bg-secondary">Non</span>
							{% else %}
								<span class="text-muted">Non défini</span>
							{% endif %}
						</p>
						{% if isGranted('ROLE_CONTROLLEUR') %}
						{# [2026-10-23] Déplacement depuis la fiche (contrôleurs et plus) #}
						<form method="post" action="/equipements/equipement_emplacement-{{ equipement.id }}" class="mb-3">
							<input type="hidden" name="csrf_token" value="{{ csrf_token }}">
							<label for="emplacement_id" class="form-label mb-1"><strong>Emplacement :</strong></label>
							<div class="d-flex flex-wrap gap-2 align-items-center">
								<select id="emplacement_id" name="emplacement_id" class="form-select form-select-sm" style="max-width: 18rem;">
									<option value="">-- Aucun emplacement --</option>
									{% for e in emplacements %}
										<option value="{{ e.id }}" {% if equipement.emplacement_id == e.id %}selected{% endif %}>{{ e.libelle }}</option>
									{% endfor %}
								</select>
								<button type="submit" class="btn btn-sm btn-outline-primary">
									<i class="fas fa-map-marker-alt"></i> Déplacer
								</button>
							</div>
						</form>
						{% else %}
						<p><strong>Emplacement :</strong> 
							{% if equipement.emplacement %}
								{{ equipement.emplacement.libelle }}
							{% else %}
								<span class="text-muted">Non défini</span>
							{% endif %}
						</p>
						{% endif %}
						<p><strong>Date de mise en service :</strong> 
							{% if equipement.date_mise_en_service %}
								{{ equipement.date_mise_en_service|date("d/m/Y") }}
							{% else %}
								<span class="text-muted">Non renseignée</span>
							{% endif %}
						</p>
						<p><strong>Durée maximum d'utilisation :</strong>
							{% if equipement.duree_max_utilisation %}
							<span class="badge bg-warning text-dark">Oui — durée de vie limitée par le fabricant</span>
							{% else %}
							<span class="text-muted">Non</span>
							{% endif %}
						</p>
						{% if equipement.textile_remplacable|default(false) %}
						<p><strong>Élément textile :</strong>
							<span class="badge bg-info text-dark">Remplaçable</span>
						</p>
						{% endif %}
						<p><strong>Date de fin d'utilisation :</strong> 
							{% if not equipement.date_fin_utilisation or equipement.date_fin_utilisation > "now"|date("Y-m-d") %}
							<span class="text-muted">
								Toujours en service
								{% if equipement.date_fin_utilisation %}
								({{ equipement.date_fin_utilisation|date("d/m/Y") }})
								{% endif %}
							</span>
							{% else %}
							{{ equipement.date_fin_utilisation|date("d/m/Y") }}
							{% endif %}
						</p>
					</div>
					<div class="col-md-6">
						<p><strong>Statut :</strong> 
							{% if equipement.controle_en_cours %}
							<span class="badge bg-info">En contrôle</span>
							{% else %}
							{% set s = statut_equipement(equipement.statut) %}
							<span class="badge bg-{{ s.badge }}">{{ s.libelle }}</span>
							{% if equipement.statut == 4 and equipement.date_egare|default(null) %}
								<span class="small text-body-secondary">depuis le {{ equipement.date_egare|date('d/m/Y') }}{% if egare_supprimable_le|default(null) %} — supprimable à partir du {{ egare_supprimable_le|date('d/m/Y') }}{% endif %}</span>
							{% endif %}
							{% endif %}
						</p>
						<p><strong>Date dernier contrôle :</strong> 
							{% if equipement.date_dernier_controle %}
								{{ equipement.date_dernier_controle|date("d/m/Y") }}
							{% else %}
								<span class="text-muted">Jamais contrôlé</span>
							{% endif %}
						</p>
						<p><strong>Remarques :</strong> 
							{% if equipement.remarques %}
								{{ equipement.remarques }}
							{% else %}
								<span class="text-muted">Aucune remarque</span>
							{% endif %}
						</p>
						
						{# --- Acquisition d'origine --- #}
						{% if acquisition is defined and acquisition %}
						<div class="mt-3 border-top pt-3">
							<p class="mb-2"><strong><i class="fas fa-file-invoice"></i> Acquisition d'origine :</strong></p>
							<div class="mb-2">
								<span class="badge bg-secondary">#{{ acquisition.id }}</span>
								{% if acquisition.facture_reference %}
									<small class="text-muted">Facture : {{ acquisition.facture_reference }}</small>
								{% endif %}
							</div>
							<div class="d-flex flex-wrap gap-2">
								{# Lien vers la liste des équipements de la même acquisition #}
								<a href="/equipements?acquisition={{ acquisition.id }}" class="btn btn-sm btn-outline-primary">
									<i class="fas fa-list"></i> Voir tous les équipements de cette acquisition
								</a>
								{# Lien vers la fiche acquisition #}
								<a href="/admin/acquisitions/acquisition-{{ acquisition.id }}" class="btn btn-sm btn-outline-secondary">
									<i class="fas fa-eye"></i> Voir la fiche acquisition
								</a>
								{# Lien vers la facture (« facture à importer » = placeholder
								   AcquisitionManager::FACTURE_A_IMPORTER, pas un fichier réel) #}
								{% if acquisition.facture_document == 'facture à importer' %}
								<span class="badge bg-secondary align-self-center">📄 facture à importer</span>
								{% elseif acquisition.facture_document %}
								<a href="/uploads/{{ acquisition.facture_document }}" target="_blank" class="btn btn-sm btn-outline-info">
									<i class="fas fa-file-pdf"></i> Voir la facture
								</a>
								{% endif %}
							</div>
						</div>
						{% endif %}

						{# Affichage de la photo #}
						{% if equipement.photo is defined and equipement.photo is not empty %}
							<div class="mt-3">
								<strong>Photo :</strong>
								<div>
									<img src="{{ equipement.photo }}" alt="Photo de l'équipement" style="max-width: 300px; max-height: 300px;" class="img-thumbnail">
								</div>
							</div>
						{% endif %}

						{# ============================================ #}
						{# === QR CODE === #}
						{# ============================================ #}
						<div class="mt-3 border-top pt-3">
							<strong><i class="fas fa-qrcode"></i> QR Code :</strong>
							<div class="mt-2 d-flex align-items-start gap-3">
								<!-- Image du QR Code avec ID pour le JavaScript -->
								<img id="qr-code-image" 
									 src="/qr/generate/{{ equipement.id }}" 
									 alt="QR Code de {{ equipement.reference }}" 
									 style="width: 120px; height: 120px;" 
									 class="img-thumbnail border-0 p-1"
									 loading="lazy"
									 onerror="this.src='/assets/img/qr-placeholder.png'; this.alt='QR Code non disponible';">
								
								<!-- Actions du QR Code -->
								<div class="d-flex flex-column gap-1">
									<a href="/qr/choix/{{ equipement.id }}" 
									   class="btn btn-sm btn-outline-info text-start" 
									   title="Voir la page du QR code">
										<i class="fas fa-eye"></i> Voir le QR
									</a>
									<a href="/qr/download/{{ equipement.id }}" 
									   class="btn btn-sm btn-outline-success text-start" 
									   title="Télécharger le QR code">
										<i class="fas fa-download"></i> Télécharger
									</a>
									<a href="#" 
									   class="btn btn-sm btn-outline-secondary text-start" 
									   title="Sauvegarder sur le serveur"
									   onclick="event.preventDefault(); sauvegarderQR({{ equipement.id }});">
										<i class="fas fa-save"></i> Sauvegarder
									</a>
									<a href="#" 
									   class="btn btn-sm btn-outline-primary text-start" 
									   title="Copier l'URL du QR code"
									   onclick="event.preventDefault(); copierUrlQR({{ equipement.id }});">
										<i class="fas fa-copy"></i> Copier l'URL
									</a>
								</div>
							</div>
							<small class="text-muted d-block mt-1">
								<i class="fas fa-info-circle"></i> 
								Scannez ce QR code pour accéder rapidement à la fiche ou au contrôle
							</small>
							{# Indicateur de sauvegarde #}
							<div id="qr-status" class="mt-1">
								<small class="text-muted" id="qr-status-text">
									<i class="fas fa-circle" style="color: #6c757d; font-size: 8px;"></i> 
									Généré à la demande
								</small>
							</div>
						</div>
						{# ============================================ #}
						{# === FIN QR CODE === #}
						{# ============================================ #}
					</div>
				</div>
			</div>
		</div>

		{# --- [Prêt de matériel] Prêts --- #}
		{% if isGranted('ROLE_CONTROLLEUR') and pret_actif() %}
			<div class="card mt-4">
				<div class="card-header bg-primary text-white">
					<h5 class="mb-0">🤝 Prêts</h5>
				</div>
				<div class="card-body">
					{% if pret_ouvert %}
						<p class="mb-2">
							Inscrit sur le <a href="/prets/pret-{{ pret_ouvert.id }}">prêt n° {{ pret_ouvert.id }}</a>
							({{ pret_ouvert.emprunteur_prenom }} {{ pret_ouvert.emprunteur_nom }}{% if pret_ouvert.statut == 'en_cours' %}, retour prévu le {{ pret_ouvert.date_retour_prevue|date('d/m/Y') }}{% elseif pret_ouvert.statut == 'termine' %}, retour à vérifier{% else %}, en saisie{% endif %}).
						</p>
					{% elseif pret_motif %}
						<p class="text-muted mb-2">Non prêtable actuellement — {{ pret_motif }}</p>
					{% elseif prets_en_saisie is not empty %}
						<form method="post" action="/prets/ajouter" class="d-flex flex-wrap gap-2 align-items-center mb-2">
							<input type="hidden" name="csrf_token" value="{{ csrf_token }}">
							<input type="hidden" name="equipement_id" value="{{ equipement.id }}">
							<input type="hidden" name="retour" value="/equipements/equipement-{{ equipement.id }}">
							<select name="pret_id" class="form-select" style="max-width: 22rem;" aria-label="Prêt en saisie">
								{% for p in prets_en_saisie %}
									<option value="{{ p.id }}">Prêt n° {{ p.id }} — {{ p.emprunteur_prenom }} {{ p.emprunteur_nom }}</option>
								{% endfor %}
							</select>
							<button type="submit" class="btn btn-primary">➕ Ajouter au prêt</button>
						</form>
					{% else %}
						<p class="mb-2">Aucun prêt en saisie. <a href="/prets/nouveau">Créer une fiche de prêt</a></p>
					{% endif %}

					{% if historique_prets is not empty %}
						<div class="table-responsive">
							<table class="table table-sm table-striped mb-0">
								<thead>
									<tr><th>Prêt</th><th>Emprunteur</th><th>Du</th><th>Au</th><th>Retour</th></tr>
								</thead>
								<tbody>
									{% for h in historique_prets %}
										<tr>
											<td><a href="/prets/pret-{{ h.id }}">n° {{ h.id }}</a></td>
											<td>{{ h.emprunteur_prenom }} {{ h.emprunteur_nom }}</td>
											<td>{{ h.date_pret|date('d/m/Y') }}</td>
											<td>{{ h.date_retour ? h.date_retour|date('d/m/Y') : '(prévu ' ~ h.date_retour_prevue|date('d/m/Y') ~ ')' }}</td>
											<td>
												{% if h.etat_retour == 'disponible' %}<span class="badge bg-success">Rendu</span>
												{% elseif h.etat_retour == 'maintenance' %}<span class="badge bg-warning">Rendu — maintenance</span>
												{% elseif h.etat_retour == 'egare' %}<span class="badge bg-dark">Égaré</span>
												{% elseif h.statut == 'saisie' %}<span class="badge bg-secondary">En saisie</span>
												{% else %}<span class="badge bg-primary">{{ h.statut == 'termine' ? 'À vérifier' : 'En cours' }}</span>
												{% endif %}
											</td>
										</tr>
									{% endfor %}
								</tbody>
							</table>
						</div>
					{% endif %}
				</div>
			</div>
		{% endif %}

		{# --- Historique des contrôles --- #}
		{% if historiqueControles %}
			<div class="card mt-4">
				<div class="card-header bg-primary text-white">
					<h5 class="mb-0">📋 Historique des contrôles ({{ historiqueControles|length }})</h5>
				</div>
				<div class="card-body p-0">
					<div class="table-responsive">
						<table class="table table-striped mb-0">
							<thead>
								<tr>
									<th>Contrôle</th>
									<th>Date contrôle</th>
									<th>Contrôleur</th>
									<th>Statut</th>
									<th>Remarque</th>
									<th>Actions</th>
								</tr>
							</thead>
							<tbody>
								{% for ligne in historiqueControles %}
									<tr>
										<td>{{ ligne.controle_libelle }}</td>
										<td>
											{% if ligne.date_controle %}
												{{ ligne.date_controle|date("d/m/Y H:i") }}
											{% else %}
												<span class="text-muted">-</span>
											{% endif %}
										</td>
										<td>
											{{ ligne.controleur_prenom }} {{ ligne.controleur_nom }}
										</td>
										<td>
											{% set statutClasses = {
												'a_controler': 'warning',
												'controle_ok': 'success',
												'controle_ko': 'danger',
												'hors_service': 'secondary',
												'egare': 'dark'
											} %}
											{% set statutLabels = {
												'a_controler': 'À contrôler',
												'controle_ok': 'OK',
												'controle_ko': 'KO',
												'hors_service': 'Hors service',
												'egare': 'Égaré'
											} %}
											<span class="badge bg-{{ statutClasses[ligne.statut]|default('secondary') }}">
												{{ statutLabels[ligne.statut]|default(ligne.statut) }}
											</span>
											{% if ligne.textile_remplace|default(false) %}
												<span class="badge bg-info text-dark">Textile remplacé</span>
											{% endif %}
										</td>
										<td>
											{% if ligne.remarque %}
												<span class="text-muted small" title="{{ ligne.remarque }}">
													{{ ligne.remarque|length > 50 ? ligne.remarque|slice(0, 50) ~ '...' : ligne.remarque }}
												</span>
											{% else %}
												<span class="text-muted">-</span>
											{% endif %}
										</td>
										<td>
											<a href="/journaux/{{ ligne.controle_id }}" class="btn btn-sm btn-primary" target="_blank">
												Voir le journal
											</a>
										</td>
									</tr>
								{% endfor %}
							</tbody>
						</table>
					</div>
				</div>
			</div>
		{% else %}
			<div class="card mt-4">
				<div class="card-header bg-secondary text-white">
					<h5 class="mb-0">📋 Historique des contrôles</h5>
				</div>
				<div class="card-body">
					<p class="text-muted mb-0">Cet équipement n'a pas encore été contrôlé ou aucun contrôle n'a été clôturé.</p>
				</div>
			</div>
		{% endif %}
		{# --- Fin historique --- #}

			<div class="mt-3 d-flex flex-wrap gap-2">
				<a href="/equipements" class="btn btn-secondary">
					<i class="fas fa-arrow-left"></i> Retour à la liste
				</a>
				<a href="/equipements/equipement_modification-{{ equipement.id }}" class="btn btn-warning">
					<i class="fas fa-edit"></i> Modifier
				</a>
				<a href="/equipements/equipement-pdf-{{ equipement.id }}" class="btn btn-danger" target="_blank">
					<i class="fas fa-file-pdf"></i> PDF
				</a>
				<a href="/qr/choix/{{ equipement.id }}" class="btn btn-info">
					<i class="fas fa-qrcode"></i> QR Code
				</a>
				{% if isGranted('ROLE_CONTROLLEUR') %}
				<form method="post" action="/admin/controles/creer" class="d-inline">
					<input type="hidden" name="csrf_token" value="{{ csrf_token }}">
					<input type="hidden" name="equipement_id" value="{{ equipement.id }}">
					<button type="submit" class="btn btn-success">
						<i class="fas fa-clipboard-check"></i> Démarrer un contrôle
					</button>
				</form>
				{% endif %}
				{% if isGranted('ROLE_ADMIN') %}
				{% if suppression_autorisee|default(false) %}
				<form method="post" action="/equipements/equipement_supprimer-{{ equipement.id }}" style="display:inline;">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
					<button type="submit" class="btn btn-danger"
						onclick="return confirm('Confirmer la suppression définitive de cet équipement « {{ equipement.reference }} » ?\n\nCette action est irréversible.');">
						<i class="fas fa-trash"></i> Supprimer
					</button>
				</form>
				{% else %}
				<button type="button" class="btn btn-danger" disabled
					title="{% if egare_supprimable_le|default(null) %}Équipement égaré : supprimable à partir du {{ egare_supprimable_le|date('d/m/Y') }}{% else %}Seul un équipement déclaré hors service par son dernier contrôle clôturé, ou égaré depuis le délai réglé sur la page Club (et sans contrôle en cours), peut être supprimé{% endif %}">
					<i class="fas fa-trash"></i> Supprimer
				</button>
				{% endif %}
				{% endif %}
			</div>
		{% if isGranted('ROLE_SUPER_ADMIN') %}
		{# [2026-10-23] Changement de référence : unicité vérifiée à la volée
		   + saisie du mot de confirmation (re-vérifiés côté serveur). #}
		<div class="modal fade" id="modal-reference" tabindex="-1" aria-labelledby="modal-reference-titre" aria-hidden="true">
			<div class="modal-dialog">
				<form method="post" action="/equipements/equipement_reference-{{ equipement.id }}" class="modal-content" id="form-reference" autocomplete="off">
					<input type="hidden" name="csrf_token" value="{{ csrf_token }}">
					<div class="modal-header">
						<h5 class="modal-title" id="modal-reference-titre">Changer la référence</h5>
						<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
					</div>
					<div class="modal-body">
						<div class="alert alert-warning small">
							<i class="fas fa-exclamation-triangle"></i>
							La référence est l'identifiant métier de l'équipement. Les étiquettes et fiches déjà
							imprimées porteront l'ancienne référence <strong>{{ equipement.reference }}</strong> ;
							le QR code reste valable.
						</div>
						<div class="mb-3">
							<label for="nouvelle-reference" class="form-label">Nouvelle référence</label>
							<input type="text" class="form-control" id="nouvelle-reference" name="reference"
							       maxlength="{{ reference_max }}" required
							       data-equipement-id="{{ equipement.id }}" data-reference-actuelle="{{ equipement.reference }}">
							<div class="form-text" id="reference-statut" aria-live="polite">&nbsp;</div>
						</div>
						<div class="mb-1">
							<label for="confirmation-reference" class="form-label">
								Pour confirmer, saisissez <code>{{ mot_confirmation_reference }}</code>
							</label>
							<input type="text" class="form-control" id="confirmation-reference" name="confirmation"
							       required spellcheck="false" data-mot="{{ mot_confirmation_reference }}">
						</div>
					</div>
					<div class="modal-footer">
						<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
						<button type="submit" class="btn btn-danger" id="btn-valider-reference" disabled>Changer la référence</button>
					</div>
				</form>
			</div>
		</div>
		{% endif %}
	{% else %}
		<div class="alert alert-warning">
			<i class="fas fa-exclamation-triangle"></i> Équipement non trouvé.
		</div>
		<a href="/equipements" class="btn btn-secondary">Retour à la liste</a>
	{% endif %}

{% endblock %}

{# ============================================ #}
{# === BLOCK JAVASCRIPT SPÉCIFIQUE === #}
{# ============================================ #}
{% block javascripts %}
	{{ parent() }}
	<script>
		/**
		 * Met à jour le statut du QR code après sauvegarde
		 */
		function updateQRStatus(saved) {
			const statusText = document.getElementById('qr-status-text');
			if (saved) {
				statusText.innerHTML = '<i class="fas fa-circle" style="color: #28a745; font-size: 8px;"></i> Sauvegardé sur le serveur';
			} else {
				statusText.innerHTML = '<i class="fas fa-circle" style="color: #6c757d; font-size: 8px;"></i> Généré à la demande';
			}
		}

		/**
		 * Sauvegarde le QR code sur le serveur (avec mise à jour du statut)
		 */
		function sauvegarderQR(equipementId) {
			const btn = document.querySelector('[onclick*="sauvegarderQR(' + equipementId + ')"]');
			const originalHtml = btn ? btn.innerHTML : '';
			
			if (btn) {
				btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Sauvegarde...';
				btn.disabled = true;
			}

			fetch('/qr/save/' + equipementId)
				.then(response => {
					if (!response.ok) {
						throw new Error('Erreur HTTP: ' + response.status);
					}
					return response.json();
				})
				.then(data => {
					if (btn) {
						btn.innerHTML = originalHtml;
						btn.disabled = false;
					}

					if (data.success) {
						// Mettre à jour l'image
						const img = document.getElementById('qr-code-image');
						if (img) {
							img.src = '/qr/view/' + data.filename.replace('.png', '') + '?t=' + Date.now();
						}
						
						// Mettre à jour le statut
						updateQRStatus(true);
						
						// Afficher la notification
						showNotification('success', '✅ QR code sauvegardé !', 'Fichier : ' + data.filename);
					} else {
						showNotification('danger', '❌ Erreur', data.error || 'Erreur inconnue');
					}
				})
				.catch(error => {
					if (btn) {
						btn.innerHTML = originalHtml;
						btn.disabled = false;
					}
					showNotification('danger', '❌ Erreur', error.message);
				});
		}

		/**
		 * Copie l'URL du QR code dans le presse-papier
		 */
		function copierUrlQR(equipementId) {
			const url = window.location.origin + '/qr/' + equipementId;
			
			if (navigator.clipboard && navigator.clipboard.writeText) {
				navigator.clipboard.writeText(url)
					.then(() => {
						showNotification('success', '📋 URL copiée !', 'L\'URL du QR code a été copiée dans le presse-papier.');
					})
					.catch(() => {
						copierUrlFallback(url);
					});
			} else {
				copierUrlFallback(url);
			}
		}

		/**
		 * Fallback pour la copie d'URL
		 */
		function copierUrlFallback(url) {
			const textarea = document.createElement('textarea');
			textarea.value = url;
			textarea.style.position = 'fixed';
			textarea.style.opacity = '0';
			textarea.style.left = '-9999px';
			document.body.appendChild(textarea);
			textarea.select();
			
			try {
				document.execCommand('copy');
				showNotification('success', '📋 URL copiée !', 'L\'URL du QR code a été copiée dans le presse-papier.');
			} catch (err) {
				showNotification('danger', '❌ Erreur', 'Impossible de copier l\'URL.');
			}
			document.body.removeChild(textarea);
		}

		/**
		 * Affiche une notification (toast Bootstrap)
		 */
		function showNotification(type, title, message) {
			// Créer le conteneur si nécessaire
			let container = document.getElementById('toast-container');
			if (!container) {
				container = document.createElement('div');
				container.id = 'toast-container';
				container.className = 'position-fixed bottom-0 end-0 p-3';
				container.style.zIndex = '9999';
				document.body.appendChild(container);
			}
			
			// Créer le toast
			const toastEl = document.createElement('div');
			toastEl.className = 'toast align-items-center text-white bg-' + type + ' border-0';
			toastEl.role = 'alert';
			toastEl.ariaLive = 'assertive';
			toastEl.ariaAtomic = 'true';
			toastEl.innerHTML = `
				<div class="d-flex">
					<div class="toast-body">
						<strong>${title}</strong><br>
						${message}
					</div>
					<button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
				</div>
			`;
			container.appendChild(toastEl);
			
			const toast = new bootstrap.Toast(toastEl, { delay: 5000 });
			toast.show();
			
			toastEl.addEventListener('hidden.bs.toast', function() {
				this.remove();
			});
		}

		/**
		 * [2026-10-23] Changement de référence (super-admin) : unicité
		 * vérifiée à la volée, bouton actif seulement si la référence est
		 * disponible ET le mot de confirmation saisi.
		 */
		(function () {
			const champ = document.getElementById('nouvelle-reference');
			if (!champ) return;
			const confirmation = document.getElementById('confirmation-reference');
			const statut = document.getElementById('reference-statut');
			const bouton = document.getElementById('btn-valider-reference');
			const motAttendu = confirmation.dataset.mot;
			let disponible = false;
			let minuterie = null;
			let requete = 0;

			function afficher(classe, texte) {
				statut.className = 'form-text ' + classe;
				statut.textContent = texte;
			}
			function majBouton() {
				bouton.disabled = !(disponible && confirmation.value.trim() === motAttendu);
			}
			function verifier() {
				const valeur = champ.value.trim();
				disponible = false;
				majBouton();
				if (valeur === '') { afficher('', '\u00a0'); return; }
				afficher('text-muted', 'Vérification…');
				const numero = ++requete;
				const url = '/equipements/reference-disponible?id=' + encodeURIComponent(champ.dataset.equipementId)
					+ '&reference=' + encodeURIComponent(valeur);
				fetch(url, { headers: { 'Accept': 'application/json' }, credentials: 'same-origin' })
					.then(r => { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })
					.then(data => {
						if (numero !== requete) return; // réponse obsolète
						disponible = !!data.disponible;
						afficher(disponible ? 'text-success' : 'text-danger', (disponible ? '✔ ' : '✖ ') + data.message);
						majBouton();
					})
					.catch(() => {
						if (numero !== requete) return;
						afficher('text-danger', 'Vérification impossible, réessayez.');
					});
			}

			champ.addEventListener('input', function () {
				clearTimeout(minuterie);
				disponible = false;
				majBouton();
				minuterie = setTimeout(verifier, 300);
			});
			confirmation.addEventListener('input', majBouton);
			document.getElementById('form-reference').addEventListener('submit', function (e) {
				if (bouton.disabled) e.preventDefault();
			});
			document.getElementById('modal-reference').addEventListener('shown.bs.modal', function () {
				champ.focus();
			});
		})();

		// Initialisation : vérifier si le QR est déjà sauvegardé
		document.addEventListener('DOMContentLoaded', function() {
			const img = document.getElementById('qr-code-image');
			if (img) {
				// Si l'image a un attribut data-saved, on met à jour le statut
				if (img.dataset.saved === 'true') {
					updateQRStatus(true);
				}
			}
		});
	</script>
