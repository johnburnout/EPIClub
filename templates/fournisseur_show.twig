{% extends "_layout.twig" %}

{% block body %}

	<h3>{{ 'Fiche fournisseur'|trans }}</h3>
	<hr>

	{% if fournisseur %}
		<div class="card">
			<div class="card-body">
				<h5 class="card-title">{{ fournisseur.nom }}</h5>
				<ul class="list-group list-group-flush">
					<li class="list-group-item">
						<strong>{{ 'Email :'|trans }}</strong> 
						{% if fournisseur.email %}
							<a href="mailto:{{ fournisseur.email }}">{{ fournisseur.email }}</a>
						{% else %}
							<em>{{ 'Non renseigné'|trans }}</em>
						{% endif %}
					</li>
					<li class="list-group-item">
						<strong>{{ 'Téléphone :'|trans }}</strong> 
						{% if fournisseur.phone %}
							{{ fournisseur.phone }}
						{% else %}
							<em>{{ 'Non renseigné'|trans }}</em>
						{% endif %}
					</li>
				</ul>
			</div>
		</div>

		<div class="form-actions d-flex gap-2 mt-3">
			<a href="/admin/fournisseurs" class="btn btn-secondary">{{ 'Retour à la liste'|trans }}</a>
			{% if nb_equipements > 0 %}
			<a href="/equipements?fournisseur={{ fournisseur.id }}" class="btn btn-primary">📋 {{ nb_equipements > 1 ? 'Voir les {nombre} équipements'|trans({nombre: nb_equipements}) : "Voir l'équipement"|trans }}</a>
			{% else %}
			<span class="btn btn-outline-secondary disabled">{{ 'Aucun équipement'|trans }}</span>
			{% endif %}
			{% if isGranted('ROLE_ADMIN') %}
			<a href="/admin/fournisseurs/fournisseur_modification-{{ fournisseur.id }}" class="btn btn-warning">{{ 'Modifier'|trans }}</a>
			<form method="post" action="/admin/fournisseurs/supprimer" class="ms-auto">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
				<input type="hidden" name="id" value="{{ fournisseur.id }}">
				<button type="submit" class="btn btn-danger"
				        data-confirm="{{ 'Êtes-vous sûr de vouloir supprimer ce fournisseur ? Cette action est irréversible.'|trans }}">
					🗑️ {{ 'Supprimer'|trans }}
				</button>
			</form>
			{% endif %}
		</div>
	{% else %}
		<p>{{ 'Fournisseur non trouvé.'|trans }}</p>
		<a href="/admin/fournisseurs" class="btn btn-secondary">{{ 'Retour à la liste'|trans }}</a>
	{% endif %}

{% endblock %}