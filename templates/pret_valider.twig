{% extends "_layout.twig" %}

{% block body %}
	<h3>{{ signature_seule ? '✍️ Signature' : '✅ Validation' }} — prêt n° {{ pret.id }}</h3>
	<hr>

	<div style="max-width: 40rem;">
		<p class="mb-1"><strong>Emprunteur :</strong> {{ pret.emprunteur_prenom }} {{ pret.emprunteur_nom }}
			{% if pret.emprunteur_licence %}— licence {{ pret.emprunteur_licence }}{% endif %}</p>
		<p class="mb-1"><strong>Téléphone :</strong> {{ pret.emprunteur_telephone }}</p>
		<p><strong>Du</strong> {{ pret.date_pret|date('d/m/Y') }} <strong>au</strong> {{ pret.date_retour_prevue|date('d/m/Y') }} (retour prévu)</p>

		<h6>Matériel ({{ lignes|length }})</h6>
		<ul class="list-group mb-3">
			{% for l in lignes %}
				<li class="list-group-item py-1">{{ l.reference }} — {{ l.libelle }}</li>
			{% endfor %}
		</ul>

		<form method="post" id="form-signature">
			<input type="hidden" name="csrf_token" value="{{ csrf_token }}">
			<input type="hidden" name="signature" id="signature">

			<label class="form-label"><strong>Signature de l'emprunteur</strong>{% if not signature_seule %} (facultative){% endif %}</label>
			<p class="small text-muted mb-1">
				« Je reconnais avoir reçu le matériel ci-dessus en bon état et m'engage à le restituer
				au plus tard le {{ pret.date_retour_prevue|date('d/m/Y') }}. »
				Signez avec le doigt ou la souris dans le cadre.
			</p>
			<canvas id="pad" class="border rounded bg-white w-100" style="height: 12rem; touch-action: none; cursor: crosshair;"></canvas>
			<div class="d-flex flex-wrap gap-2 mt-2">
				<button type="button" id="effacer" class="btn btn-sm btn-outline-secondary">Effacer</button>
			</div>

			<div class="d-flex flex-wrap gap-2 mt-3">
				{% if signature_seule %}
					<button type="submit" class="btn btn-primary">Enregistrer la signature</button>
				{% else %}
					<button type="submit" class="btn btn-primary"
						onclick="return confirm('Valider le prêt ? Le matériel passera au statut « Prêté ».');">
						✅ Valider le prêt
					</button>
				{% endif %}
				<a href="/prets/pret-{{ pret.id }}" class="btn btn-secondary">Annuler</a>
			</div>
			{% if not signature_seule %}
				<p class="small text-muted mt-2">Sans signature à l'écran, la fiche PDF comporte un cadre à faire signer sur papier.</p>
			{% endif %}
		</form>
	</div>
{% endblock %}

{% block javascripts %}
	{{ parent() }}
	<script>
	(function () {
		const canvas = document.getElementById('pad');
		const ctx = canvas.getContext('2d');
		let trace = false;
		let signe = false;
		let dernier = null;

		function dimensionner() {
			const ratio = Math.max(window.devicePixelRatio || 1, 1);
			const image = signe ? canvas.toDataURL() : null;
			canvas.width = canvas.clientWidth * ratio;
			canvas.height = canvas.clientHeight * ratio;
			ctx.setTransform(ratio, 0, 0, ratio, 0, 0);
			ctx.lineWidth = 2.2;
			ctx.lineCap = 'round';
			ctx.lineJoin = 'round';
			ctx.strokeStyle = '#1a237e';
			ctx.fillStyle = '#1a237e';
			if (image) {
				const img = new Image();
				img.onload = () => ctx.drawImage(img, 0, 0, canvas.clientWidth, canvas.clientHeight);
				img.src = image;
			}
		}
		function point(e) {
			const r = canvas.getBoundingClientRect();
			return { x: e.clientX - r.left, y: e.clientY - r.top };
		}
		canvas.addEventListener('pointerdown', function (e) {
			trace = true;
			dernier = point(e);
			canvas.setPointerCapture(e.pointerId);
			ctx.beginPath();
			ctx.arc(dernier.x, dernier.y, 1, 0, Math.PI * 2);
			ctx.fill();
			signe = true;
		});
		canvas.addEventListener('pointermove', function (e) {
			if (!trace) return;
			const p = point(e);
			ctx.beginPath();
			ctx.moveTo(dernier.x, dernier.y);
			ctx.lineTo(p.x, p.y);
			ctx.stroke();
			dernier = p;
		});
		['pointerup', 'pointercancel', 'pointerleave'].forEach(t => canvas.addEventListener(t, () => { trace = false; }));
		document.getElementById('effacer').addEventListener('click', function () {
			ctx.clearRect(0, 0, canvas.width, canvas.height);
			signe = false;
		});
		window.addEventListener('resize', dimensionner);
		dimensionner();

		// Export réduit (600 px de large au plus) pour limiter la taille.
		document.getElementById('form-signature').addEventListener('submit', function () {
			if (!signe) {
				document.getElementById('signature').value = '';
				return;
			}
			const largeur = Math.min(600, canvas.width);
			const hauteur = Math.round(canvas.height * largeur / canvas.width);
			const sortie = document.createElement('canvas');
			sortie.width = largeur;
			sortie.height = hauteur;
			sortie.getContext('2d').drawImage(canvas, 0, 0, largeur, hauteur);
			document.getElementById('signature').value = sortie.toDataURL('image/png');
		});
	})();
	</script>
{% endblock %}
