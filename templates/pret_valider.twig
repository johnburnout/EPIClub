{% extends "_layout.twig" %}

{% block body %}
	<h3>{% if signature_seule %}✍️ {{ 'Signature — prêt n° {id}'|trans({id: pret.id}) }}{% else %}✅ {{ 'Validation — prêt n° {id}'|trans({id: pret.id}) }}{% endif %}</h3>
	<hr>

	<div style="max-width: 40rem;">
		<p class="mb-1">{{ '<strong>Emprunteur :</strong> {emprunteur_prenom} {emprunteur_nom}'|trans({emprunteur_prenom: (pret.emprunteur_prenom)|e, emprunteur_nom: (pret.emprunteur_nom)|e})|raw }}
			{% if pret.emprunteur_licence %}— {{ 'licence {emprunteur_licence}'|trans({emprunteur_licence: pret.emprunteur_licence}) }}{% endif %}</p>
		<p class="mb-1">{{ '<strong>Téléphone :</strong> {emprunteur_telephone}'|trans({emprunteur_telephone: (pret.emprunteur_telephone)|e})|raw }}</p>
		<p>{{ '<strong>Du</strong> {date_pret} <strong>au</strong> {date_retour_prevue} (retour prévu)'|trans({date_pret: (pret.date_pret|date('d/m/Y'))|e, date_retour_prevue: (pret.date_retour_prevue|date('d/m/Y'))|e})|raw }}</p>

		<h6>{{ 'Matériel ({lignes})'|trans({lignes: (lignes|length)}) }}</h6>
		<ul class="list-group mb-3">
			{% for l in lignes %}
				<li class="list-group-item py-1">{{ l.reference }} — {{ l.libelle }}</li>
			{% endfor %}
		</ul>

		<form method="post" id="form-signature">
			<input type="hidden" name="csrf_token" value="{{ csrf_token }}">
			<input type="hidden" name="signature" id="signature">

			<label class="form-label"><strong>{{ "Signature de l'emprunteur"|trans }}</strong>{% if not signature_seule %} {{ '(facultative)'|trans }}{% endif %}</label>
			<p class="small text-muted mb-1">
				{{ "« Je reconnais avoir reçu le matériel ci-dessus en bon état et m'engage à le restituer au plus tard le {date_retour_prevue}. » Signez avec le doigt ou la souris dans le cadre."|trans({date_retour_prevue: (pret.date_retour_prevue|date('d/m/Y'))}) }}
			</p>
			<canvas id="pad" class="border rounded bg-white w-100" style="height: 12rem; touch-action: none; cursor: crosshair;"></canvas>
			<div class="d-flex flex-wrap gap-2 mt-2">
				<button type="button" id="effacer" class="btn btn-sm btn-outline-secondary">{{ 'Effacer'|trans }}</button>
			</div>

			<div class="d-flex flex-wrap gap-2 mt-3">
				{% if signature_seule %}
					<button type="submit" class="btn btn-primary">{{ 'Enregistrer la signature'|trans }}</button>
				{% else %}
					<button type="submit" class="btn btn-primary"
						data-confirm="{{ 'Valider le prêt ? Le matériel passera au statut « Prêté ».'|trans }}">
						✅ {{ 'Valider le prêt'|trans }}
					</button>
				{% endif %}
				<a href="/prets/pret-{{ pret.id }}" class="btn btn-secondary">{{ 'Annuler'|trans }}</a>
			</div>
			{% if not signature_seule %}
				<p class="small text-muted mt-2">{{ "Sans signature à l'écran, la fiche PDF comporte un cadre à faire signer sur papier."|trans }}</p>
			{% endif %}
		</form>
	</div>
{% endblock %}

{% block javascripts %}
	{{ parent() }}
	<script nonce="{{ csp_nonce }}">
	(function () {
		const canvas = document.getElementById('pad');
		const ctx = canvas.getContext('2d');
		let trace = false;
		let signe = false;
		let dernier = null;

		function dimensionner() {
			const ratio = Math.max(window.devicePixelRatio || 1, 1);
			const image = signe ? canvas.toDataURL() : null;
			canvas.width = canvas.clientWidth * ratio;
			canvas.height = canvas.clientHeight * ratio;
			ctx.setTransform(ratio, 0, 0, ratio, 0, 0);
			ctx.lineWidth = 2.2;
			ctx.lineCap = 'round';
			ctx.lineJoin = 'round';
			ctx.strokeStyle = '#1a237e';
			ctx.fillStyle = '#1a237e';
			if (image) {
				const img = new Image();
				img.onload = () => ctx.drawImage(img, 0, 0, canvas.clientWidth, canvas.clientHeight);
				img.src = image;
			}
		}
		function point(e) {
			const r = canvas.getBoundingClientRect();
			return { x: e.clientX - r.left, y: e.clientY - r.top };
		}
		canvas.addEventListener('pointerdown', function (e) {
			trace = true;
			dernier = point(e);
			canvas.setPointerCapture(e.pointerId);
			ctx.beginPath();
			ctx.arc(dernier.x, dernier.y, 1, 0, Math.PI * 2);
			ctx.fill();
			signe = true;
		});
		canvas.addEventListener('pointermove', function (e) {
			if (!trace) return;
			const p = point(e);
			ctx.beginPath();
			ctx.moveTo(dernier.x, dernier.y);
			ctx.lineTo(p.x, p.y);
			ctx.stroke();
			dernier = p;
		});
		['pointerup', 'pointercancel', 'pointerleave'].forEach(t => canvas.addEventListener(t, () => { trace = false; }));
		document.getElementById('effacer').addEventListener('click', function () {
			ctx.clearRect(0, 0, canvas.width, canvas.height);
			signe = false;
		});
		window.addEventListener('resize', dimensionner);
		dimensionner();

		// Export réduit (600 px de large au plus) pour limiter la taille.
		document.getElementById('form-signature').addEventListener('submit', function () {
			if (!signe) {
				document.getElementById('signature').value = '';
				return;
			}
			const largeur = Math.min(600, canvas.width);
			const hauteur = Math.round(canvas.height * largeur / canvas.width);
			const sortie = document.createElement('canvas');
			sortie.width = largeur;
			sortie.height = hauteur;
			sortie.getContext('2d').drawImage(canvas, 0, 0, largeur, hauteur);
			document.getElementById('signature').value = sortie.toDataURL('image/png');
		});
	})();
	</script>
{% endblock %}
