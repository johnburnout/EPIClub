{% extends "_layout.twig" %}

{# [2026-10-25] Fiche emplacement en lecture seule (le formulaire de
   saisie est emplacement_form.twig, réservé aux administrateurs). #}
{% block body %}
	<h3>{{ 'Fiche emplacement'|trans }}</h3>
	<hr>

	<div class="row">
		{% if emplacement.image %}
			<div class="col-md-4 mb-3">
				<img src="{{ emplacement.image }}" alt="{{ emplacement.libelle }}" class="img-fluid rounded">
			</div>
		{% endif %}
		<div class="col-md-8">
			<div class="mb-3">{{ '<strong>Libellé :</strong> {libelle}'|trans({libelle: (emplacement.libelle)|e})|raw }}</div>
			<div class="mb-3"><strong>{{ 'Description :'|trans }}</strong>
				{% if emplacement.description %}{{ emplacement.description }}{% else %}<em>{{ 'Non renseignée'|trans }}</em>{% endif %}
			</div>
			<div class="mb-3 d-flex flex-wrap gap-2">
				<a href="{{ url_liste('/admin/emplacements') }}" class="btn btn-secondary">{{ 'Retour à la liste'|trans }}</a>
				{% if nb_equipements > 0 %}
				<a href="/equipements?emplacement={{ emplacement.id }}" class="btn btn-primary">📋 {{ nb_equipements > 1 ? 'Voir les {nombre} équipements'|trans({nombre: nb_equipements}) : "Voir l'équipement"|trans }}</a>
				{% else %}
				<span class="btn btn-outline-secondary disabled">{{ 'Aucun équipement'|trans }}</span>
				{% endif %}
				{% if isGranted('ROLE_ADMIN') %}
				<a href="/admin/emplacements/emplacement_modification-{{ emplacement.id }}" class="btn btn-warning">{{ 'Modifier'|trans }}</a>
				{% endif %}
			</div>
		</div>
	</div>
{% endblock %}
