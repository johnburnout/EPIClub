{% extends "_layout.twig" %}

{% block body %}
	<h3>{% if emplacement.id %}Modifier{% else %}Nouvel{% endif %} emplacement</h3>
	<hr>

	<form method="post">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
		<div class="mb-3">
			<label for="libelle">Libellé *</label>
			<input type="text" id="libelle" name="libelle" value="{{ emplacement.libelle }}"
			       class="form-control {% if form_errors.libelle %}is-invalid{% endif %}">
			{% if form_errors.libelle %}
				<div class="invalid-feedback">{{ form_errors.libelle }}</div>
			{% endif %}
		</div>
		<div class="mb-3">
			<label for="description">Description</label>
			<textarea id="description" name="description" class="form-control" rows="3">{{ emplacement.description }}</textarea>
		</div>
		<div class="mb-3">
			<label for="image">Image (URL)</label>
			<input type="text" id="image" name="image" value="{{ emplacement.image }}"
			       class="form-control {% if form_errors.image %}is-invalid{% endif %}"
			       placeholder="https://exemple.com/photo.jpg">
			{% if form_errors.image %}
				<div class="invalid-feedback">{{ form_errors.image }}</div>
			{% endif %}
		</div>
		<button type="submit" class="btn btn-primary">Enregistrer</button>
		<a href="/admin/emplacements" class="btn btn-secondary">Annuler</a>
	</form>
{% endblock %}