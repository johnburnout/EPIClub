{% extends "_layout.twig" %}

{% block body %}
	<h3>Emplacement</h3>
	<hr>

	<div class="card">
		<div class="card-body">
			<h5 class="card-title">{{ emplacement.libelle }}</h5>
			<p><strong>Description :</strong> {{ emplacement.description }}</p>
			<p><strong>Image :</strong> {{ emplacement.image }}</p>
		</div>
	</div>

	<div class="mt-3 d-flex gap-2">
		<a href="/admin/emplacements" class="btn btn-secondary">Retour</a>
		<a href="/admin/emplacements/emplacement_modification-{{ emplacement.id }}" class="btn btn-warning">Modifier</a>
		<form method="post" action="/admin/emplacements/supprimer" class="ms-auto">
			<input type="hidden" name="id" value="{{ emplacement.id }}">
			<button type="submit" class="btn btn-danger"
			        onclick="return confirm('Êtes-vous sûr de vouloir supprimer cet emplacement ? Cette action est irréversible.')">
				🗑️ Supprimer
			</button>
		</form>
	</div>
{% endblock %}