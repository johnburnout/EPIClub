{% extends "_layout.twig" %}

{% block body %}

	<h3>Fiche Utilisateur{% if est_protege|default(false) %} <span class="badge bg-dark align-middle fs-6">🔒 Compte protégé</span>{% endif %}</h3>
	<hr>

	{% if protege_pour_acteur|default(false) %}
		<div class="alert alert-info">
			🔒 Ce compte super-administrateur a été créé à l'installation : il ne peut être ni supprimé,
			ni rétrogradé, et seul son titulaire peut modifier son adresse mail et son mot de passe.
		</div>
	{% endif %}

	<form method="post">
		<div class="mb-3">
			<label for="prenom">Prénom :</label>
			<input type="text" id="prenom" name="prenom" value="{{ utilisateur.prenom }}" class="form-control {% if form_errors.prenom %}is-invalid{% endif %}">
			{% if form_errors.prenom %}<div class="invalid-feedback">{{ form_errors.prenom }}</div>{% endif %}
		</div>

		<div class="mb-3">
			<label for="nom">Nom :</label>
			<input type="text" id="nom" name="nom" value="{{ utilisateur.nom }}" class="form-control {% if form_errors.nom %}is-invalid{% endif %}">
			{% if form_errors.nom %}<div class="invalid-feedback">{{ form_errors.nom }}</div>{% endif %}
		</div>

		<div class="mb-3">
			<label for="username">Pseudo :</label>
			<input type="text" id="username" value="{{ utilisateur.username }}" class="form-control" readonly disabled>
			<small class="form-text text-muted">Le pseudo ne peut pas être modifié.</small>
			<input type="hidden" name="username" value="{{ utilisateur.username }}">
		</div>

		<div class="mb-3">
			<label for="email">Adresse mail :</label>
			<input type="email" id="email" name="email" value="{{ utilisateur.email }}" class="form-control {% if form_errors.email %}is-invalid{% endif %}"
			       {% if protege_pour_acteur|default(false) %}readonly disabled{% endif %}>
			{% if form_errors.email %}<div class="invalid-feedback">{{ form_errors.email }}</div>{% endif %}
		</div>

		{% if not protege_pour_acteur|default(false) %}
		<div class="mb-3">
			<label for="password">Nouveau mot de passe :</label>
			<input type="password" id="password" name="password" class="form-control {% if form_errors.password %}is-invalid{% endif %}">
			<small class="form-text text-muted">Laisser vide pour ne pas modifier le mot de passe.</small>
			{% if form_errors.password %}<div class="invalid-feedback">{{ form_errors.password }}</div>{% endif %}
		</div>
		{% endif %}

		<div class="mb-3">
			<label for="role">Rôle :</label>

			{% if (is_self is defined and is_self) or protege_pour_acteur|default(false) %}
				{# Un utilisateur ne peut pas modifier son propre rôle via ce formulaire.
				   Le contrôleur l'ignore de toute façon ; on désactive le champ pour
				   éviter toute confusion côté interface. #}
				<select id="role" class="form-control" disabled>
					{% for role, label in roles %}
						<option value="{{ role }}" {% if utilisateur.role == role %} selected {% endif %}>{{ label }}</option>
					{% endfor %}
				</select>
				<input type="hidden" name="role" value="{{ utilisateur.role }}">
				<small class="form-text text-muted">
					{% if protege_pour_acteur|default(false) %}
						Le rôle du compte protégé ne peut pas être modifié.
					{% else %}
						Vous ne pouvez pas modifier votre propre rôle. Demandez à un autre administrateur.
					{% endif %}
				</small>
			{% else %}
				<select name="role" id="role" class="form-control {% if form_errors.role %}is-invalid{% endif %}">
					{% for role, label in roles %}
						<option value="{{ role }}" {% if utilisateur.role == role %} selected {% endif %}>{{ label }}</option>
					{% endfor %}
				</select>
				{% if form_errors.role %}<div class="invalid-feedback">{{ form_errors.role }}</div>{% endif %}
			{% endif %}
		</div>

		<div class="form-actions d-flex gap-2">
			<input type="hidden" name="csrf_token" value="{{ csrf_token }}">
			<button type="submit" class="btn btn-primary">Enregistrer</button>
			<a href="/admin/utilisateurs" class="btn btn-secondary">Retour à la liste</a>

			{# Le bouton de suppression utilise l'attribut HTML5 `form` pour cibler
			   un formulaire séparé (les formulaires ne peuvent pas être imbriqués). #}
			{% if can_delete is defined and can_delete %}
				<button type="submit" form="delete-utilisateur-form" class="btn btn-danger ms-auto"
				        onclick="return confirm('Êtes-vous sûr de vouloir supprimer cet utilisateur ? Cette action est irréversible.')">
					🗑️ Supprimer l'utilisateur
				</button>
			{% elseif is_self is defined and is_self %}
				<span class="badge bg-info ms-auto p-2">
					🔒 Vous ne pouvez pas supprimer votre propre compte
				</span>
			{% elseif est_protege|default(false) %}
				<span class="badge bg-info ms-auto p-2">
					🔒 Compte protégé : suppression impossible
				</span>
			{% elseif utilisateur.role == 'ROLE_SUPER_ADMIN' %}
				<span class="badge bg-warning text-dark ms-auto p-2">
					🔒 Dernier SUPER_ADMIN : suppression impossible
				</span>
			{% endif %}
		</div>
	</form>

	{# Formulaire de suppression séparé, ciblé par l'attribut `form` du bouton ci-dessus. #}
	{% if can_delete is defined and can_delete %}
		<form id="delete-utilisateur-form" method="post"
		      action="/admin/utilisateurs/utilisateur_supprimer-{{ utilisateur.id }}"
		      style="display:none;">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}"></form>
	{% endif %}

{% endblock %}