{% extends "_layout.twig" %}

{% block body %}

	<h3>Fiche Catégorie</h3>
	<hr>

	<div class="row h-100">
		<div class="col-md-6">
			{% if categorie.image %}
				<img src="/images/{{ categorie.image }}" alt="{{ categorie.libelle }}" class="img-fluid">
			{% endif %}
		</div>
		<div class="col-md-6">
			<div class="mb-3">
				<label for="libelle">Libellé :</label>
				{{ categorie.libelle }}
			</div>
			<div class="mb-3">
				<label for="code">Code :</label>
				{% if categorie.code %}
					<code>{{ categorie.code }}</code>
				{% else %}
					<span class="text-muted">— (attribué automatiquement à la première utilisation)</span>
				{% endif %}
			</div>
			<div class="mb-3">
				{% set est_epi_value = "Oui" %}
				{% if categorie.est_epi == 0 %}
					{% set est_epi_value = "Non" %}
				{% endif %}
				<label for="est_epi">Classée EPI ? :</label>
				{{ est_epi_value }}
			</div>
			<div class="mb-3">
				<label for="duree_max_utilisation">Durée maximum d'utilisation :</label>
				{{ categorie.duree_max_utilisation ? 'Oui' : 'Non' }}
			</div>
			<div class="mb-3">
				<label for="description">Description :</label>
				{{ categorie.description }}
			</div>
			<div class="mb-3 d-flex gap-2">
				<a href="/admin/categories" class="btn btn-secondary">Retour à la liste</a>
				{% if nb_equipements > 0 %}
				<a href="/equipements?categorie={{ categorie.id }}" class="btn btn-primary">📋 {{ nb_equipements > 1 ? 'Voir les ' ~ nb_equipements ~ ' équipements' : 'Voir l\'équipement' }}</a>
				{% else %}
				<span class="btn btn-outline-secondary disabled">Aucun équipement</span>
				{% endif %}
				{% if isGranted('ROLE_ADMIN') %}
				<a href="/admin/categories/categorie_modification-{{ categorie.id }}" class="btn btn-warning">Modifier</a>
				<form method="post" action="/admin/categories/supprimer" class="ms-auto">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
					<input type="hidden" name="id" value="{{ categorie.id }}">
					<button type="submit" class="btn btn-danger"
					        onclick="return confirm('Êtes-vous sûr de vouloir supprimer la catégorie « {{ categorie.libelle }} » ? Cette action est irréversible.')">
						🗑️ Supprimer
					</button>
				</form>
				{% endif %}
			</div>
		</div>
	</div>
{% endblock %}