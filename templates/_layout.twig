<!DOCTYPE html>
<html lang="fr">

	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>Epiclub</title>
		<link rel="shortcut icon" href="/assets/img/favicon.ico" type="image/x-icon">
		<link rel="stylesheet" type="text/css" href="/assets/css/cosmo.min.css">
	</head>

	<body>
		<header class="container mt-3">
			<div class="text-center">
				<hr>
				<img src="/assets/img/EPIClub.png" class="" width="64" alt="Logo EPIClub">
				<span class="h1 text-primary align-middle ps-3">
					<strong>Gestionnaire EPI</strong>
				</span>
				<hr>
			</div>
			<nav class="navbar navbar-expand-lg bg-primary" data-bs-theme="dark">
				<div class="container-fluid">
					<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarColor01" aria-controls="navbarColor01" aria-expanded="false" aria-label="Toggle navigation">
						<span class="navbar-toggler-icon"></span>
					</button>
					<div class="collapse navbar-collapse" id="navbarColor01">
						<ul class="navbar-nav me-auto">
							<li class="nav-item">
								<a class="nav-link active" href="/">Tableau de bord
									<span class="visually-hidden">(current)</span>
								</a>
							</li>
							{% if isGranted('ROLE_USER') %}
							<li class="nav-item">
								<a class="nav-link" href="/equipements">Liste équipements</a>
							</li>
							{# Lien Journaux visible uniquement pour les utilisateurs simples (ROLE_USER) #}
							{% if _user.role == 'ROLE_USER' %}
							<li class="nav-item">
								<a class="nav-link" href="/journaux">📋 Journaux</a>
							</li>
							{% endif %}
							{% endif %}
							{% if isGranted('ROLE_CONTROLLEUR') %}
							<li class="nav-item dropdown">
								<a class="nav-link dropdown-toggle" data-bs-toggle="dropdown" href="#" role="button" aria-haspopup="true" aria-expanded="false">Contrôles</a>
								<div class="dropdown-menu">
									{% if _user.controle_en_cours_id is empty or _user.controle_en_cours_id == 0 %}
									<a class="dropdown-item" href="/admin/controles/creer">➕ Créer un contrôle</a>
									<div class="dropdown-divider"></div>
									{% endif %}
									<a class="dropdown-item" href="/admin/controles">📋 Voir les contrôles</a>
									<a class="dropdown-item" href="/journaux">📝 Journaux</a>
								</div>
							</li>
							{% endif %}
							{% if isGranted('ROLE_ADMIN') %}
								<li class="nav-item dropdown">
									<a class="nav-link dropdown-toggle" data-bs-toggle="dropdown" href="#" role="button" aria-haspopup="true" aria-expanded="false">Administration</a>
									<div class="dropdown-menu">
										<a class="dropdown-item" href="/admin/club">🏛️ Club</a>
										<a class="nav-link" href="/admin/system-settings">⚙️ Système</a>
										<a class="dropdown-item" href="/admin/utilisateurs">👤 Utilisateurs</a>
										<a class="dropdown-item" href="/admin/fournisseurs">🏷️ Fournisseurs</a>
										<a><hr class="dropdown-divider"></a>
										<a class="dropdown-item" href="/admin/categories">📂 Catégories</a>
										<a class="dropdown-item" href="/admin/emplacements">📍 Emplacements</a>
										<a><hr class="dropdown-divider"></a>
										<a class="dropdown-item" href="/admin/acquisitions">📦 Acquisitions</a>
										{# <a class="dropdown-item" href="/affectations">Gestion des affectations</a>
										<a class="dropdown-item" href="/fabricants">Gestion des fabricants</a> #}
									</div>
								</li>
							{% endif %}
							<li class="nav-item">
								<a class="nav-link" href="/guide" target="_blank">
									<i class="fas fa-book"></i> Guide
								</a>
							</li>
						</ul>
						<div class="d-flex align-items-center">
							{% if isAuthenticated() %}
							{% set user = _user %}
							{% if user %}
							{% set roleLabels = {
							'ROLE_ADMIN': 'Administrateur',
							'ROLE_USER': 'Utilisateur',
							'ROLE_CONTROLLEUR': 'Contrôleur'
							} %}
							<span class="me-3 text-white">
								{{ user.prenom }} {{ user.nom }}
								<span class="badge bg-light text-dark">{{ roleLabels[user.role]|default(user.role) }}</span>
							</span>
							{% endif %}
							<form action="/se_deconnecter" method="post" style="display: inline;">
								<input type="hidden" name="csrf_token" value="{{ csrf_token }}"/>
								<button type="submit" class="btn btn-primary">Déconnexion</button>
							</form>
							{% else %}
							<a href="/se_connecter" class="btn btn-primary">Connexion</a>
							{% endif %}
						</div>
					</div>
				</div>
			</nav>
		</header>
		<main class="container mt-2">
			{% for label, messages in session.getFlashBag.all %}
				{% for message in messages %}
					<div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
						{{ message }}
						<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
					</div>
				{% endfor %}
			{% endfor %}
			{% block body %}{% endblock %}
		</main>
		<footer class="container">
			<hr>
			<p class="text-center text-body-secondary">
				<a href="https://epiclub.fr">Epiclub 0.10.2 (beta)</a>
			</p>
		</footer>
		<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
		
		{# ============================================ #}
		{# === BLOCK POUR LES SCRIPTS PERSONNALISÉS === #}
		{# ============================================ #}
		{% block javascripts %}
			<!-- Scripts par défaut pour les QR codes -->
			<script>
				/**
				 * Sauvegarde un QR code sur le serveur
				 * @param {number} equipementId - L'ID de l'équipement
				 */
				function sauvegarderQR(equipementId) {
					// Afficher un indicateur de chargement
					const btn = document.querySelector('[onclick*="sauvegarderQR(' + equipementId + ')"]');
					if (btn) {
						const originalHtml = btn.innerHTML;
						btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Sauvegarde...';
						btn.disabled = true;
					}

					fetch('/qr/save/' + equipementId)
						.then(response => {
							if (!response.ok) {
								throw new Error('Erreur HTTP: ' + response.status);
							}
							return response.json();
						})
						.then(data => {
							// Restaurer le bouton
							if (btn) {
								btn.innerHTML = originalHtml;
								btn.disabled = false;
							}

							if (data.success) {
								// Afficher un message de succès
								showNotification('success', 'QR code sauvegardé avec succès !', 'Fichier : ' + data.filename);
								
								// Mettre à jour l'image pour utiliser le fichier sauvegardé
								const img = document.querySelector('#qr-code-image');
								if (img) {
									img.src = '/qr/view/' + data.filename.replace('.png', '');
								}
							} else {
								showNotification('danger', 'Erreur lors de la sauvegarde', data.error || 'Erreur inconnue');
							}
						})
						.catch(error => {
							// Restaurer le bouton
							if (btn) {
								btn.innerHTML = originalHtml;
								btn.disabled = false;
							}
							showNotification('danger', 'Erreur', error.message);
						});
				}

				/**
				 * Affiche une notification
				 * @param {string} type - success, danger, warning, info
				 * @param {string} title - Titre de la notification
				 * @param {string} message - Message de la notification
				 */
				function showNotification(type, title, message) {
					// Vérifier si Bootstrap est disponible
					if (typeof bootstrap !== 'undefined' && bootstrap.Toast) {
						// Créer un toast Bootstrap
						const toastContainer = document.getElementById('toast-container') || createToastContainer();
						
						const toastEl = document.createElement('div');
						toastEl.className = 'toast align-items-center text-white bg-' + type + ' border-0';
						toastEl.role = 'alert';
						toastEl.ariaLive = 'assertive';
						toastEl.ariaAtomic = 'true';
						toastEl.innerHTML = `
							<div class="d-flex">
								<div class="toast-body">
									<strong>${title}</strong><br>
									${message}
								</div>
								<button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
							</div>
						`;
						toastContainer.appendChild(toastEl);
						
						const toast = new bootstrap.Toast(toastEl, { delay: 5000 });
						toast.show();
						
						// Supprimer le toast après fermeture
						toastEl.addEventListener('hidden.bs.toast', function() {
							this.remove();
						});
					} else {
						// Fallback avec alert standard
						alert(title + '\n' + message);
					}
				}

				/**
				 * Crée le conteneur pour les toasts
				 * @returns {HTMLElement} Le conteneur créé
				 */
				function createToastContainer() {
					const container = document.createElement('div');
					container.id = 'toast-container';
					container.className = 'position-fixed bottom-0 end-0 p-3';
					container.style.zIndex = '9999';
					document.body.appendChild(container);
					return container;
				}

				/**
				 * Copie l'URL du QR code dans le presse-papier
				 * @param {number} equipementId - L'ID de l'équipement
				 */
				function copierUrlQR(equipementId) {
					const url = window.location.origin + '/qr/' + equipementId;
					if (navigator.clipboard) {
						navigator.clipboard.writeText(url)
							.then(() => {
								showNotification('success', 'URL copiée !', 'L\'URL du QR code a été copiée dans le presse-papier.');
							})
							.catch(() => {
								// Fallback
								copierUrlFallback(url);
							});
					} else {
						copierUrlFallback(url);
					}
				}

				/**
				 * Fallback pour la copie d'URL
				 * @param {string} url - L'URL à copier
				 */
				function copierUrlFallback(url) {
					const textarea = document.createElement('textarea');
					textarea.value = url;
					textarea.style.position = 'fixed';
					textarea.style.opacity = '0';
					document.body.appendChild(textarea);
					textarea.select();
					try {
						document.execCommand('copy');
						showNotification('success', 'URL copiée !', 'L\'URL du QR code a été copiée dans le presse-papier.');
					} catch (err) {
						showNotification('danger', 'Erreur', 'Impossible de copier l\'URL.');
					}
					document.body.removeChild(textarea);
				}

				// Initialiser le conteneur de toasts au chargement
				document.addEventListener('DOMContentLoaded', function() {
					createToastContainer();
				});
			</script>
		{% endblock %}
		{# ============================================ #}
		{# === FIN BLOCK JAVASCRIPTS === #}
		{# ============================================ #}
	</body>

</html>
