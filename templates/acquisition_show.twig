{% extends "_layout.twig" %}

{% block body %}

	<h3>Acquisition #{{ acquisition.id }}</h3>
	<hr>

	<!-- INFORMATIONS GÉNÉRALES -->
	<div class="card">
		<div class="card-header">
			Informations générales
			{% if acquisition.est_validee %}
				<span class="badge bg-success float-end">✅ Validée</span>
			{% else %}
				<span class="badge bg-warning float-end">⏳ En attente de validation</span>
			{% endif %}
		</div>
		<div class="card-body">
			<div class="row">
				<div class="col-md-6">
					<div class="mb-2">
						<strong>Fournisseur :</strong> 
						{{ acquisition.fournisseur.nom }}
					</div>
					<div class="mb-2">
						<strong>Référence facture :</strong> 
						{{ acquisition.facture_reference }}
					</div>
					<div class="mb-2">
						<strong>Date d'achat :</strong> 
						{{ acquisition.facture_date|date("d/m/Y") }}
					</div>
				</div>
				<div class="col-md-6">
					<div class="mb-2">
						<strong>Saisie par :</strong> 
						{{ acquisition.redacteur.prenom }} {{ acquisition.redacteur.nom }}
					</div>
					<div class="mb-2">
						<strong>Document :</strong> 
						{# « facture à importer » = AcquisitionManager::FACTURE_A_IMPORTER (placeholder posé par l'import Excel/CSV) #}
						{% if acquisition.facture_document == 'facture à importer' %}
							<span class="badge bg-secondary">📄 facture à importer</span>
						{% elseif acquisition.facture_document %}
							<a href="/uploads/{{ acquisition.facture_document }}" target="_blank">📄 Voir la facture</a>
						{% else %}
							<span class="text-muted">Aucun document</span>
						{% endif %}
						{# Sur une acquisition validée, seul le document de facture
						   peut encore être remplacé (action update_facture). #}
						{% if isGranted('ROLE_ADMIN') and acquisition.est_validee %}
							<form method="post" action="/admin/acquisitions/acquisition_modification-{{ acquisition.id }}" enctype="multipart/form-data" class="mt-2">
								<input type="hidden" name="csrf_token" value="{{ csrf_token }}">
								<input type="hidden" name="action" value="update_facture">
								<div class="input-group input-group-sm" style="max-width: 24rem;">
									<input type="file" name="facture_document" class="form-control" required>
									<button type="submit" class="btn btn-outline-primary">
										{% if acquisition.facture_document == 'facture à importer' %}
											📤 Importer la facture
										{% else %}
											📤 Remplacer la facture
										{% endif %}
									</button>
								</div>
							</form>
						{% endif %}
					</div>
					<div class="mb-2">
						<strong>Statut :</strong>
						{% if acquisition.est_validee %}
							<span class="badge bg-success">Validée</span>
						{% else %}
							<span class="badge bg-warning">En attente</span>
						{% endif %}
					</div>
				</div>
			</div>
		</div>
	</div>

	{# [2026-10-24] Correction de la référence et de la date de facture
	   (super-administrateur) : roue dentée, unicité vérifiée à la volée,
	   mots REFERENCE et DATE, dates manuelles des équipements réinterrogées. #}
	{% if correction_possible %}
		{% set date_actuelle = acquisition.facture_date|date('Y-m-d') %}
		{% set dates_manuelles = equipements_dates|filter(e => e.mes_manuelle or e.fin_manuelle) %}
		<div class="mt-2 text-end">
			<button type="button" class="btn btn-outline-secondary btn-sm" id="afficher-correction"
			        aria-pressed="false" aria-controls="carte-correction" title="Modification de la référence et de la date">
				<i class="fas fa-cog"></i> <span>Modifier la référence et la date</span>
			</button>
		</div>
		<div class="card mt-2 border-warning d-none" id="carte-correction">
			<div class="card-body">
				<form method="post" action="/admin/acquisitions/acquisition_corriger-{{ acquisition.id }}" id="form-correction"
				      data-acquisition-id="{{ acquisition.id }}">
					<input type="hidden" name="csrf_token" value="{{ csrf_token }}">

					<div class="mb-3">
						<label for="facture_reference" class="form-label">Référence facture</label>
						<input type="text" class="form-control" name="facture_reference" id="facture_reference"
						       value="{{ acquisition.facture_reference }}" data-actuelle="{{ acquisition.facture_reference }}"
						       maxlength="{{ reference_facture_max }}" required autocomplete="off">
						<div class="form-text" id="facture-reference-statut" aria-live="polite"></div>
						<div class="mt-2 p-2 border border-warning rounded d-none" id="bloc-confirmation-reference">
							<label for="confirmation_reference" class="form-label">
								Pour confirmer le changement de référence, saisissez <code>{{ mot_confirmation_reference }}</code>
							</label>
							<input type="text" class="form-control" name="confirmation_reference" id="confirmation_reference"
							       autocomplete="off" spellcheck="false" data-mot="{{ mot_confirmation_reference }}">
						</div>
					</div>

					<div class="mb-3">
						<label for="facture_date" class="form-label">Date d'achat (date de facture)</label>
						<input type="date" class="form-control" name="facture_date" id="facture_date"
						       value="{{ date_actuelle }}" data-actuelle="{{ date_actuelle }}" required>
						<div class="mt-2 p-2 border border-warning rounded d-none" id="bloc-confirmation-date">
							{% if equipements_dates %}
								<p class="small mb-2">
									<i class="fas fa-exclamation-triangle text-warning"></i>
									{{ equipements_dates|length }} équipement(s) issu(s) de cette acquisition : la date de mise en service
									égale à la date de facture et la date de fin d'utilisation calculée (achat + 10 ans) suivront la
									nouvelle date. Les références des équipements ne changent pas.
								</p>
							{% endif %}
							{% if dates_manuelles %}
								<p class="small mb-1"><strong>Dates saisies à la main : à confirmer ou corriger</strong>
									(la mise en service ne peut pas précéder la nouvelle date de facture).</p>
								<div class="table-responsive">
									<table class="table table-sm align-middle" id="dates-manuelles">
										<thead>
											<tr><th>Équipement</th><th>Mise en service</th><th>Fin d'utilisation</th></tr>
										</thead>
										<tbody>
											{% for e in dates_manuelles %}
												<tr>
													<td><a href="/equipements/equipement-{{ e.id }}">{{ e.reference }}</a> <span class="text-muted small">{{ e.libelle }}</span></td>
													<td>
														{% if e.mes_manuelle %}
															<input type="date" class="form-control form-control-sm date-mes" required
															       name="date_mise_en_service[{{ e.id }}]" value="{{ e.date_mise_en_service }}">
														{% else %}
															<span class="text-muted small">suit la date de facture</span>
														{% endif %}
													</td>
													<td>
														{% if e.fin_manuelle %}
															<input type="date" class="form-control form-control-sm" required
															       name="date_fin_utilisation[{{ e.id }}]" value="{{ e.date_fin_utilisation }}">
														{% elseif e.date_fin_utilisation %}
															<span class="text-muted small">recalculée</span>
														{% else %}
															<span class="text-muted small">—</span>
														{% endif %}
													</td>
												</tr>
											{% endfor %}
										</tbody>
									</table>
								</div>
							{% endif %}
							<label for="confirmation_date" class="form-label">
								Pour confirmer le changement de date, saisissez <code>{{ mot_confirmation_date }}</code>
							</label>
							<input type="text" class="form-control" name="confirmation_date" id="confirmation_date"
							       autocomplete="off" spellcheck="false" data-mot="{{ mot_confirmation_date }}">
						</div>
					</div>

					<button type="submit" class="btn btn-warning">Enregistrer la correction</button>
				</form>
			</div>
		</div>
	{% endif %}

	<br>

	<!-- LIGNES D'ACQUISITION -->
	<div class="card">
		<div class="card-header">
			Lignes d'acquisition
			<span class="badge bg-secondary float-end">{{ acquisition.lignes|length }} ligne(s)</span>
		</div>
		<div class="card-body">
			{% if acquisition.lignes %}
				<table class="table table-striped">
					<thead>
						<tr>
							<th>Référence</th>
							<th>Désignation</th>
							<th>Catégorie</th>
							<th>EPI</th>
							<th>Nombre</th>
							<th>Générés</th>
							<th>Actions</th>
						</tr>
					</thead>
					<tbody>
						{% set total_equipements = 0 %}
						{% for ligne in acquisition.lignes %}
							{% set total_equipements = total_equipements + ligne.nombre %}
							<tr>
								<td>{{ ligne.reference }}</td>
								<td>{{ ligne.designation }}</td>
								<td>{{ ligne.categorie.libelle }}</td>
								<td>
									{% if ligne.categorie and ligne.categorie.est_epi %}
									<span class="badge bg-success">EPI</span>
									{% else %}
									<span class="badge bg-secondary">Non EPI</span>
									{% endif %}
								</td>
								<td>{{ ligne.nombre }}</td>
								<td>
									{% if ligne.equipements_generes %}
									<span class="badge bg-success">✅ Générés</span>
									{% else %}
									<span class="badge bg-warning">⏳ En attente</span>
									{% endif %}
								</td>
								<td>
									{% if ligne.equipements_generes == 0 %}
									<a href="/admin/acquisitions/ligne_modification-{{ ligne.id }}" class="btn btn-sm btn-warning">Modifier</a>
									<form method="post" action="/admin/acquisitions/ligne_supprimer-{{ ligne.id }}" style="display:inline;">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
										<button type="submit" class="btn btn-sm btn-danger"
											onclick="return confirm('Supprimer cette ligne ?')">
											Supprimer
										</button>
									</form>
									{% else %}
									<span class="text-muted">Verrouillée</span>
									{% endif %}
								</td>
							</tr>
						{% endfor %}
					</tbody>
					<tfoot>
						<tr class="table-info">
							<td colspan="3" class="text-end"><strong>Total équipements :</strong></td>
							<td><strong>{{ total_equipements }}</strong></td>
							<td colspan="2"></td>
						</tr>
					</tfoot>
				</table>
			{% else %}
				<p class="text-muted">Aucune ligne d'acquisition.</p>
			{% endif %}
		</div>
	</div>

	<br>

	<!-- BOUTONS D'ACTION -->
	<div class="mt-3">
		<a href="/admin/acquisitions" class="btn btn-secondary">Retour à la liste</a>
		
		<!-- BOUTON VALIDER -->
		{% if not acquisition.est_validee and acquisition.lignes and acquisition.lignes|length > 0 %}
			{% if acquisition.facture_document %}
				<form method="post" action="/admin/acquisitions/valider/{{ acquisition.id }}" style="display: inline;">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
					<button type="submit" name="action" value="valider" class="btn btn-success" 
						onclick="return confirm('⚠️ Valider cette acquisition ? Les équipements seront générés définitivement et vous ne pourrez plus modifier les lignes.')">
						✅ Valider l'acquisition
					</button>
				</form>
			{% else %}
				<button class="btn btn-success" disabled title="Veuillez d'abord télécharger la facture">
					✅ Valider l'acquisition
				</button>
				<span class="text-muted ms-2">📄 Facture requise avant validation</span>
			{% endif %}
		{% endif %}
		
		<!-- BOUTON MODIFIER -->
		{% if not acquisition.est_validee %}
			<a href="/admin/acquisitions/acquisition_modification-{{ acquisition.id }}" class="btn btn-primary">✏️ Modifier</a>
		{% else %}
			<span class="text-muted">🔒 Modification verrouillée</span>
		{% endif %}
		
		<!-- BOUTON VOIR LES ÉQUIPEMENTS - CORRIGÉ -->
		{% if acquisition.est_validee %}
			<a href="/equipements?acquisition={{ acquisition.id }}" class="btn btn-success">📋 Voir les équipements</a>
		{% endif %}
		
		<!-- BOUTON SUPPRIMER LE BROUILLON -->
		{% if isGranted('ROLE_ADMIN') and not acquisition.est_validee %}
		<form method="post" action="/admin/acquisitions/acquisition_supprimer-{{ acquisition.id }}" style="display:inline;">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
			<button type="submit" class="btn btn-danger"
				onclick="return confirm('⚠️ Supprimer définitivement cette acquisition ({{ acquisition.facture_reference }}) ?\n\nCette action est irréversible.');">
				🗑️ Supprimer le brouillon
			</button>
		</form>
		{% endif %}
	</div>

{% endblock %}

{% block javascripts %}
	{% if correction_possible %}
	<script>
		/**
		 * [2026-10-24] Correction de la référence et de la date (super-
		 * administrateur). La roue dentée affiche le formulaire (un nouveau
		 * clic le masque et rétablit les valeurs) ; unicité de la référence
		 * vérifiée à la volée ; mots REFERENCE / DATE exigés si la valeur
		 * change ; dates manuelles des équipements réinterrogées, jamais
		 * avant la nouvelle date de facture (tout est revérifié côté serveur).
		 */
		(function () {
			const bouton = document.getElementById('afficher-correction');
			const carte = document.getElementById('carte-correction');
			const form = document.getElementById('form-correction');
			const reference = document.getElementById('facture_reference');
			const statut = document.getElementById('facture-reference-statut');
			const blocReference = document.getElementById('bloc-confirmation-reference');
			const confReference = document.getElementById('confirmation_reference');
			const date = document.getElementById('facture_date');
			const blocDate = document.getElementById('bloc-confirmation-date');
			const confDate = document.getElementById('confirmation_date');
			const datesMes = Array.from(form.querySelectorAll('.date-mes'));
			const saisiesDates = Array.from(form.querySelectorAll('#dates-manuelles input'));
			saisiesDates.forEach(i => { i.dataset.initiale = i.value; });
			let disponible = null;
			let minuterie = null;
			let requete = 0;

			function afficher(classe, texte) {
				statut.className = 'form-text ' + classe;
				statut.textContent = texte;
			}
			const referenceChangee = () => reference.value.trim() !== reference.dataset.actuelle;
			const dateChangee = () => date.value !== date.dataset.actuelle;

			function verifier() {
				const numero = ++requete;
				afficher('text-muted', 'Vérification…');
				fetch('/admin/acquisitions/reference-facture-disponible?' + new URLSearchParams({
					id: form.dataset.acquisitionId, reference: reference.value.trim()
				}), { headers: { 'Accept': 'application/json' }, credentials: 'same-origin' })
					.then(r => { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })
					.then(data => {
						if (numero !== requete) return;
						disponible = !!data.disponible;
						afficher(disponible ? 'text-success' : 'text-danger', (disponible ? '✔ ' : '✖ ') + data.message);
					})
					.catch(() => {
						if (numero !== requete) return;
						disponible = null;
						afficher('text-danger', 'Vérification impossible, réessayez.');
					});
			}
			function surReference() {
				clearTimeout(minuterie);
				reference.classList.remove('is-invalid');
				disponible = null;
				blocReference.classList.toggle('d-none', !referenceChangee());
				if (!referenceChangee()) { requete++; afficher('', ''); return; }
				minuterie = setTimeout(verifier, 300);
			}
			function surDate() {
				const change = dateChangee();
				blocDate.classList.toggle('d-none', !change);
				// Dates réinterrogées : actives (envoyées) seulement si la date change.
				saisiesDates.forEach(i => { i.disabled = !change; });
				datesMes.forEach(i => { i.min = change ? date.value : ''; });
			}
			function reinitialiser() {
				clearTimeout(minuterie);
				requete++;
				reference.value = reference.dataset.actuelle;
				date.value = date.dataset.actuelle;
				confReference.value = '';
				confDate.value = '';
				saisiesDates.forEach(i => { i.value = i.dataset.initiale; i.classList.remove('is-invalid'); });
				[confReference, confDate].forEach(c => c.classList.remove('is-invalid'));
				afficher('', '');
				surReference();
				surDate();
			}

			bouton.addEventListener('click', function () {
				const ouvrir = carte.classList.contains('d-none');
				if (!ouvrir) reinitialiser();
				carte.classList.toggle('d-none', !ouvrir);
				bouton.setAttribute('aria-pressed', ouvrir ? 'true' : 'false');
				bouton.querySelector('span').textContent = ouvrir
					? 'Annuler la modification de la référence et de la date'
					: 'Modifier la référence et la date';
				if (ouvrir) reference.focus();
			});
			reference.addEventListener('input', surReference);
			date.addEventListener('input', surDate);
			date.addEventListener('change', surDate);
			[confReference, confDate, ...saisiesDates].forEach(c => c.addEventListener('input', () => c.classList.remove('is-invalid')));
			surDate();

			form.addEventListener('submit', function (e) {
				function bloquer(champ, message) {
					e.preventDefault();
					if (message) afficher('text-danger', message);
					champ.classList.add('is-invalid');
					champ.focus();
				}
				if (referenceChangee()) {
					if (disponible !== true) {
						return bloquer(reference, disponible === false
							? '✖ Choisissez une référence disponible.'
							: 'Vérification de la référence en cours, réessayez dans un instant.');
					}
					if (confReference.value.trim() !== confReference.dataset.mot) return bloquer(confReference);
				}
				if (dateChangee()) {
					const tropTot = datesMes.find(i => i.value !== '' && i.value < date.value);
					if (tropTot) return bloquer(tropTot);
					if (confDate.value.trim() !== confDate.dataset.mot) return bloquer(confDate);
				}
			});
		})();
	</script>
	{% endif %}
{% endblock %}