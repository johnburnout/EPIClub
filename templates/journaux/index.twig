{# templates/journaux/index.twig #}

{% extends "_layout.twig" %}

{% block body %}
	<h3>📋 {{ 'Journaux de contrôle'|trans }}</h3>
    <hr>

    <!-- Filtres + Tri + Limite -->
    <form method="get" class="mb-3">
        <div class="row g-3">
            <div class="col-md-3">
                <label for="controleur" class="form-label">{{ 'Contrôleur'|trans }}</label>
                <select name="controleur" id="controleur" class="form-select">
                    <option value="">{{ 'Tous'|trans }}</option>
                    {% for controleur in controleurs|tri_alpha(['prenom', 'nom']) %}
                    <option value="{{ controleur.id }}" {% if filtres.controleur_id == controleur.id %}selected{% endif %}>
                        {{ controleur.prenom }} {{ controleur.nom }}
                    </option>
                    {% endfor %}
                </select>
            </div>
            
            <div class="col-md-2">
                <label for="annee" class="form-label">{{ 'Année'|trans }}</label>
                <select name="annee" id="annee" class="form-select">
                    <option value="">{{ 'Toutes'|trans }}</option>
                    {% for annee in annees %}
                    <option value="{{ annee }}" {% if filtres.annee == annee %}selected{% endif %}>
                        {{ annee }}
                    </option>
                    {% endfor %}
                </select>
            </div>
            
            <div class="col-md-2">
                <label for="order_by" class="form-label">{{ 'Trier par'|trans }}</label>
                <select name="order_by" id="order_by" class="form-select">
                    <option value="date_debut" {% if filtres.order_by == 'date_debut' %}selected{% endif %}>{{ 'Date de début'|trans }}</option>
                    <option value="date_fin" {% if filtres.order_by == 'date_fin' %}selected{% endif %}>{{ 'Date de fin'|trans }}</option>
                    <option value="controleur" {% if filtres.order_by == 'controleur' %}selected{% endif %}>{{ 'Contrôleur'|trans }}</option>
                </select>
            </div>
            
            <div class="col-md-2">
                <label for="order_dir" class="form-label">{{ 'Ordre'|trans }}</label>
                <select name="order_dir" id="order_dir" class="form-select">
                    <option value="asc" {% if filtres.order_dir == 'asc' %}selected{% endif %}>{{ 'Croissant'|trans }}</option>
                    <option value="desc" {% if filtres.order_dir == 'desc' %}selected{% endif %}>{{ 'Décroissant'|trans }}</option>
                </select>
            </div>
            
            {% if pagination.total > 10 %}
            <div class="col-md-2">
                <label for="limit" class="form-label">{{ 'Lignes par page'|trans }}</label>
                <select name="limit" id="limit" class="form-select" data-auto-submit>
                    <option value="10" {% if filtres.limit == 10 %}selected{% endif %}>10</option>
                    <option value="25" {% if filtres.limit == 25 %}selected{% endif %}>25</option>
                    <option value="50" {% if filtres.limit == 50 %}selected{% endif %}>50</option>
                    <option value="100" {% if filtres.limit == 100 %}selected{% endif %}>100</option>
                </select>
            </div>
            {% endif %}
            
            <div class="col-md-1 d-flex align-items-end">
                <button type="submit" class="btn btn-secondary w-100">{{ 'Filtrer'|trans }}</button>
            </div>
        </div>
    </form>

    <hr>

    <table class="table table-striped">
		<thead>
			<tr>
				<th>{{ 'ID'|trans }}</th>
				<th>{{ 'Contrôleur'|trans }}</th>
				<th>{{ 'Date début'|trans }}</th>
				<th>{{ 'Date fin'|trans }}</th>
				<th>{{ 'Équipements'|trans }}</th>
				<th>{{ 'Remarques'|trans }}</th>
				<th>{{ 'Actions'|trans }}</th>
			</tr>
		</thead>
        <tbody>
            {% for controle in journaux %}
                <tr>
                    <td>#{{ controle.id }}</td>
                    <td>{{ controle.controleur_prenom }} {{ controle.controleur_nom }}</td>
                    <td>{{ controle.date_debut|date("d/m/Y H:i") }}</td>
                    <td>
                        {% if controle.date_fin %}
                            {{ controle.date_fin|date("d/m/Y H:i") }}
                        {% else %}
                            <span class="text-muted">-</span>
                        {% endif %}
                    </td>
                    <td>
                        <span class="badge bg-info">{{ controle.nb_equipements }}</span>
                    </td>
                    <td>
                        {% if controle.hash_remarques %}
                            <span class="badge bg-warning text-dark">{{ 'Avec remarques'|trans }}</span>
                        {% else %}
                            <span class="text-muted">-</span>
                        {% endif %}
                    </td>
                    <td>
                        <a href="/journaux/{{ controle.id }}" class="btn btn-sm btn-primary">{{ 'Voir'|trans }}</a>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="7" class="text-center text-muted py-4">
                        <i>{{ 'Aucun journal de contrôle disponible'|trans }}</i>
                    </td>
                </tr>
            {% endfor %}
        </tbody>
	</table>

    <!-- Pagination -->
    {% if pagination.total > 10 %}
    <div class="row mt-3">
        <div class="col-md-12">
            <nav aria-label="{{ 'Pagination'|trans }}">
                <ul class="pagination">
                    {% if pagination.hasPrevious %}
                    <li class="page-item"><a class="page-link" href="{{ paginationUrls.first }}">{{ 'Premier'|trans }}</a></li>
                    <li class="page-item"><a class="page-link" href="{{ paginationUrls.previous }}">{{ 'Précédent'|trans }}</a></li>
                    {% else %}
                    <li class="page-item disabled"><span class="page-link">{{ 'Premier'|trans }}</span></li>
                    <li class="page-item disabled"><span class="page-link">{{ 'Précédent'|trans }}</span></li>
                    {% endif %}
                    
                    <li class="page-item disabled"><span class="page-link">{{ 'Page {page} sur {totalPages}'|trans({page: pagination.page, totalPages: pagination.totalPages}) }}</span></li>
                    
                    {% if pagination.hasNext %}
                    <li class="page-item"><a class="page-link" href="{{ paginationUrls.next }}">{{ 'Suivant'|trans }}</a></li>
                    <li class="page-item"><a class="page-link" href="{{ paginationUrls.last }}">{{ 'Dernier'|trans }}</a></li>
                    {% else %}
                    <li class="page-item disabled"><span class="page-link">{{ 'Suivant'|trans }}</span></li>
                    <li class="page-item disabled"><span class="page-link">{{ 'Dernier'|trans }}</span></li>
                    {% endif %}
                </ul>
            </nav>
            <p class="text-muted">{{ 'Affichage de {journaux} journaux sur {total} (page {page}/{totalPages})'|trans({journaux: (journaux|length), total: pagination.total, page: pagination.page, totalPages: pagination.totalPages}) }}</p>
        </div>
    </div>
    {% endif %}
{% endblock %}