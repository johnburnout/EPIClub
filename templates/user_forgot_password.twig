{% extends "_layout.twig" %}

{% block body %}
<h3>{{ 'Mot de passe oublié'|trans }}</h3>
<hr>

<form method="post" id="forgotPasswordForm">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
    <input type="hidden" name="submit_token" value="{{ submit_token }}">

    <div class="mb-3">
        <label for="email">{{ 'Adresse email'|trans }}</label>
        <input type="email" class="form-control {% if form_errors.email %}is-invalid{% endif %}" 
               name="email" id="email" value="{{ email }}" required>
        {% if form_errors.email %}
            <div class="invalid-feedback">{{ form_errors.email }}</div>
        {% endif %}
    </div>

    <button type="submit" id="submitBtn" class="btn btn-primary">{{ 'Envoyer le lien'|trans }}</button>
</form>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script nonce="{{ csp_nonce }}">
        document.addEventListener('DOMContentLoaded', function() {
            const form = document.getElementById('forgotPasswordForm');
            const btn = document.getElementById('submitBtn');

            if (form && btn) {
                form.addEventListener('submit', function() {
                    // Désactiver le bouton et changer le texte
                    btn.disabled = true;
                    btn.textContent = {{ 'Envoi en cours...'|trans|json_encode|raw }};
                });
            }
        });
    </script>
{% endblock %}