{% extends "_layout.twig" %}

{% block body %}
<h3>Mot de passe oublié</h3>
<hr>

<form method="post" id="forgotPasswordForm">
    <input type="hidden" name="submit_token" value="{{ submit_token }}">

    <div class="mb-3">
        <label for="email">Adresse email</label>
        <input type="email" class="form-control {% if form_errors.email %}is-invalid{% endif %}" 
               name="email" id="email" value="{{ email }}" required>
        {% if form_errors.email %}
            <div class="invalid-feedback">{{ form_errors.email }}</div>
        {% endif %}
    </div>

    <button type="submit" id="submitBtn" class="btn btn-primary">Envoyer le lien</button>
</form>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const form = document.getElementById('forgotPasswordForm');
            const btn = document.getElementById('submitBtn');

            if (form && btn) {
                form.addEventListener('submit', function() {
                    // Désactiver le bouton et changer le texte
                    btn.disabled = true;
                    btn.innerHTML = 'Envoi en cours...';
                });
            }
        });
    </script>
{% endblock %}