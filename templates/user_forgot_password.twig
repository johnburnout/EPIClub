{% extends "_layout.twig" %}

{% block body %}
<h3>Mot de passe oublié</h3>
<hr>

<form method="post">
    <input type="hidden" name="submit_token" value="{{ submit_token }}">

    <div class="mb-3">
        <label for="email">Adresse email</label>
        <input type="email" class="form-control {% if form_errors.email %}is-invalid{% endif %}" 
               name="email" id="email" value="{{ email }}" required>
        {% if form_errors.email %}
            <div class="invalid-feedback">{{ form_errors.email }}</div>
        {% endif %}
    </div>

    <button type="submit" id="submitBtn" class="btn btn-primary" 
        onclick="this.disabled=true; this.innerHTML='Envoi en cours...'; this.form.submit();">
        Envoyer le lien
    </button>
</form>
{% endblock %}