{% extends "_layout.twig" %}

{% block body %}
	<h3>{{ 'Fournisseurs'|trans }}</h3>
	<hr>
	{% if isGranted('ROLE_ADMIN') %}
	<a href="/admin/fournisseurs/nouveau" class="btn btn-primary">{{ 'Nouveau'|trans }}</a>
	<hr>
	{% endif %}
	{% include '_filtres_referentiel.twig' with {
		url: '/admin/fournisseurs', placeholder: 'Nom, email, téléphone'|trans,
		tris: {'nom': 'Nom', 'equipements': 'Nombre d\'équipements'},
		affiches: nb_filtres, element: 'fournisseur'|trans, elements: 'fournisseurs'|trans
	} %}
	{% if fournisseurs %}
		<table class="table">
			<thead>
				<tr>
					<th>{{ 'Nom'|trans }}</th>
					<th>{{ 'Adresse mail'|trans }}</th>
					<th>{{ 'Téléphone'|trans }}</th>
					<th>{{ 'Équipements'|trans }}</th>
					<th></th>
				</tr>
			</thead>
			<tbody>
				{% for fournisseur in fournisseurs %}
					<tr>
						<td>{{ fournisseur.nom }}</td>
						<td>{{ fournisseur.email }}</td>
						<td>{{ fournisseur.phone }}</td>
						<td>
							{% set nb = nb_equipements[fournisseur.id]|default(0) %}
						{% if nb > 0 %}
							<a href="/equipements?fournisseur={{ fournisseur.id }}" title="{{ 'Afficher ces équipements'|trans }}">{% if nb > 1 %}{{ '{nb} équipements'|trans({nb: nb}) }}{% else %}{{ '{nb} équipement'|trans({nb: nb}) }}{% endif %}</a>
						{% else %}
							<span class="text-muted">{{ 'Aucun'|trans }}</span>
						{% endif %}
						</td>
						<td>
							<a href="/admin/fournisseurs/fournisseur-{{ fournisseur.id }}" class="btn btn-primary btn-block">{{ 'Voir'|trans }}</a>
							{% if isGranted('ROLE_ADMIN') %}
							<a href="/admin/fournisseurs/fournisseur_modification-{{ fournisseur.id }}" class="btn btn-primary btn-block">{{ 'Editer'|trans }}</a>
							<form method="post" action="/admin/fournisseurs/supprimer" style="display:inline;">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
								<input type="hidden" name="id" value="{{ fournisseur.id }}">
								<button type="submit" class="btn btn-danger btn-block"
								        data-confirm="{{ 'Êtes-vous sûr de vouloir supprimer le fournisseur « {nom} » ?'|trans({nom: fournisseur.nom}) }}">
									{{ 'Supprimer'|trans }}
								</button>
							</form>
							{% endif %}
						</td>
					</tr>
				{% endfor %}
			</tbody>
		</table>
		{% include '_pagination.twig' with {p: pagination, affiches: fournisseurs|length, elements: 'fournisseurs'|trans} %}
	{% else %}
		<p>{{ 'Aucun fournisseur trouvé!'|trans }}</p>
	{% endif %}
{% endblock %}