{% extends "_layout.twig" %}

{% block body %}
	<h3>Fournisseurs</h3>
	<hr>
	{% if isGranted('ROLE_ADMIN') %}
	<a href="/admin/fournisseurs/nouveau" class="btn btn-primary">Nouveau</a>
	<hr>
	{% endif %}
	{% include '_filtres_referentiel.twig' with {
		url: '/admin/fournisseurs', placeholder: 'Nom, email, téléphone',
		tris: {'nom': 'Nom', 'equipements': 'Nombre d\'équipements'},
		affiches: nb_filtres, element: 'fournisseur', elements: 'fournisseurs'
	} %}
	{% if fournisseurs %}
		<table class="table">
			<thead>
				<tr>
					<th>Nom</th>
					<th>Adresse mail</th>
					<th>Téléphone</th>
					<th>Équipements</th>
					<th></th>
				</tr>
			</thead>
			<tbody>
				{% for fournisseur in fournisseurs %}
					<tr>
						<td>{{ fournisseur.nom }}</td>
						<td>{{ fournisseur.email }}</td>
						<td>{{ fournisseur.phone }}</td>
						<td>
							{% set nb = nb_equipements[fournisseur.id]|default(0) %}
						{% if nb > 0 %}
							<a href="/equipements?fournisseur={{ fournisseur.id }}" title="Afficher ces équipements">{{ nb }} équipement{{ nb > 1 ? 's' : '' }}</a>
						{% else %}
							<span class="text-muted">Aucun</span>
						{% endif %}
						</td>
						<td>
							<a href="/admin/fournisseurs/fournisseur-{{ fournisseur.id }}" class="btn btn-primary btn-block">Voir</a>
							{% if isGranted('ROLE_ADMIN') %}
							<a href="/admin/fournisseurs/fournisseur_modification-{{ fournisseur.id }}" class="btn btn-primary btn-block">Editer</a>
							<form method="post" action="/admin/fournisseurs/supprimer" style="display:inline;">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
								<input type="hidden" name="id" value="{{ fournisseur.id }}">
								<button type="submit" class="btn btn-danger btn-block"
								        onclick="return confirm('Êtes-vous sûr de vouloir supprimer le fournisseur « {{ fournisseur.nom }} » ?')">
									Supprimer
								</button>
							</form>
							{% endif %}
						</td>
					</tr>
				{% endfor %}
			</tbody>
		</table>
		{% include '_pagination.twig' with {p: pagination, affiches: fournisseurs|length, elements: 'fournisseurs'} %}
	{% else %}
		<p>Aucun fournisseur trouvé!</p>
	{% endif %}
{% endblock %}