{% extends "_layout.twig" %}

{% block body %}

	{# Détection du mode : création (pas d'ID) ou modification (ID présent) #}
	{% set is_edit_mode = utilisateur.id is defined and utilisateur.id %}
	{% set is_self_edit = is_self is defined and is_self %}

	<h3>{% if is_edit_mode %}Modifier l'utilisateur{% else %}Créer un nouvel utilisateur{% endif %}</h3>
	<hr>

	<form method="post">
		<div class="mb-3">
			<label for="nom">Nom * :</label>
			<input type="text" id="nom" name="nom" value="{{ utilisateur.nom }}" class="form-control {% if form_errors.nom %}is-invalid{% endif %}">
			{% if form_errors.nom %}<div class="invalid-feedback">{{ form_errors.nom }}</div>{% endif %}
		</div>

		<div class="mb-3">
			<label for="prenom">Prénom * :</label>
			<input type="text" id="prenom" name="prenom" value="{{ utilisateur.prenom }}" class="form-control {% if form_errors.prenom %}is-invalid{% endif %}">
			{% if form_errors.prenom %}<div class="invalid-feedback">{{ form_errors.prenom }}</div>{% endif %}
		</div>

		<div class="mb-3">
			<label for="username">Pseudo * :</label>
			<input type="text" id="username" name="username" value="{{ utilisateur.username }}" class="form-control {% if form_errors.username %}is-invalid{% endif %}">
			{% if form_errors.username %}<div class="invalid-feedback">{{ form_errors.username }}</div>{% endif %}
		</div>

		<div class="mb-3">
			<label for="email">Adresse mail * :</label>
			<input type="email" id="email" name="email" value="{{ utilisateur.email }}" class="form-control {% if form_errors.email %}is-invalid{% endif %}">
			{% if form_errors.email %}<div class="invalid-feedback">{{ form_errors.email }}</div>{% endif %}
		</div>

		<div class="mb-3">
			<label for="password">{% if is_edit_mode %}Nouveau mot de passe{% else %}Mot de passe *{% endif %} :</label>
			<input type="password" id="password" name="password" class="form-control {% if form_errors.password %}is-invalid{% endif %}">
			<small class="form-text text-muted">
				{% if is_edit_mode %}
					Laisser vide pour conserver le mot de passe actuel.
				{% else %}
					Le mot de passe est obligatoire pour un nouvel utilisateur.
				{% endif %}
			</small>
			{% if form_errors.password %}<div class="invalid-feedback">{{ form_errors.password }}</div>{% endif %}
		</div>

		<div class="mb-3">
			<label for="role">Rôle * :</label>

			{% if is_self_edit %}
				{# Un utilisateur ne peut pas modifier son propre rôle via ce formulaire.
				   Le contrôleur l'ignore de toute façon, mais on désactive le champ
				   côté interface pour éviter toute confusion. #}
				<select id="role" class="form-control" disabled>
					{% for role, label in roles %}
						<option value="{{ role }}" {% if utilisateur.role == role %} selected {% endif %}>{{ label }}</option>
					{% endfor %}
				</select>
				<input type="hidden" name="role" value="{{ utilisateur.role }}">
				<small class="form-text text-muted">
					Vous ne pouvez pas modifier votre propre rôle. Demandez à un autre administrateur.
				</small>
			{% else %}
				<select name="role" id="role" class="form-control {% if form_errors.role %}is-invalid{% endif %}">
					{% for role, label in roles %}
						<option value="{{ role }}" {% if utilisateur.role == role %} selected {% endif %}>{{ label }}</option>
					{% endfor %}
				</select>
				{% if form_errors.role %}<div class="invalid-feedback">{{ form_errors.role }}</div>{% endif %}
			{% endif %}
		</div>

		<div class="form-actions">
			<input type="hidden" name="csrf_token" value="{{ csrf_token }}">
			<button type="submit" class="btn btn-primary">
				{% if is_edit_mode %}Enregistrer{% else %}Créer l'utilisateur{% endif %}
			</button>
			<a href="/admin/utilisateurs" class="btn btn-secondary">Annuler</a>
		</div>
	</form>

{% endblock %}