{% extends "_layout.twig" %}

{% block body %}
	<h3>Catégories</h3>
	<hr>
	{% if isGranted('ROLE_ADMIN') %}
	<a href="/admin/categories/nouvelle" class="btn btn-primary">Saisir une entrée</a>
	<hr>
	{% endif %}
	{% include '_filtres_referentiel.twig' with {
		url: '/admin/categories', placeholder: 'Libellé, code, description',
		tris: {'libelle': 'Libellé', 'code': 'Code', 'equipements': 'Nombre d\'équipements'},
		selects: [
			{nom: 'epi', label: 'EPI', options: {'': 'Toutes', 'oui': 'EPI', 'non': 'Non EPI'}},
			{nom: 'duree_max', label: 'Durée max', options: {'': 'Toutes', 'oui': 'Oui', 'non': 'Non'}}
		],
		affiches: nb_filtres, element: 'catégorie', elements: 'catégories'
	} %}
	<table class="table">
		<thead>
			<tr>
				<th>Libellé</th>
				<th>Code</th>
				<th>Description</th>
				<th>Est EPI ?</th>
				<th>Durée max ?</th>
				<th>Équipements</th>
				<th>Actions</th>
			</tr>
		</thead>
		<tbody>
			{% for categorie in categories %}
				{% set est_epi_value = "Oui" %}
				{% if categorie.est_epi == 0 %}
					{% set est_epi_value = "Non" %}
				{% endif %}

				<tr>
					<td>{{ categorie.libelle }}</td>
					<td>{% if categorie.code %}<code>{{ categorie.code }}</code>{% endif %}</td>
					<td>{{ categorie.description }}</td>
					<td>{{ est_epi_value }}</td>
					<td>{{ categorie.duree_max_utilisation ? 'Oui' : 'Non' }}</td>
					<td>
						{% set nb = nb_equipements[categorie.id]|default(0) %}
						{% if nb > 0 %}
							<a href="/equipements?categorie={{ categorie.id }}" title="Afficher ces équipements">{{ nb }} équipement{{ nb > 1 ? 's' : '' }}</a>
						{% else %}
							<span class="text-muted">Aucun</span>
						{% endif %}
					</td>
					<td>
						<a href="/admin/categories/categorie-{{ categorie.id }}" class="btn btn-primary btn-sm">Voir</a>
						{% if isGranted('ROLE_ADMIN') %}
						<a href="/admin/categories/categorie_modification-{{ categorie.id }}" class="btn btn-warning btn-sm">Modifier</a>
						<form method="post" action="/admin/categories/supprimer" style="display:inline;">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
							<input type="hidden" name="id" value="{{ categorie.id }}">
							<button type="submit" class="btn btn-danger btn-sm"
							        onclick="return confirm('Êtes-vous sûr de vouloir supprimer la catégorie « {{ categorie.libelle }} » ? Cette action est irréversible.')">
								Supprimer
							</button>
						</form>
						{% endif %}
					</td>
				</tr>
			{% else %}
				<tr><td colspan="7" class="text-muted">Aucune catégorie ne correspond à ces critères.</td></tr>
			{% endfor %}
		</tbody>
	</table>
	{% include '_pagination.twig' with {p: pagination, affiches: categories|length, elements: 'catégories'} %}
{% endblock %}