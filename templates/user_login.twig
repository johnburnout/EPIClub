<!DOCTYPE html>
<html lang="{{ langue() }}">

	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>Epiclub</title>
		<link rel="shortcut icon" href="/assets/img/favicon.ico" type="image/x-icon">
		<link rel="stylesheet" type="text/css" href="/assets/css/cosmo.min.css">
	</head>

	<body>
		<header class="container mt-3">
			<div class="text-center">
				<hr>
				<img src="/assets/img/EPIClub.png" class="" width="64" alt="Logo EPIClub">
				<span class="h1 text-primary align-middle ps-3">
					<strong>{{ 'Gestionnaire EPI'|trans }}</strong>
				</span>
				<hr>
			</div>
			<div class="d-flex justify-content-end">
				{% include '_selecteur_langue.twig' with {classe_bouton: 'btn-outline-primary btn-sm'} %}
			</div>
		</header>
		<main class="container mt-2">
			{% for label, messages in session.getFlashBag.all %}
				{% for message in messages %}
					<div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
						{{ message }}
						<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="{{ 'Fermer'|trans }}"></button>
					</div>
				{% endfor %}
			{% endfor %}
			<h3>{{ 'Identification'|trans }}</h3>
			<hr>

			{% if null != error_autentification %}
				<div class="error">{{ error_autentification }}</div>
			{% endif %}

			<form method="post">
				<div class="mb-3">
					<label for="username">{{ 'Identifiant ou email :'|trans }}</label>
					<input type="text" class="form-control {% if form_errors.username %} is-invalid{% endif %}" id="username" name="username" required autofocus autocomplete="username">
					{% if form_errors.username %}
						<div class="invalid-feedback">{{ form_errors.username }}</div>
					{% endif %}
				</div>
				<div class="mb-3">
					<label for="password">{{ 'Mot de passe :'|trans }}</label>
					<input type="password" class="form-control {% if form_errors.password %} is-invalid{% endif %}" id="password" name="password" required>
					{% if form_errors.password %}
						<div class="invalid-feedback">{{ form_errors.password }}</div>
					{% endif %}
				</div>
				<div class="mb-3">
					<input type="hidden" name="csrf_token" value="{{ csrf_token }}"/>
					<button type="submit" class="btn btn-primary">{{ 'Me connecter'|trans }}</button>
					<a href="/mot_de_passe_oublie">{{ 'Mot de passe oublié ?'|trans }}</a>
				</div>
			</form>

			{# [migration 020] Connexion sans mot de passe (passkey enregistrée
			   depuis « Sécurité du compte »). Masqué si le navigateur ne gère
			   pas WebAuthn. #}
			<div id="passkey-connexion" class="mb-3" hidden>
				<hr>
				<button type="button" class="btn btn-outline-primary" id="passkey-bouton"
				        data-csrf="{{ csrf_token }}" data-redirect="{{ redirect|default('') }}">
					🔑 {{ 'Se connecter avec une passkey'|trans }}
				</button>
				<div class="text-danger mt-2" id="passkey-erreur" role="alert"></div>
			</div>
			<script src="/assets/js/passkey.js"></script>
			<script nonce="{{ csp_nonce }}">
				{% include '_passkey_textes.twig' %}
				EpiclubPasskey.initConnexion(document.getElementById('passkey-connexion'));
			</script>
		</main>
		<footer class="container">
			<hr>
			<p class="text-center text-body-secondary">
				<a href="https://epiclub.fr">Epiclub {{ app_version }}</a>
			</p>
		</footer>
		<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
	</body>
</html>
