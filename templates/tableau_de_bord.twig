{% extends "_layout.twig" %}

{% block body %}
	<div class="row g-3 mt-1">
		{# ============================================================ #}
		{# Bandeau vertical : club, notification, accès rapides          #}
		{# ============================================================ #}
		<aside class="col-lg-3 col-md-4">
			<div class="card h-100">
				<div class="card-body d-flex flex-column gap-3">
					<div class="text-center">
						<img src="{{ logo_url }}" alt="{{ 'Logo {nom}'|trans({nom: (club.nom|default('du club'))}) }}"
						     class="img-fluid mb-2" style="max-height: 140px; object-fit: contain;">
						<h4 class="mb-0 text-primary">{{ club.nom|default('Mon club'|trans) }}</h4>
						{% if club.activite is not empty %}
							<div class="small text-body-secondary">{{ club.activite }}</div>
						{% endif %}
					</div>

					{% if alerte %}
						<div id="alerte-renouvellement" class="alert alert-warning alert-dismissible mb-0 position-relative" role="alert">
							<a href="{{ alerte.url }}" class="alert-link text-decoration-none d-block"
							   title="{{ 'Afficher la liste des équipements par date de fin croissante'|trans }}">
								⚠️ <strong>{{ '{total} EPI à renouveler'|trans({total: alerte.total}) }}</strong>
								{% if alerte.mois > 1 %}
									{{ 'dans les {mois} prochains mois'|trans({mois: alerte.mois}) }}
								{% else %}
									{{ 'dans le mois à venir'|trans }}
								{% endif %}
								<span class="d-block small fw-normal">
									{{ '(avant le {date_limite}'|trans({date_limite: (alerte.date_limite|date('d/m/Y'))}) }}{% if alerte.echus > 0 %}{% if alerte.echus > 1 %}{{ ', dont {echus} déjà échus'|trans({echus: alerte.echus}) }}{% else %}{{ ', dont {echus} déjà échu'|trans({echus: alerte.echus}) }}{% endif %}{% endif %})
								</span>
								<span class="d-block small mt-1">{{ 'Voir la liste →'|trans }}</span>
							</a>
							<form method="post" action="/tableau_de_bord/masquer-alerte" id="form-masquer-alerte" class="m-0">
								<input type="hidden" name="csrf_token" value="{{ csrf_token }}">
								<button type="submit" class="btn-close" aria-label="{{ 'Fermer la notification'|trans }}"
								        title="{{ "Masquer jusqu'à la prochaine connexion"|trans }}"></button>
							</form>
						</div>
					{% endif %}

					{# [migration 019] EPI non vérifiés depuis plus de 6 mois #}
					{% if alerte_controle|default(null) %}
						<div id="alerte-controle" class="alert alert-warning mb-0" role="alert">
							<a href="{{ alerte_controle.url }}" class="alert-link text-decoration-none d-block"
							   title="{{ 'Afficher les EPI non vérifiés, du plus ancien contrôle au plus récent'|trans }}">
								🔎 {% if alerte_controle.total > 1 %}{{ '<strong>{total} EPI non vérifiés</strong> depuis plus de {mois} mois'|trans({total: (alerte_controle.total)|e, mois: (alerte_controle.mois)|e})|raw }}{% else %}{{ '<strong>{total} EPI non vérifié</strong> depuis plus de {mois} mois'|trans({total: (alerte_controle.total)|e, mois: (alerte_controle.mois)|e})|raw }}{% endif %}
								<span class="d-block small fw-normal">
									{{ '(dernier contrôle ou mise en service avant le {avant})'|trans({avant: (alerte_controle.avant|date('d/m/Y'))}) }}
								</span>
								<span class="d-block small mt-1">{{ 'Voir la liste →'|trans }}</span>
							</a>
						</div>
					{% endif %}

					{% if prets_en_retard|default(0) > 0 %}
						<div id="alerte-prets-retard" class="alert alert-danger mb-0" role="alert">
							<a href="/prets?retard=1" class="alert-link text-decoration-none d-block"
							   title="{{ 'Afficher les prêts en retard'|trans }}">
								⏰ <strong>{% if prets_en_retard > 1 %}{{ '{nombre} prêts en retard'|trans({nombre: prets_en_retard}) }}{% else %}{{ '{nombre} prêt en retard'|trans({nombre: prets_en_retard}) }}{% endif %}</strong>
								<span class="d-block small fw-normal">{{ 'Date de retour prévue dépassée'|trans }}</span>
								<span class="d-block small mt-1">{{ 'Voir les prêts →'|trans }}</span>
							</a>
						</div>
					{% endif %}

					{# [2026-10-24] Demandes de modification à traiter (administrateurs) #}
					{% if tickets_a_traiter|default([]) is not empty %}
						<div id="alerte-tickets" class="alert alert-info mb-0" role="alert">
							📨 <strong>{% if tickets_a_traiter|length > 1 %}{{ '{nombre} demandes de modification à traiter'|trans({nombre: tickets_a_traiter|length}) }}{% else %}{{ '{nombre} demande de modification à traiter'|trans({nombre: tickets_a_traiter|length}) }}{% endif %}</strong>
							<ul class="list-unstyled small mb-1 mt-1">
								{% for t in tickets_a_traiter|slice(0, 5) %}
									<li class="mb-1">
										{% if t.equipement_reference and not t.equipement_supprime %}
											<a href="/equipements/equipement_modification-{{ t.equipement_id }}" class="alert-link"
											   title="{{ "Formulaire de modification de l'équipement"|trans }}">{{ t.equipement_reference }}</a>
										{% else %}
											{{ t.equipement_reference|default('?') }}
										{% endif %}
										: {{ t.modifications|map(m => libelles_modifications[m.type]|default(m.type))|join(', ') }}
										— <a href="/tickets/ticket-{{ t.id }}" class="alert-link">{{ 'traiter'|trans }}</a>
									</li>
								{% endfor %}
							</ul>
							<a href="/tickets" class="alert-link small">{{ 'Toutes les demandes →'|trans }}</a>
						</div>
					{% endif %}

					{# [2026-10-24] Demandes de l'utilisateur traitées, pas encore consultées #}
					{% for t in tickets_traites|default([]) %}
						<div class="alert {{ t.statut == 'fait' ? 'alert-success' : 'alert-danger' }} mb-0 ticket-traite" role="alert">
							<a href="/tickets/ticket-{{ t.id }}" class="alert-link text-decoration-none d-block">
								{% if t.statut == 'fait' %}✅ {{ 'Votre demande sur <strong>{reference}</strong> a été traitée'|trans({reference: (t.equipement_reference|default('?'))|e})|raw }}{% else %}✖ {{ 'Votre demande sur <strong>{reference}</strong> a été refusée'|trans({reference: (t.equipement_reference|default('?'))|e})|raw }}{% endif %}
								<span class="d-block small mt-1">{{ 'Voir la réponse →'|trans }}</span>
							</a>
						</div>
					{% endfor %}

					<a href="/controles/scanner" class="btn btn-primary w-100 py-2">
						📷 {{ 'Scanner un QR code'|trans }}
					</a>

					{% if isGranted('ROLE_ADMIN') %}
						<a href="/admin/tableau-de-bord" class="small text-body-secondary mt-auto text-center">
							⚙️ {{ 'Personnaliser le tableau de bord'|trans }}
						</a>
					{% endif %}
				</div>
			</div>
		</aside>

		{# ============================================================ #}
		{# Photo de fond                                                  #}
		{# ============================================================ #}
		<section class="col-lg-9 col-md-8">
			<img src="{{ fond_url }}" alt="" class="w-100 h-100 rounded"
			     style="object-fit: cover; min-height: 320px; max-height: 75vh;">
		</section>
	</div>
{% endblock %}

{% block javascripts %}
	{{ parent() }}
	<script nonce="{{ csp_nonce }}">
		// Fermeture de la notification sans rechargement de page (le
		// formulaire reste fonctionnel si JavaScript est désactivé).
		document.addEventListener('DOMContentLoaded', function () {
			const form = document.getElementById('form-masquer-alerte');
			if (!form) {
				return;
			}
			form.addEventListener('submit', function (event) {
				event.preventDefault();
				const alerte = document.getElementById('alerte-renouvellement');
				if (alerte) {
					alerte.remove();
				}
				fetch(form.action, {
					method: 'POST',
					body: new FormData(form),
					headers: { 'X-Requested-With': 'XMLHttpRequest' },
					credentials: 'same-origin'
				}).catch(function () { /* fermeture visuelle conservée */ });
			});
		});
	</script>
{% endblock %}
