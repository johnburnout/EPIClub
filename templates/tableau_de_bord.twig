{% extends "_layout.twig" %}

{% block body %}
	<div class="row g-3 mt-1">
		{# ============================================================ #}
		{# Bandeau vertical : club, notification, accès rapides          #}
		{# ============================================================ #}
		<aside class="col-lg-3 col-md-4">
			<div class="card h-100">
				<div class="card-body d-flex flex-column gap-3">
					<div class="text-center">
						<img src="{{ logo_url }}" alt="Logo {{ club.nom|default('du club') }}"
						     class="img-fluid mb-2" style="max-height: 140px; object-fit: contain;">
						<h4 class="mb-0 text-primary">{{ club.nom|default('Mon club') }}</h4>
						{% if club.activite is not empty %}
							<div class="small text-body-secondary">{{ club.activite }}</div>
						{% endif %}
					</div>

					{% if alerte %}
						<div id="alerte-renouvellement" class="alert alert-warning alert-dismissible mb-0 position-relative" role="alert">
							<a href="{{ alerte.url }}" class="alert-link text-decoration-none d-block"
							   title="Afficher la liste des équipements par date de fin croissante">
								⚠️ <strong>{{ alerte.total }} EPI à renouveler</strong>
								{% if alerte.mois > 1 %}
									dans les {{ alerte.mois }} prochains mois
								{% else %}
									dans le mois à venir
								{% endif %}
								<span class="d-block small fw-normal">
									(avant le {{ alerte.date_limite|date('d/m/Y') }}{% if alerte.echus > 0 %}, dont {{ alerte.echus }} déjà échu{{ alerte.echus > 1 ? 's' : '' }}{% endif %})
								</span>
								<span class="d-block small mt-1">Voir la liste →</span>
							</a>
							<form method="post" action="/tableau_de_bord/masquer-alerte" id="form-masquer-alerte" class="m-0">
								<input type="hidden" name="csrf_token" value="{{ csrf_token }}">
								<button type="submit" class="btn-close" aria-label="Fermer la notification"
								        title="Masquer jusqu'à la prochaine connexion"></button>
							</form>
						</div>
					{% endif %}

					{% if prets_en_retard|default(0) > 0 %}
						<div id="alerte-prets-retard" class="alert alert-danger mb-0" role="alert">
							<a href="/prets?retard=1" class="alert-link text-decoration-none d-block"
							   title="Afficher les prêts en retard">
								⏰ <strong>{{ prets_en_retard }} prêt{{ prets_en_retard > 1 ? 's' : '' }} en retard</strong>
								<span class="d-block small fw-normal">Date de retour prévue dépassée</span>
								<span class="d-block small mt-1">Voir les prêts →</span>
							</a>
						</div>
					{% endif %}

					{# [2026-10-24] Demandes de modification à traiter (administrateurs) #}
					{% if tickets_a_traiter|default([]) is not empty %}
						<div id="alerte-tickets" class="alert alert-info mb-0" role="alert">
							📨 <strong>{{ tickets_a_traiter|length }} demande{{ tickets_a_traiter|length > 1 ? 's' : '' }} de modification à traiter</strong>
							<ul class="list-unstyled small mb-1 mt-1">
								{% for t in tickets_a_traiter|slice(0, 5) %}
									<li class="mb-1">
										{% if t.equipement_reference and not t.equipement_supprime %}
											<a href="/equipements/equipement_modification-{{ t.equipement_id }}" class="alert-link"
											   title="Formulaire de modification de l'équipement">{{ t.equipement_reference }}</a>
										{% else %}
											{{ t.equipement_reference|default('?') }}
										{% endif %}
										: {{ t.modifications|map(m => libelles_modifications[m.type]|default(m.type))|join(', ') }}
										— <a href="/tickets/ticket-{{ t.id }}" class="alert-link">traiter</a>
									</li>
								{% endfor %}
							</ul>
							<a href="/tickets" class="alert-link small">Toutes les demandes →</a>
						</div>
					{% endif %}

					{# [2026-10-24] Demandes de l'utilisateur traitées, pas encore consultées #}
					{% for t in tickets_traites|default([]) %}
						<div class="alert {{ t.statut == 'fait' ? 'alert-success' : 'alert-danger' }} mb-0 ticket-traite" role="alert">
							<a href="/tickets/ticket-{{ t.id }}" class="alert-link text-decoration-none d-block">
								{{ t.statut == 'fait' ? '✅' : '✖' }} Votre demande sur <strong>{{ t.equipement_reference|default('?') }}</strong>
								{{ t.statut == 'fait' ? 'a été traitée' : 'a été refusée' }}
								<span class="d-block small mt-1">Voir la réponse →</span>
							</a>
						</div>
					{% endfor %}

					<a href="/controles/scanner" class="btn btn-primary w-100 py-2">
						📷 Scanner un QR code
					</a>

					{% if isGranted('ROLE_ADMIN') %}
						<a href="/admin/tableau-de-bord" class="small text-body-secondary mt-auto text-center">
							⚙️ Personnaliser le tableau de bord
						</a>
					{% endif %}
				</div>
			</div>
		</aside>

		{# ============================================================ #}
		{# Photo de fond                                                  #}
		{# ============================================================ #}
		<section class="col-lg-9 col-md-8">
			<img src="{{ fond_url }}" alt="" class="w-100 h-100 rounded"
			     style="object-fit: cover; min-height: 320px; max-height: 75vh;">
		</section>
	</div>
{% endblock %}

{% block javascripts %}
	{{ parent() }}
	<script>
		// Fermeture de la notification sans rechargement de page (le
		// formulaire reste fonctionnel si JavaScript est désactivé).
		document.addEventListener('DOMContentLoaded', function () {
			const form = document.getElementById('form-masquer-alerte');
			if (!form) {
				return;
			}
			form.addEventListener('submit', function (event) {
				event.preventDefault();
				const alerte = document.getElementById('alerte-renouvellement');
				if (alerte) {
					alerte.remove();
				}
				fetch(form.action, {
					method: 'POST',
					body: new FormData(form),
					headers: { 'X-Requested-With': 'XMLHttpRequest' },
					credentials: 'same-origin'
				}).catch(function () { /* fermeture visuelle conservée */ });
			});
		});
	</script>
{% endblock %}
