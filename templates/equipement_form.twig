{% extends "_layout.twig" %}

{% block body %}
	<h3>Équipement</h3>
	<hr>
	<a href="/tableau_de_bord" class="btn btn-primary">Tableau de bord</a>
	<hr>

	{# [2026-10-24] Barre au-dessus du formulaire : roue dentée (super-admin) /
	   bouton du lot (admin), puis les cartes « Dissocier » / « Regrouper », pour
	   qu'elles apparaissent sous le bouton (formulaires distincts, hors du formulaire principal). #}
	{# [2026-10-24] Super-administrateur : référence et catégorie verrouillées
	   (champs désactivés ⇒ non envoyés) jusqu'au clic sur la roue dentée ;
	   ouvertes d'emblée au retour du serveur avec une saisie ou une erreur. #}
	{% set ref_cat_modifiable = isGranted('ROLE_SUPER_ADMIN') and equipement.id is defined and equipement.id %}
	{% set ref_cat_ouvert = ref_cat_modifiable and (reference_saisie is not null or categorie_saisie is not null
		or form_errors.reference is defined or form_errors.confirmation_reference is defined
		or form_errors.categorie_libelle is defined or form_errors.confirmation_categorie is defined
		or lot_saisie is not null or form_errors.nombre_initial is defined) %}
	{# [2026-10-24] Dissociation du lot : admin et plus ; un admin
	   l'affiche par son propre bouton, le super-admin par la roue dentée. #}
	{% set ni_actuel = equipement.nombre_initial|default(1) %}
	{% set dissociation_visible = isGranted('ROLE_ADMIN') and equipement.id is defined and equipement.id and ni_actuel > 1 %}
	{# [2026-10-24] Regroupement en lot : admin et plus, s'il existe des
	   équipements identiques (même libellé, catégorie, acquisition). #}
	{% set regroupement = regroupement|default({candidats: [], erreur: null}) %}
	{% set regroupement_visible = isGranted('ROLE_ADMIN') and equipement.id is defined and equipement.id and regroupement.candidats is not empty %}
	{% if (dissociation_visible or regroupement_visible) and not ref_cat_modifiable %}
		{% set libelle_lot = dissociation_visible and regroupement_visible ? 'Dissocier ou regrouper'
			: (dissociation_visible ? 'Dissocier le lot' : 'Regrouper en lot') %}
		<div class="mb-2 text-end">
			<button type="button" class="btn btn-outline-secondary btn-sm" id="afficher-lot"
			        aria-pressed="false" title="{{ libelle_lot }}" data-libelle="{{ libelle_lot }}">
				<i class="fas fa-cog"></i> <span>{{ libelle_lot }}</span>
			</button>
		</div>
	{% endif %}
	{% if ref_cat_modifiable %}
		<div class="mb-2 text-end">
			<button type="button" class="btn btn-outline-secondary btn-sm" id="deverrouiller-ref-cat"
			        aria-pressed="{{ ref_cat_ouvert ? 'true' : 'false' }}" aria-controls="categorie reference"
			        title="Modification de la référence, de la catégorie et du lot">
				<i class="fas fa-cog"></i>
				<span>{{ ref_cat_ouvert ? 'Annuler la modification de la référence, de la catégorie et du lot' : 'Modifier la référence, la catégorie et le lot (dissocier, regrouper)' }}</span>
			</button>
		</div>
	{% endif %}

	{# [2026-10-24] Dissociation du lot : formulaire distinct, affiché par la
	   roue dentée (super-administrateur) ou le bouton « Dissocier le lot » (admin). #}
	{% if dissociation_visible %}
		<div class="card mt-2 mb-3 border-warning carte-lot {% if not ref_cat_ouvert %}d-none{% endif %}" id="carte-dissociation">
			<div class="card-body">
				<h5 class="card-title"><i class="fas fa-object-ungroup"></i> Dissocier le lot</h5>
				{% if dissociation_erreur %}
					<p class="text-muted mb-0">{{ dissociation_erreur }}</p>
				{% else %}
					<form method="post" action="/equipements/equipement_dissocier-{{ equipement.id }}" id="form-dissociation"
					      data-equipement-id="{{ equipement.id }}"
					      data-references-modifiables="{{ references_dissociation_modifiables ? '1' : '0' }}">
						<input type="hidden" name="csrf_token" value="{{ csrf_token }}">
						<p class="small">
							Le lot compte <strong>{{ equipement.nombre }}</strong> élément(s) restant(s). Indiquez la taille de chaque
							partie, séparées par des virgules : la <strong>première</strong> reste à l'équipement
							<strong>{{ equipement.reference }}</strong> (avec son historique), chacune des autres devient un
							<strong>nouvel équipement</strong> (lot ou équipement individuel), avec les mêmes caractéristiques.
							{% if not references_dissociation_modifiables %}
								Leurs références sont attribuées automatiquement selon le modèle de référence.
							{% endif %}
						</p>
						<div class="mb-2">
							<label for="repartition" class="form-label">Répartition</label>
							<div class="input-group">
								<input type="text" class="form-control" name="repartition" id="repartition"
								       placeholder="ex. {{ equipement.nombre > 2 ? (equipement.nombre - 2) ~ ', 1, 1' : '1, 1' }}"
								       autocomplete="off" data-nombre="{{ equipement.nombre }}">
								<button type="button" class="btn btn-outline-secondary" id="repartition-individuels">
									En équipements individuels
								</button>
							</div>
							<div class="form-text" id="repartition-statut" aria-live="polite"></div>
						</div>
						<div id="dissociation-references" class="mb-2"></div>
						<div class="mb-3 p-2 border border-warning rounded">
							<label for="confirmation_dissociation" class="form-label">
								Pour confirmer la dissociation, saisissez <code>{{ mot_confirmation_dissociation }}</code>
							</label>
							<input type="text" class="form-control" name="confirmation_dissociation" id="confirmation_dissociation"
							       autocomplete="off" spellcheck="false" data-mot="{{ mot_confirmation_dissociation }}">
						</div>
						<button type="submit" class="btn btn-warning">Dissocier le lot</button>
					</form>
				{% endif %}
			</div>
		</div>
	{% endif %}

	{# [2026-10-24] Regroupement en lot (admin et plus) : formulaire distinct,
	   affiché avec la carte de dissociation. #}
	{% if regroupement_visible %}
		<div class="card mt-2 mb-3 border-warning carte-lot {% if not ref_cat_ouvert %}d-none{% endif %}" id="carte-regroupement">
			<div class="card-body">
				<h5 class="card-title"><i class="fas fa-object-group"></i> Regrouper en lot</h5>
				{% if regroupement.erreur %}
					<p class="text-muted mb-0">Cet équipement ne peut pas être regroupé ({{ regroupement.erreur }}).</p>
				{% else %}
					<form method="post" action="/equipements/equipement_regrouper-{{ equipement.id }}" id="form-regroupement"
					      data-nombre="{{ equipement.nombre|default(1) }}" data-nombre-initial="{{ ni_actuel }}">
						<input type="hidden" name="csrf_token" value="{{ csrf_token }}">
						<p class="small">
							Équipements identiques (même libellé, même catégorie, même acquisition). Ceux que vous cochez sont
							<strong>associés à {{ equipement.reference }}</strong>, qui garde sa référence, ses dates, son emplacement
							et son historique ; leurs éléments s'ajoutent au lot et ils sont <strong>archivés</strong>
							(leur historique est conservé). Pensez à retirer leurs étiquettes.
						</p>
						<div class="table-responsive">
							<table class="table table-sm align-middle">
								<thead>
									<tr><th></th><th>Référence</th><th>Éléments</th><th>Emplacement</th><th>Mise en service</th><th>Fin d'utilisation</th></tr>
								</thead>
								<tbody>
									{% for c in regroupement.candidats %}
										{% set emplacement_c = emplacements|filter(em => em.id == c.emplacement_id)|first %}
										<tr class="{{ c.erreur_regroupement ? 'text-muted' : '' }}">
											<td>
												<input type="checkbox" class="form-check-input regroupement-choix" name="ids[]" value="{{ c.id }}"
												       id="regrouper_{{ c.id }}" data-nombre="{{ c.nombre|default(1) }}"
												       data-nombre-initial="{{ c.nombre_initial|default(1) }}"
												       {% if c.erreur_regroupement %}disabled{% endif %}>
											</td>
											<td>
												<label for="regrouper_{{ c.id }}">{{ c.reference }}</label>
												{% if c.erreur_regroupement %}<div class="small">Impossible : {{ c.erreur_regroupement }}</div>{% endif %}
											</td>
											<td>{{ c.nombre|default(1) }}{% if c.nombre_initial|default(1) > 1 %} / {{ c.nombre_initial }}{% endif %}</td>
											<td class="{{ c.emplacement_id != equipement.emplacement_id ? 'text-warning' : '' }}">{{ emplacement_c ? emplacement_c.libelle : '—' }}</td>
											<td class="{{ c.date_mise_en_service != equipement.date_mise_en_service ? 'text-warning' : '' }}">{{ c.date_mise_en_service ? c.date_mise_en_service|date('d/m/Y') : '—' }}</td>
											<td class="{{ c.date_fin_utilisation != equipement.date_fin_utilisation ? 'text-warning' : '' }}">{{ c.date_fin_utilisation ? c.date_fin_utilisation|date('d/m/Y') : '—' }}</td>
										</tr>
									{% endfor %}
								</tbody>
							</table>
						</div>
						<p class="small text-muted">En orange : valeur différente de {{ equipement.reference }} (celle de {{ equipement.reference }} est conservée).</p>
						<div class="form-text mb-2" id="regroupement-statut" aria-live="polite"></div>
						<div class="mb-3 p-2 border border-warning rounded">
							<label for="confirmation_regroupement" class="form-label">
								Pour confirmer le regroupement, saisissez <code>{{ mot_confirmation_regroupement }}</code>
							</label>
							<input type="text" class="form-control" name="confirmation_regroupement" id="confirmation_regroupement"
							       autocomplete="off" spellcheck="false" data-mot="{{ mot_confirmation_regroupement }}">
						</div>
						<button type="submit" class="btn btn-warning">Regrouper en lot</button>
					</form>
				{% endif %}
			</div>
		</div>
	{% endif %}

	{# ⬇️ MODIFICATION : ajout de enctype #}
	<form method="post" enctype="multipart/form-data">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
		
		{% set emplacement_seul = emplacement_seul|default(false) %}
		{% if emplacement_seul %}
			<div class="alert alert-info">
				<i class="fas fa-info-circle"></i> En tant que contrôleur, vous pouvez modifier uniquement l'<strong>emplacement</strong> de cet équipement.
			</div>
		{% endif %}

		{# Erreurs générales #}
		{% if form_errors is defined and form_errors %}
			{% for key, message in form_errors %}
				<div class="alert alert-danger">
					<i class="fas fa-exclamation-triangle"></i> {{ message }}
				</div>
			{% endfor %}
		{% endif %}
		
		{# [2026-10-23] Contrôleur : tous les champs sauf l'emplacement sont
		   désactivés (fieldset disabled ⇒ non envoyés ; ignorés côté serveur) #}
		<fieldset {% if emplacement_seul %}disabled{% endif %}>

		<!-- Catégorie : définie à l'acquisition, modifiable par un super-administrateur
		     (saisie comme une ligne d'acquisition, référence proposée + mot de confirmation) -->
		<div class="mb-3">
			<label for="categorie">Catégorie</label>
			{% if isGranted('ROLE_SUPER_ADMIN') and equipement.id is defined and equipement.id %}
				<input type="text" class="form-control {% if form_errors.categorie_libelle is defined %}is-invalid{% endif %}"
				       name="categorie_libelle" id="categorie" list="categories"
				       value="{{ categorie_saisie ?? equipement.categorie.libelle }}"
				       maxlength="{{ categorie_libelle_max }}" required autocomplete="off" {% if not ref_cat_ouvert %}disabled{% endif %}
				       data-equipement-id="{{ equipement.id }}" data-categorie-actuelle="{{ equipement.categorie.libelle }}">
				<datalist id="categories">
					{% for categorie in categories %}
						<option value="{{ categorie.libelle }}">{{ categorie.libelle }}</option>
					{% endfor %}
				</datalist>
				{% if form_errors.categorie_libelle is defined %}
					<div class="invalid-feedback">{{ form_errors.categorie_libelle }}</div>
				{% endif %}
				<div class="form-text" id="categorie-statut" aria-live="polite"></div>
				<small class="text-muted">Définie lors de l'acquisition ; modifiable par un super-administrateur. Une catégorie inconnue est créée.</small>
				<div id="bloc-confirmation-categorie" class="mt-2 p-2 border border-warning rounded {% if categorie_saisie is null and form_errors.confirmation_categorie is not defined %}d-none{% endif %}">
					<div class="small mb-2">
						<i class="fas fa-exclamation-triangle text-warning"></i>
						L'équipement quitte la catégorie <strong>{{ equipement.categorie.libelle }}</strong> ;
						une référence libre dans la nouvelle catégorie est proposée ci-dessous.
					</div>
					<label for="confirmation_categorie" class="form-label">
						Pour confirmer le changement, saisissez <code>{{ mot_confirmation_categorie }}</code>
					</label>
					<input type="text" class="form-control {% if form_errors.confirmation_categorie is defined %}is-invalid{% endif %}"
					       name="confirmation_categorie" id="confirmation_categorie"
					       autocomplete="off" spellcheck="false" data-mot="{{ mot_confirmation_categorie }}">
					{% if form_errors.confirmation_categorie is defined %}
						<div class="invalid-feedback">{{ form_errors.confirmation_categorie }}</div>
					{% endif %}
				</div>
			{% else %}
				<input type="text" class="form-control" id="categorie" value="{{ equipement.categorie.libelle }}" readonly disabled>
				<small class="text-muted">La catégorie est définie lors de l'acquisition.</small>
			{% endif %}
		</div>

		<!-- EPI (lecture seule) -->
		<div class="mb-3">
			<label for="est_epi">EPI</label>
			<input type="text" class="form-control" id="est_epi" 
			       value="{% if equipement.categorie and equipement.categorie.est_epi %}Oui{% else %}Non{% endif %}" 
			       readonly disabled>
			<small class="text-muted">Le statut EPI est défini par la catégorie de l'équipement.</small>
		</div>

		<!-- Référence : définie à l'acquisition, modifiable par un super-administrateur
		     (unicité vérifiée à la volée + mot de confirmation, revérifiés côté serveur) -->
		<div class="mb-3">
			<label for="reference">Référence</label>
			{% if isGranted('ROLE_SUPER_ADMIN') and equipement.id is defined and equipement.id %}
				<input type="text" class="form-control {% if form_errors.reference is defined %}is-invalid{% endif %}"
				       name="reference" id="reference" value="{{ reference_saisie ?? equipement.reference }}"
				       maxlength="{{ reference_max }}" required autocomplete="off" {% if not ref_cat_ouvert %}disabled{% endif %}
				       data-equipement-id="{{ equipement.id }}" data-reference-actuelle="{{ equipement.reference }}">
				{% if form_errors.reference is defined %}
					<div class="invalid-feedback">{{ form_errors.reference }}</div>
				{% endif %}
				<div class="form-text" id="reference-statut" aria-live="polite"></div>
				<small class="text-muted">Définie lors de l'acquisition ; modifiable par un super-administrateur.</small>
				<div id="bloc-confirmation-reference" class="mt-2 p-2 border border-warning rounded {% if reference_saisie is null and form_errors.confirmation_reference is not defined %}d-none{% endif %}">
					<div class="small mb-2">
						<i class="fas fa-exclamation-triangle text-warning"></i>
						Les étiquettes et fiches déjà imprimées portent l'ancienne référence
						<strong>{{ equipement.reference }}</strong> ; le QR code reste valable.
					</div>
					<label for="confirmation_reference" class="form-label">
						Pour confirmer le changement, saisissez <code>{{ mot_confirmation_reference }}</code>
					</label>
					<input type="text" class="form-control {% if form_errors.confirmation_reference is defined %}is-invalid{% endif %}"
					       name="confirmation_reference" id="confirmation_reference"
					       autocomplete="off" spellcheck="false" data-mot="{{ mot_confirmation_reference }}">
					{% if form_errors.confirmation_reference is defined %}
						<div class="invalid-feedback">{{ form_errors.confirmation_reference }}</div>
					{% endif %}
				</div>
			{% else %}
				<input type="text" class="form-control" id="reference" value="{{ equipement.reference }}" readonly disabled>
				<small class="text-muted">La référence est définie lors de l'acquisition.</small>
			{% endif %}
		</div>

		<!-- Libellé : défini à l'acquisition, modifiable par un super-administrateur -->
		<div class="mb-3">
			<label for="libelle">Libellé</label>
			{% if isGranted('ROLE_SUPER_ADMIN') %}
				<input type="text" class="form-control {% if form_errors.libelle is defined %}is-invalid{% endif %}"
				       name="libelle" id="libelle" value="{{ equipement.libelle }}" maxlength="255" required>
				{% if form_errors.libelle is defined %}
					<div class="invalid-feedback">{{ form_errors.libelle }}</div>
				{% endif %}
				<small class="text-muted">Défini lors de l'acquisition ; modifiable par un super-administrateur.</small>
			{% else %}
				<input type="text" class="form-control" id="libelle" value="{{ equipement.libelle }}" readonly disabled>
				<small class="text-muted">Le libellé est défini lors de l'acquisition.</small>
			{% endif %}
		</div>

		<!-- Date d'achat (lecture seule) -->
		<div class="mb-3">
			<label for="date_achat">Date d'achat</label>
			<input type="text" class="form-control" id="date_achat" value="{{ equipement.date_achat ? equipement.date_achat|date('d/m/Y') : 'Non renseignée' }}" readonly disabled>
			<small class="text-muted">La date d'achat est définie lors de l'acquisition.</small>
		</div>

		<!-- Lot : nombre d'éléments (modifiable, plafonné au nombre initial).
		     [2026-10-24] Super-administrateur : lot et nombre initial modifiables
		     après la roue dentée (sans mot de confirmation). -->
		{% set est_lot = lot_saisie is not null ? lot_saisie.lot : ni_actuel > 1 %}
		{% set ni_affiche = lot_saisie is not null ? lot_saisie.nombre_initial : ni_actuel %}
		{% if ref_cat_modifiable %}
			<div class="mb-3">
				<input type="hidden" name="lot" value="0" id="lot_defaut" {% if not ref_cat_ouvert %}disabled{% endif %}>
				<div class="form-check">
					<input type="checkbox" class="form-check-input" name="lot" value="1" id="lot"
					       data-initial="{{ ni_actuel > 1 ? '1' : '0' }}" {% if est_lot %}checked{% endif %} {% if not ref_cat_ouvert %}disabled{% endif %}>
					<label class="form-check-label" for="lot">Lot</label>
				</div>
				<small class="text-muted">Plusieurs éléments identiques sous une même référence. Décocher ramène le nombre initial et le nombre actuel à 1.</small>
			</div>
			<div class="mb-3 {% if not est_lot %}d-none{% endif %}" id="bloc-nombre-initial">
				<label for="nombre_initial">Nombre initial du lot</label>
				<input type="number" class="form-control {% if form_errors.nombre_initial is defined %}is-invalid{% endif %}"
				       id="nombre_initial" name="nombre_initial" min="2" max="{{ lot_max }}"
				       value="{{ ni_affiche }}" data-initial="{{ ni_actuel }}" {% if not ref_cat_ouvert or not est_lot %}disabled{% endif %}>
				{% if form_errors.nombre_initial is defined %}
					<div class="invalid-feedback">{{ form_errors.nombre_initial }}</div>
				{% endif %}
				<small class="text-muted">Nombre d'éléments du lot à la création ; modifiable par un super-administrateur.</small>
			</div>
		{% elseif ni_actuel > 1 %}
			<div class="mb-3">
				<label>Nombre initial du lot</label>
				<input type="text" class="form-control" value="{{ ni_actuel }}" readonly disabled>
				<small class="text-muted">Nombre d'éléments du lot à la création — non modifiable.</small>
			</div>
		{% endif %}
		{% if ni_actuel > 1 or ref_cat_modifiable %}
			<div class="mb-3 {% if not est_lot %}d-none{% endif %}" id="bloc-nombre">
				<label for="nombre">Nombre actuel d'éléments</label>
				<input type="number" class="form-control {% if form_errors.nombre is defined and form_errors.nombre %}is-invalid{% endif %}"
				       id="nombre" name="nombre" min="1" max="{{ est_lot ? (ni_affiche > 1 ? ni_affiche : ni_actuel) : 1 }}"
				       value="{{ equipement.nombre|default(1) }}" data-initial="{{ equipement.nombre|default(1) }}">
				<small class="text-muted">Entre 1 et le nombre initial du lot.</small>
				{% if form_errors.nombre is defined and form_errors.nombre %}
					<div class="invalid-feedback d-block">{{ form_errors.nombre }}</div>
				{% endif %}
			</div>
		{% endif %}

		<!-- Date de mise en service : date de facture, modifiable une seule fois -->
		<div class="mb-3">
			<label for="date_mise_en_service">Date de mise en service</label>
			{% if date_mes_verrouillee %}
				<input type="date" class="form-control" id="date_mise_en_service"
				       value="{{ equipement.date_mise_en_service }}" readonly disabled>
				<small class="text-muted">🔒 Cette date a déjà été modifiée une fois et ne peut plus l'être.</small>
			{% else %}
				<input type="date" class="form-control {% if form_errors.date_mise_en_service is defined %}is-invalid{% endif %}"
				       name="date_mise_en_service" id="date_mise_en_service"
				       value="{{ equipement.date_mise_en_service }}" data-initiale="{{ equipement.date_mise_en_service }}"
				       {% if not isGranted('ROLE_SUPER_ADMIN') %}data-confirmer="1"{% endif %}
				       {% if date_facture %}min="{{ date_facture }}"{% endif %}>
				{% if form_errors.date_mise_en_service is defined %}
					<div class="invalid-feedback">{{ form_errors.date_mise_en_service }}</div>
				{% endif %}
				<small class="text-muted">
					Par défaut, la date de la facture.
					{% if isGranted('ROLE_SUPER_ADMIN') %}
						Super-administrateur : modifiable à tout moment{% if date_facture %}, mais pas avant le {{ date_facture|date('d/m/Y') }}{% endif %}.
					{% else %}
						⚠️ Elle ne peut être modifiée qu'<strong>une seule fois</strong>{% if date_facture %},
						et pas avant le {{ date_facture|date('d/m/Y') }}{% endif %}.
					{% endif %}
				</small>
			{% endif %}
		</div>

		<!-- Durée maximum d'utilisation (héritée de la catégorie, modifiable) -->
		<div class="mb-3 form-check">
			<input type="checkbox" id="duree_max_utilisation" name="duree_max_utilisation" class="form-check-input" {% if equipement.duree_max_utilisation %}checked{% endif %}>
			<label class="form-check-label" for="duree_max_utilisation">Durée maximum d'utilisation</label>
			<small class="form-text text-muted d-block">
				Cocher si le fabricant limite la durée de vie de cet équipement (généralement 10 ans) :
				la date de fin d'utilisation ci-dessous fait alors office de date de péremption.
			</small>
		</div>

		<!-- Élément textile remplaçable (hérité de la catégorie, modifiable) -->
		<div class="mb-3 form-check">
			<input type="checkbox" id="textile_remplacable" name="textile_remplacable" class="form-check-input" {% if equipement.textile_remplacable|default(false) %}checked{% endif %}>
			<label class="form-check-label" for="textile_remplacable">Élément textile remplaçable</label>
			<small class="form-text text-muted d-block">
				Passez l'équipement « En maintenance » pour changer son élément textile : au contrôle suivant, le
				contrôleur indique le remplacement et met le statut à OK ; la date de fin d'utilisation devient
				alors la date du contrôle + 10 ans (fin de mois).
			</small>
		</div>

		<!-- Date de fin d'utilisation (modifiable si vide) -->
		<div class="mb-3">
			<label for="date_fin_utilisation">Date de fin d'utilisation (péremption)</label>
			{% if equipement.date_fin_utilisation %}
				<input type="date" class="form-control" id="date_fin_utilisation" 
				       value="{{ equipement.date_fin_utilisation }}" readonly disabled>
				<small class="text-muted">Cette date est déjà renseignée et ne peut plus être modifiée.</small>
				<input type="hidden" name="date_fin_utilisation" value="{{ equipement.date_fin_utilisation }}">
			{% else %}
				<input type="date" class="form-control" name="date_fin_utilisation" id="date_fin_utilisation">
				<small class="text-muted">Laisser vide si l'équipement est toujours en service.</small>
			{% endif %}
		</div>

		</fieldset>

		<!-- Emplacement (modifiable, y compris par un contrôleur) -->
		<div class="mb-3">
			<label for="emplacement_id">Emplacement</label>
			<select id="emplacement_id" name="emplacement_id" class="form-control">
				<option value="">-- Aucun emplacement --</option>
				{% for emplacement in emplacements %}
					<option value="{{ emplacement.id }}" {% if equipement.emplacement_id == emplacement.id %}selected{% endif %}>
						{{ emplacement.libelle }}
					</option>
				{% endfor %}
			</select>
		</div>

		<fieldset {% if emplacement_seul %}disabled{% endif %}>

		<!-- Statut : les statuts réservés (Hors service, Prêté, Égaré) ne sont attribués / levés que par un contrôle ou un prêt -->
		<div class="mb-3">
			<label for="statut">Statut</label>
			{% set statut_actuel = equipement.statut is defined and equipement.statut is not null ? statut_equipement(equipement.statut) : null %}
			{% if statut_actuel and statut_actuel.reserve %}
			<input type="hidden" name="statut" value="{{ equipement.statut }}">
			<input type="text" class="form-control {% if form_errors.statut is defined %}is-invalid{% endif %}" id="statut" value="{{ statut_actuel.libelle }}" disabled>
			{% if equipement.statut == 3 %}
			<small class="text-muted">Matériel prêté : son statut changera à la vérification du retour du prêt.</small>
			{% else %}
			<small class="text-muted">Statut fixé par un contrôle{% if equipement.statut == 4 %} ou un prêt{% endif %} : seul un nouveau contrôle peut le lever.</small>
			{% endif %}
			{% else %}
			<select class="form-select {% if form_errors.statut is defined %}is-invalid{% endif %}" name="statut" id="statut">
				{% for name, value in equipement_statuts %}
				<option value="{{ value }}" {% if equipement.statut is defined and equipement.statut == value %}selected{% endif %}>{{ name }}</option>
				{% endfor %}
			</select>
			<small class="text-muted">« Hors service » et « Égaré » s'attribuent à l'issue d'un contrôle ; « Prêté » par un prêt.</small>
			{% endif %}
			{% if form_errors.statut is defined %}
			<div class="invalid-feedback d-block">{{ form_errors.statut }}</div>
			{% endif %}
		</div>

		<!-- Remarques (modifiable) -->
		<div class="mb-3">
			<label for="remarques">Remarques</label>
			<textarea class="form-control" name="remarques" id="remarques" rows="3">{{ equipement.remarques }}</textarea>
		</div>

		{# ⬇️ NOUVEAU CHAMP : PHOTO #}
		<div class="mb-3">
			<label for="photo">Photo de l'équipement</label>
			<input type="file" 
				class="form-control {% if form_errors.photo is defined and form_errors.photo %}is-invalid{% endif %}" 
				name="photo" 
				id="photo" 
				accept="image/*">
			{% if form_errors.photo is defined and form_errors.photo %}
				<div class="invalid-feedback d-block">{{ form_errors.photo }}</div>
			{% endif %}

			{# Afficher un aperçu si une photo existe déjà #}
			{% if equipement.photo is defined and equipement.photo is not empty %}
				<div class="mt-2">
					<img src="{{ equipement.photo }}" alt="Photo actuelle" style="max-width: 200px; max-height: 200px;" class="img-thumbnail">
					<p class="text-muted small mt-1">Photo actuelle (remplacée si vous en téléchargez une nouvelle).</p>
				</div>
			{% endif %}
		</div>
		{# ⬆️ FIN DU CHAMP PHOTO #}

		</fieldset>

		<button type="submit" class="btn btn-primary">Enregistrer</button>
		<a href="{% if equipement.id is defined and equipement.id %}/equipements/equipement-{{ equipement.id }}{% else %}/equipements{% endif %}" class="btn btn-secondary">Annuler</a>
	</form>

	<!-- Modal -->
	<div class="modal fade" id="categorieModalForm" tabindex="-1" aria-labelledby="categorieModalFormLabel" aria-hidden="true">
		<div class="modal-dialog">
			<div class="modal-content">
				<div class="modal-header">
					<h1 class="modal-title fs-5" id="categorieModalFormLabel">Nouvelle catégorie</h1>
					<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
				</div>
				<div class="modal-body">
					<form id="add_epi_categorie">
						<div class="mb-3">
							<label for="libelle">Nom</label>
							<input type="text" class="form-control" name="libelle" id="libelle" required>
						</div>
					</form>
				</div>
				<div class="modal-footer">
					<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
					<button type="button" class="btn btn-primary" id="add_category_submit">Save changes</button>
				</div>
			</div>
		</div>
	</div>
{% endblock %}

{% block javascripts %}
	<script>
		// [MÉTIER] Date de mise en service modifiable une seule fois :
		// confirmation avant enregistrement si elle a changé.
		(function () {
			const champ = document.getElementById('date_mise_en_service');
			if (!champ || champ.disabled || !champ.form || champ.dataset.confirmer !== '1') {
				return;
			}
			champ.form.addEventListener('submit', function (e) {
				const initiale = champ.dataset.initiale || '';
				if (champ.value !== '' && champ.value !== initiale
					&& !confirm('La date de mise en service ne pourra plus être modifiée ensuite. Confirmer ?')) {
					e.preventDefault();
				}
			});
		})();
	</script>
	<script>
		/**
		 * [2026-10-23] Changement de référence (super-administrateur) :
		 * unicité vérifiée à la volée ; si la référence change, le mot de
		 * confirmation est exigé avant l'envoi (revérifié côté serveur).
		 */
		(function () {
			const champ = document.getElementById('reference');
			if (!champ || !champ.dataset.referenceActuelle) return;
			const actuelle = champ.dataset.referenceActuelle;
			const statut = document.getElementById('reference-statut');
			const bloc = document.getElementById('bloc-confirmation-reference');
			const confirmation = document.getElementById('confirmation_reference');
			const motAttendu = confirmation.dataset.mot;
			let disponible = null; // null = pas de changement / vérification en cours
			let minuterie = null;
			let requete = 0;

			function afficher(classe, texte) {
				statut.className = 'form-text ' + classe;
				statut.textContent = texte;
			}
			function changee() {
				return champ.value.trim() !== actuelle;
			}
			function verifier() {
				const valeur = champ.value.trim();
				const numero = ++requete;
				afficher('text-muted', 'Vérification…');
				fetch('/equipements/reference-disponible?id=' + encodeURIComponent(champ.dataset.equipementId)
					+ '&reference=' + encodeURIComponent(valeur),
					{ headers: { 'Accept': 'application/json' }, credentials: 'same-origin' })
					.then(r => { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })
					.then(data => {
						if (numero !== requete) return; // réponse obsolète
						disponible = !!data.disponible;
						afficher(disponible ? 'text-success' : 'text-danger', (disponible ? '✔ ' : '✖ ') + data.message);
					})
					.catch(() => {
						if (numero !== requete) return;
						disponible = null;
						afficher('text-danger', 'Vérification impossible, réessayez.');
					});
			}
			function surSaisie() {
				clearTimeout(minuterie);
				disponible = null;
				if (!changee()) {
					requete++;
					bloc.classList.add('d-none');
					afficher('', '');
					return;
				}
				bloc.classList.remove('d-none');
				minuterie = setTimeout(verifier, 300);
			}

			champ.addEventListener('input', surSaisie);
			champ.form.addEventListener('submit', function (e) {
				if (champ.disabled || !changee()) return;
				if (disponible !== true) {
					e.preventDefault();
					afficher('text-danger', disponible === false
						? '✖ Choisissez une référence disponible.'
						: 'Vérification de la référence en cours, réessayez dans un instant.');
					champ.focus();
				} else if (confirmation.value.trim() !== motAttendu) {
					e.preventDefault();
					confirmation.classList.add('is-invalid');
					confirmation.focus();
				}
			});
			confirmation.addEventListener('input', function () {
				confirmation.classList.toggle('is-invalid', false);
			});
			// Retour du serveur avec une référence saisie : relancer la vérification
			if (changee()) { surSaisie(); }
		})();
	</script>
	<script>
		/**
		 * [2026-10-24] Changement de catégorie (super-administrateur) :
		 * une référence libre est proposée pour la catégorie saisie (année
		 * d'achat), sans écraser une référence saisie à la main ; sa
		 * disponibilité est vérifiée par le script de la référence. Le mot
		 * de confirmation est exigé avant l'envoi (revérifié côté serveur).
		 */
		(function () {
			const champ = document.getElementById('categorie');
			if (!champ || !champ.dataset.categorieActuelle) return;
			const actuelle = champ.dataset.categorieActuelle;
			const statut = document.getElementById('categorie-statut');
			const bloc = document.getElementById('bloc-confirmation-categorie');
			const confirmation = document.getElementById('confirmation_categorie');
			const motAttendu = confirmation.dataset.mot;
			const reference = document.getElementById('reference');
			const referenceActuelle = reference ? (reference.dataset.referenceActuelle || '') : '';
			const epi = document.getElementById('est_epi');
			const epiInitial = epi ? epi.value : '';
			let derniereProposition = null;
			let minuterie = null;
			let requete = 0;

			function afficher(classe, texte) {
				statut.className = 'form-text ' + classe;
				statut.textContent = texte;
			}
			function changee() {
				return champ.value.trim() !== actuelle;
			}
			// Remplace la référence seulement si elle n'a pas été saisie à la main.
			function proposerReference(valeur) {
				if (!reference) return;
				const courante = reference.value.trim();
				if (courante !== referenceActuelle && courante !== derniereProposition) return;
				derniereProposition = valeur === referenceActuelle ? null : valeur;
				if (courante !== valeur) {
					reference.value = valeur;
					reference.dispatchEvent(new Event('input'));
				}
			}
			function suggerer() {
				const libelle = champ.value.trim();
				const numero = ++requete;
				afficher('text-muted', 'Recherche d\'une référence libre…');
				fetch('/equipements/reference-suggestion?' + new URLSearchParams({ id: champ.dataset.equipementId, categorie: libelle }),
					{ headers: { 'Accept': 'application/json' }, credentials: 'same-origin' })
					.then(r => { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })
					.then(data => {
						if (numero !== requete) return; // réponse obsolète
						if (epi) epi.value = data.est_epi === false ? 'Non' : 'Oui';
						if (!data.reference) {
							afficher('text-danger', 'Aucune référence proposée pour cette catégorie.');
							return;
						}
						afficher(data.nouvelle ? 'text-warning' : 'text-muted',
							(data.nouvelle ? 'Nouvelle catégorie : elle sera créée à l\'enregistrement. ' : '')
							+ 'Référence proposée (' + data.annee + ') : ' + data.reference);
						proposerReference(data.reference);
					})
					.catch(() => {
						if (numero !== requete) return;
						afficher('text-danger', 'Proposition de référence impossible, réessayez.');
					});
			}
			function surSaisie() {
				clearTimeout(minuterie);
				if (!changee()) {
					requete++;
					bloc.classList.add('d-none');
					afficher('', '');
					if (epi) epi.value = epiInitial;
					proposerReference(referenceActuelle);
					return;
				}
				bloc.classList.remove('d-none');
				if (champ.value.trim() === '') {
					requete++;
					afficher('text-danger', 'La catégorie est obligatoire.');
					return;
				}
				minuterie = setTimeout(suggerer, 400);
			}

			champ.addEventListener('input', surSaisie);
			champ.form.addEventListener('submit', function (e) {
				if (!champ.disabled && changee() && confirmation.value.trim() !== motAttendu) {
					e.preventDefault();
					confirmation.classList.add('is-invalid');
					confirmation.focus();
				}
			});
			confirmation.addEventListener('input', function () {
				confirmation.classList.toggle('is-invalid', false);
			});
			// Retour du serveur avec une catégorie saisie : relancer la proposition
			if (changee()) { surSaisie(); }
		})();
	</script>
	<script>
		/**
		 * [2026-10-24] Roue dentée (super-administrateur) : active ou
		 * verrouille ensemble la référence et la catégorie. Au verrouillage,
		 * les valeurs d'origine sont rétablies (champs désactivés ⇒ non
		 * envoyés : rien ne change côté serveur).
		 */
		(function () {
			const bouton = document.getElementById('deverrouiller-ref-cat');
			const categorie = document.getElementById('categorie');
			const reference = document.getElementById('reference');
			if (!bouton || !categorie || !reference) return;
			const libelle = bouton.querySelector('span');
			const lot = document.getElementById('lot');
			const lotDefaut = document.getElementById('lot_defaut');
			const nombreInitial = document.getElementById('nombre_initial');
			const nombre = document.getElementById('nombre');

			function retablir(champ, valeur, idConfirmation) {
				champ.classList.remove('is-invalid');
				if (champ.value !== valeur) {
					champ.value = valeur;
					champ.dispatchEvent(new Event('input'));
				}
				const confirmation = document.getElementById(idConfirmation);
				confirmation.value = '';
				confirmation.classList.remove('is-invalid');
			}

			bouton.addEventListener('click', function () {
				const ouvrir = categorie.disabled;
				if (!ouvrir) {
					// La catégorie d'abord : elle peut remettre la référence proposée.
					retablir(categorie, categorie.dataset.categorieActuelle, 'confirmation_categorie');
					retablir(reference, reference.dataset.referenceActuelle, 'confirmation_reference');
					// Lot : valeurs d'origine (nombre actuel compris)
					lot.checked = lot.dataset.initial === '1';
					nombreInitial.value = nombreInitial.dataset.initial;
					nombreInitial.classList.remove('is-invalid');
					nombre.value = nombre.dataset.initial;
					lot.dispatchEvent(new Event('change'));
				}
				categorie.disabled = !ouvrir;
				reference.disabled = !ouvrir;
				lot.disabled = lotDefaut.disabled = !ouvrir;
				// Masqué (lot décoché) : désactivé, sinon sa valeur 1 < min bloquerait l'envoi.
				nombreInitial.disabled = !ouvrir || !lot.checked;
				bouton.setAttribute('aria-pressed', ouvrir ? 'true' : 'false');
				libelle.textContent = ouvrir
					? 'Annuler la modification de la référence, de la catégorie et du lot'
					: 'Modifier la référence, la catégorie et le lot (dissocier, regrouper)';
				// Cartes « Dissocier le lot » / « Regrouper en lot » : affichées avec la roue dentée.
				document.querySelectorAll('.carte-lot').forEach(function (carte) {
					carte.classList.toggle('d-none', !ouvrir);
					if (!ouvrir) carte.dispatchEvent(new Event('reinitialiser'));
				});
				// Sans défilement : les cartes du lot, juste sous la roue, restent visibles.
				if (ouvrir) categorie.focus({ preventScroll: true });
			});
		})();
	</script>
	<script>
		/**
		 * [2026-10-24] Lot (super-administrateur) : la case affiche le
		 * nombre initial et le nombre actuel ; décochée, les deux reviennent
		 * à 1. Le nombre actuel reste plafonné au nombre initial ; pour un
		 * nouveau lot, il suit le nombre initial (lot complet) tant qu'il
		 * n'a pas été saisi à la main.
		 */
		(function () {
			const lot = document.getElementById('lot');
			const nombreInitial = document.getElementById('nombre_initial');
			const nombre = document.getElementById('nombre');
			if (!lot || !nombreInitial || !nombre) return;
			const blocInitial = document.getElementById('bloc-nombre-initial');
			const blocNombre = document.getElementById('bloc-nombre');
			const etaitLot = lot.dataset.initial === '1';
			let niPrecedent = parseInt(nombreInitial.value, 10);

			function plafonner(suivre) {
				const ni = parseInt(nombreInitial.value, 10);
				if (!(ni >= 2)) return;
				nombre.max = ni;
				if (suivre || parseInt(nombre.value, 10) > ni) nombre.value = ni;
				niPrecedent = ni;
			}
			lot.addEventListener('change', function () {
				blocInitial.classList.toggle('d-none', !lot.checked);
				nombreInitial.disabled = lot.disabled || !lot.checked;
				blocNombre.classList.toggle('d-none', !lot.checked);
				if (lot.checked) {
					if (!(parseInt(nombreInitial.value, 10) >= 2)) nombreInitial.value = 2;
					plafonner(!etaitLot && nombre.value === '1');
				} else {
					nombreInitial.value = 1;
					niPrecedent = 1;
					nombre.value = 1;
					nombre.max = 1;
				}
			});
			nombreInitial.addEventListener('input', function () {
				plafonner(!etaitLot && parseInt(nombre.value, 10) === niPrecedent);
			});
		})();
	</script>
	<script>
		/**
		 * [2026-10-24] Dissociation du lot (super-administrateur) : la
		 * répartition est contrôlée pendant la saisie (somme = nombre
		 * actuel) ; une référence est proposée pour chaque nouvel
		 * équipement (n° suivants du modèle), modifiable, et sa
		 * disponibilité vérifiée. Mot de confirmation exigé avant l'envoi
		 * (tout est revérifié côté serveur).
		 */
		(function () {
			const carte = document.getElementById('carte-dissociation');
			const form = document.getElementById('form-dissociation');
			if (!form) return;
			const saisie = document.getElementById('repartition');
			const nombre = parseInt(saisie.dataset.nombre, 10);
			const statut = document.getElementById('repartition-statut');
			const liste = document.getElementById('dissociation-references');
			const confirmation = document.getElementById('confirmation_dissociation');
			const motAttendu = confirmation.dataset.mot;
			const id = form.dataset.equipementId;
			// [2026-10-24] Admin : références imposées (lecture seule, recalculées
			// par le serveur) ; seul le super-administrateur les modifie.
			const modifiables = form.dataset.referencesModifiables === '1';
			let parties = null;
			let lignes = [];
			let minuterie = null;
			let requete = 0;

			function afficher(element, classe, texte) {
				element.className = 'form-text ' + classe;
				element.textContent = texte;
			}
			// Même règle que DissociationLot::parties()
			function analyser(texte) {
				const morceaux = texte.trim().split(/[\s,;+]+/).filter(m => m !== '');
				if (morceaux.length < 2) return 'Indiquez au moins deux parties.';
				if (morceaux.some(m => !/^\d+$/.test(m) || parseInt(m, 10) < 1)) return 'Chaque partie doit être un entier ≥ 1.';
				const tailles = morceaux.map(m => parseInt(m, 10));
				const somme = tailles.reduce((a, b) => a + b, 0);
				if (somme !== nombre) return 'Somme des parties : ' + somme + ' ; elle doit être égale à ' + nombre + '.';
				return tailles;
			}
			function doublons() {
				const vues = {};
				lignes.forEach(l => { const v = l.input.value.trim(); vues[v] = (vues[v] || 0) + 1; });
				return vues;
			}
			function verifier(ligne) {
				const valeur = ligne.input.value.trim();
				const numero = ++ligne.requete;
				ligne.disponible = null;
				if (!modifiables) {
					ligne.disponible = valeur !== '';
					afficher(ligne.statut, valeur !== '' ? 'text-muted' : 'text-danger', valeur !== ''
						? 'Attribuée automatiquement.'
						: 'Aucune référence proposée : demandez à un super-administrateur.');
					return;
				}
				if (valeur === '') { afficher(ligne.statut, 'text-danger', 'La référence est obligatoire.'); return; }
				if (doublons()[valeur] > 1) {
					ligne.disponible = false;
					afficher(ligne.statut, 'text-danger', '✖ Référence saisie deux fois.');
					return;
				}
				afficher(ligne.statut, 'text-muted', 'Vérification…');
				fetch('/equipements/reference-disponible?' + new URLSearchParams({ id: id, reference: valeur }),
					{ headers: { 'Accept': 'application/json' }, credentials: 'same-origin' })
					.then(r => { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })
					.then(data => {
						if (numero !== ligne.requete) return;
						ligne.disponible = !!data.disponible;
						afficher(ligne.statut, ligne.disponible ? 'text-success' : 'text-danger',
							(ligne.disponible ? '✔ ' : '✖ ') + data.message);
					})
					.catch(() => {
						if (numero !== ligne.requete) return;
						afficher(ligne.statut, 'text-danger', 'Vérification impossible, réessayez.');
					});
			}
			function verifierTout() {
				lignes.forEach(verifier);
			}
			function creerLigne() {
				const bloc = document.createElement('div');
				bloc.className = 'mb-2';
				const label = document.createElement('label');
				label.className = 'form-label small mb-1';
				const input = document.createElement('input');
				input.type = 'text';
				input.className = 'form-control form-control-sm';
				input.name = 'references[]';
				input.maxLength = {{ reference_max }};
				input.autocomplete = 'off';
				input.required = true;
				input.readOnly = !modifiables;
				input.id = 'reference_dissociation_' + lignes.length;
				label.htmlFor = input.id;
				const etat = document.createElement('div');
				etat.className = 'form-text';
				etat.setAttribute('aria-live', 'polite');
				bloc.append(label, input, etat);
				liste.appendChild(bloc);
				const ligne = { bloc: bloc, label: label, input: input, statut: etat, manuelle: false, disponible: null, requete: 0, minuterie: null };
				input.addEventListener('input', function () {
					ligne.manuelle = true;
					clearTimeout(ligne.minuterie);
					ligne.minuterie = setTimeout(verifierTout, 300);
				});
				return ligne;
			}
			function proposer() {
				const numero = ++requete;
				fetch('/equipements/dissociation-references?' + new URLSearchParams({ id: id, nombre: lignes.length }),
					{ headers: { 'Accept': 'application/json' }, credentials: 'same-origin' })
					.then(r => { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })
					.then(data => {
						if (numero !== requete) return;
						const references = data.references || [];
						lignes.forEach((ligne, i) => {
							if (!ligne.manuelle && references[i]) ligne.input.value = references[i];
						});
						verifierTout();
					})
					.catch(() => { if (numero === requete) verifierTout(); });
			}
			function surSaisie() {
				const resultat = analyser(saisie.value);
				if (typeof resultat === 'string') {
					parties = null;
					afficher(statut, saisie.value.trim() === '' ? '' : 'text-danger', saisie.value.trim() === '' ? '' : resultat);
					return;
				}
				parties = resultat;
				afficher(statut, 'text-success', '✔ ' + parties[0] + ' élément(s) restent sur l\'équipement actuel ; '
					+ (parties.length - 1) + ' nouvel(s) équipement(s).');
				while (lignes.length > parties.length - 1) lignes.pop().bloc.remove();
				while (lignes.length < parties.length - 1) lignes.push(creerLigne());
				lignes.forEach((ligne, i) => {
					const taille = parties[i + 1];
					ligne.label.textContent = 'Nouvel équipement ' + (i + 1) + ' — '
						+ (taille > 1 ? 'lot de ' + taille + ' éléments' : 'équipement individuel') + ' : référence';
				});
				proposer();
			}

			saisie.addEventListener('input', function () {
				clearTimeout(minuterie);
				minuterie = setTimeout(surSaisie, 300);
			});
			document.getElementById('repartition-individuels').addEventListener('click', function () {
				saisie.value = Array(nombre).fill(1).join(', ');
				surSaisie();
			});
			carte.addEventListener('reinitialiser', function () {
				clearTimeout(minuterie);
				requete++;
				saisie.value = '';
				confirmation.value = '';
				confirmation.classList.remove('is-invalid');
				parties = null;
				lignes.forEach(l => l.bloc.remove());
				lignes = [];
				afficher(statut, '', '');
			});
			confirmation.addEventListener('input', function () {
				confirmation.classList.remove('is-invalid');
			});
			form.addEventListener('submit', function (e) {
				if (parties === null) {
					e.preventDefault();
					afficher(statut, 'text-danger', analyser(saisie.value));
					saisie.focus();
					return;
				}
				const enAttente = lignes.find(l => l.disponible !== true);
				if (enAttente) {
					e.preventDefault();
					if (enAttente.disponible === null) afficher(enAttente.statut, 'text-danger', 'Vérification en cours, réessayez dans un instant.');
					enAttente.input.focus();
					return;
				}
				if (confirmation.value.trim() !== motAttendu) {
					e.preventDefault();
					confirmation.classList.add('is-invalid');
					confirmation.focus();
				}
			});
		})();
	</script>
	<script>
		/**
		 * [2026-10-24] Admin : bouton « Dissocier le lot » / « Regrouper en
		 * lot » (le super-administrateur passe par la roue dentée). Il affiche
		 * les cartes du lot ; un nouveau clic les masque et les réinitialise.
		 */
		(function () {
			const bouton = document.getElementById('afficher-lot');
			if (!bouton) return;
			const cartes = document.querySelectorAll('.carte-lot');
			bouton.addEventListener('click', function () {
				const afficher = bouton.getAttribute('aria-pressed') !== 'true';
				cartes.forEach(function (carte) {
					carte.classList.toggle('d-none', !afficher);
					if (!afficher) carte.dispatchEvent(new Event('reinitialiser'));
				});
				bouton.setAttribute('aria-pressed', afficher ? 'true' : 'false');
				bouton.querySelector('span').textContent = afficher ? 'Annuler' : bouton.dataset.libelle;
			});
		})();
	</script>
	<script>
		/**
		 * [2026-10-24] Regroupement en lot : récapitulatif du lot obtenu ;
		 * au moins un équipement coché et mot de confirmation exigés avant
		 * l'envoi (tout est revérifié côté serveur).
		 */
		(function () {
			const form = document.getElementById('form-regroupement');
			if (!form) return;
			const carte = document.getElementById('carte-regroupement');
			const choix = Array.from(form.querySelectorAll('.regroupement-choix'));
			const statut = document.getElementById('regroupement-statut');
			const confirmation = document.getElementById('confirmation_regroupement');

			function coches() {
				return choix.filter(c => c.checked);
			}
			function resumer() {
				const liste = coches();
				if (liste.length === 0) {
					statut.className = 'form-text mb-2';
					statut.textContent = '';
					return;
				}
				const somme = (cle) => liste.reduce((t, c) => t + parseInt(c.dataset[cle], 10), parseInt(form.dataset[cle], 10));
				statut.className = 'form-text mb-2 text-success';
				statut.textContent = '✔ Lot obtenu : ' + somme('nombre') + ' élément(s) (nombre initial ' + somme('nombreInitial')
					+ ') ; ' + liste.length + ' équipement(s) archivé(s).';
			}
			choix.forEach(c => c.addEventListener('change', resumer));
			confirmation.addEventListener('input', () => confirmation.classList.remove('is-invalid'));
			carte.addEventListener('reinitialiser', function () {
				choix.forEach(c => { c.checked = false; });
				confirmation.value = '';
				confirmation.classList.remove('is-invalid');
				resumer();
			});
			form.addEventListener('submit', function (e) {
				if (coches().length === 0) {
					e.preventDefault();
					statut.className = 'form-text mb-2 text-danger';
					statut.textContent = 'Cochez au moins un équipement à regrouper.';
					return;
				}
				if (confirmation.value.trim() !== confirmation.dataset.mot) {
					e.preventDefault();
					confirmation.classList.add('is-invalid');
					confirmation.focus();
				}
			});
		})();
	</script>
