{% extends "_layout.twig" %}

{% block body %}
	<h3>🤝 Nouvelle fiche de prêt</h3>
	<hr>
	<form method="post" style="max-width: 50rem;">
		<input type="hidden" name="csrf_token" value="{{ csrf_token }}">
		<h5>Emprunteur</h5>
		{% include 'prets/_emprunteur.twig' with {mode: 'tout'} %}
		<button type="submit" class="btn btn-primary">Créer la fiche</button>
		<a href="/prets" class="btn btn-secondary">Annuler</a>
	</form>
{% endblock %}
