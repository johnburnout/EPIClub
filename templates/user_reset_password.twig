{% extends "_layout.twig" %}

{% block body %}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Réinitialisation du mot de passe</h4>
                </div>
                <div class="card-body">
                    <form method="post">
                        <input type="hidden" name="token" value="{{ token }}">

                        <div class="mb-3">
                            <label for="password" class="form-label">Nouveau mot de passe *</label>
                            <input type="password" class="form-control {% if form_errors.password %}is-invalid{% endif %}" 
                                   id="password" name="password" required>
                            {% if form_errors.password %}
                                <div class="invalid-feedback">{{ form_errors.password }}</div>
                            {% endif %}
                        </div>

                        <div class="mb-3">
                            <label for="confirm_password" class="form-label">Confirmer le mot de passe *</label>
                            <input type="password" class="form-control {% if form_errors.confirm_password %}is-invalid{% endif %}" 
                                   id="confirm_password" name="confirm_password" required>
                            {% if form_errors.confirm_password %}
                                <div class="invalid-feedback">{{ form_errors.confirm_password }}</div>
                            {% endif %}
                        </div>

                        <button type="submit" class="btn btn-primary">Réinitialiser</button>
                        <a href="/" class="btn btn-secondary">Annuler</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}