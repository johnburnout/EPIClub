{% extends "_layout.twig" %}

{% macro champ(nom, libelle, saisie, form_errors) %}
	<div class="form-check form-switch mb-2">
		<input class="form-check-input case-appliquer" type="checkbox" role="switch"
		       name="appliquer[{{ nom }}]" id="appliquer_{{ nom }}" value="1" data-cible="bloc_{{ nom }}"
		       {% if saisie.appliquer[nom] is defined %}checked{% endif %}>
		<label class="form-check-label fw-bold" for="appliquer_{{ nom }}">Modifier : {{ libelle }}</label>
	</div>
{% endmacro %}

{% block body %}
	{% import _self as m %}

	<h3>Modification groupée</h3>
	<p class="text-body-secondary mb-2">
		{{ equipements|length }} équipement{{ equipements|length > 1 ? 's' : '' }} sélectionné{{ equipements|length > 1 ? 's' : '' }}.
		Seuls les champs dont la case « Modifier » est cochée sont appliqués ; les autres restent inchangés.
	</p>
	<hr>

	{% for message in form_errors %}
		<div class="alert alert-danger">{{ message }}</div>
	{% endfor %}

	<div class="row g-4">
		<div class="col-lg-7">
			<form method="post" action="/equipements/modification-groupee" enctype="multipart/form-data" id="form-groupe">
				<input type="hidden" name="csrf_token" value="{{ csrf_token }}">
				<input type="hidden" name="retour" value="{{ retour_query }}">
				{% for equipement in equipements %}
					<input type="hidden" name="ids[]" value="{{ equipement.id }}">
				{% endfor %}

				{# --- Statut --- #}
				<div class="card card-body mb-3">
					{{ m.champ('statut', 'Statut', saisie, form_errors) }}
					<div id="bloc_statut">
						<select name="statut" class="form-select">
							{% for libelle, valeur in equipement_statuts %}
								<option value="{{ valeur }}" {% if saisie.statut is defined and saisie.statut == valeur %}selected{% endif %}>{{ libelle }}</option>
							{% endfor %}
						</select>
					</div>
				</div>

				{# --- Emplacement --- #}
				<div class="card card-body mb-3">
					{{ m.champ('emplacement_id', 'Emplacement', saisie, form_errors) }}
					<div id="bloc_emplacement_id">
						<select name="emplacement_id" class="form-select">
							<option value="">Non défini</option>
							{% for emplacement in emplacements %}
								<option value="{{ emplacement.id }}" {% if saisie.emplacement_id is defined and saisie.emplacement_id == emplacement.id %}selected{% endif %}>{{ emplacement.libelle }}</option>
							{% endfor %}
						</select>
					</div>
				</div>

				{# --- Libellé (super-admin) --- #}
				{% if super_admin %}
				<div class="card card-body mb-3">
					{{ m.champ('libelle', 'Libellé', saisie, form_errors) }}
					<div id="bloc_libelle">
						<input type="text" name="libelle" class="form-control" maxlength="255" value="{{ saisie.libelle ?? '' }}">
						<small class="text-muted">Réservé au super-administrateur.</small>
					</div>
				</div>
				{% endif %}

				{# --- Date de mise en service --- #}
				<div class="card card-body mb-3">
					{{ m.champ('date_mise_en_service', 'Date de mise en service', saisie, form_errors) }}
					<div id="bloc_date_mise_en_service">
						<input type="date" name="date_mise_en_service" class="form-control" value="{{ saisie.date_mise_en_service ?? '' }}">
						<small class="text-muted">
							Jamais avant la date de facture de chaque équipement.
							{% if not super_admin %}
								Les équipements dont la date a déjà été modifiée une fois sont ignorés (et signalés).
							{% endif %}
						</small>
					</div>
				</div>

				{# --- Date de fin d'utilisation --- #}
				<div class="card card-body mb-3">
					{{ m.champ('date_fin_utilisation', "Date de fin d'utilisation", saisie, form_errors) }}
					<div id="bloc_date_fin_utilisation">
						<input type="date" name="date_fin_utilisation" class="form-control" value="{{ saisie.date_fin_utilisation ?? '' }}">
						<small class="text-muted">Laisser vide pour effacer la date.</small>
					</div>
				</div>

				{# --- Durée maximum d'utilisation --- #}
				<div class="card card-body mb-3">
					{{ m.champ('duree_max_utilisation', "Durée maximum d'utilisation", saisie, form_errors) }}
					<div id="bloc_duree_max_utilisation">
						<select name="duree_max_utilisation" class="form-select">
							<option value="1" {% if (saisie.duree_max_utilisation ?? '') == '1' %}selected{% endif %}>Oui (durée de vie limitée par le fabricant)</option>
							<option value="0" {% if (saisie.duree_max_utilisation ?? '') == '0' %}selected{% endif %}>Non</option>
						</select>
					</div>
				</div>

				{# --- Remarques --- #}
				<div class="card card-body mb-3">
					{{ m.champ('remarques', 'Remarques', saisie, form_errors) }}
					<div id="bloc_remarques">
						<textarea name="remarques" class="form-control mb-2" rows="3">{{ saisie.remarques ?? '' }}</textarea>
						<div class="form-check form-check-inline">
							<input class="form-check-input" type="radio" name="remarques_mode" id="remarques_ajouter" value="ajouter"
							       {% if (saisie.remarques_mode ?? 'ajouter') == 'ajouter' %}checked{% endif %}>
							<label class="form-check-label" for="remarques_ajouter">Ajouter à la suite</label>
						</div>
						<div class="form-check form-check-inline">
							<input class="form-check-input" type="radio" name="remarques_mode" id="remarques_remplacer" value="remplacer"
							       {% if (saisie.remarques_mode ?? '') == 'remplacer' %}checked{% endif %}>
							<label class="form-check-label" for="remarques_remplacer">Remplacer</label>
						</div>
					</div>
				</div>

				{# --- Photo --- #}
				<div class="card card-body mb-3">
					{{ m.champ('photo', 'Photo', saisie, form_errors) }}
					<div id="bloc_photo">
						<input type="file" name="photo" class="form-control" accept="image/jpeg,image/png,image/webp,image/gif">
						<small class="text-muted">La même photo est affectée à tous les équipements sélectionnés (photo existante remplacée).</small>
					</div>
				</div>

				<button type="submit" class="btn btn-primary">Appliquer aux {{ equipements|length }} équipement{{ equipements|length > 1 ? 's' : '' }}</button>
				<a href="{{ retour_url }}" class="btn btn-secondary">Annuler</a>
			</form>
		</div>

		<div class="col-lg-5">
			<h5>Équipements sélectionnés</h5>
			<div class="table-responsive" style="max-height: 70vh;">
				<table class="table table-sm table-striped">
					<thead>
						<tr><th>Référence</th><th>Libellé</th><th>Mise en service</th><th>Photo</th></tr>
					</thead>
					<tbody>
						{% for equipement in equipements %}
							<tr>
								<td>{{ equipement.reference }}</td>
								<td>{{ equipement.libelle }}</td>
								<td>{{ equipement.date_mise_en_service ? equipement.date_mise_en_service|date('d/m/Y') : '—' }}</td>
								<td>
									{% if equipement.photo %}
										<img src="{{ equipement.photo }}" alt="" style="max-width: 32px; max-height: 32px;">
									{% else %}—{% endif %}
								</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
			</div>
		</div>
	</div>
{% endblock %}

{% block javascripts %}
	{{ parent() }}
	<script>
		// Les champs ne sont actifs que si « Modifier » est coché.
		document.addEventListener('DOMContentLoaded', function () {
			const cases = document.querySelectorAll('.case-appliquer');
			function maj(c) {
				const bloc = document.getElementById(c.dataset.cible);
				if (!bloc) { return; }
				bloc.querySelectorAll('input, select, textarea').forEach(el => { el.disabled = !c.checked; });
				bloc.style.opacity = c.checked ? '1' : '.5';
			}
			cases.forEach(c => { c.addEventListener('change', () => maj(c)); maj(c); });
			document.getElementById('form-groupe').addEventListener('submit', function (e) {
				const nb = Array.from(cases).filter(c => c.checked).length;
				if (nb === 0) {
					e.preventDefault();
					alert('Cochez « Modifier » pour au moins un champ.');
					return;
				}
				if (!confirm('Appliquer ces modifications aux {{ equipements|length }} équipement(s) sélectionné(s) ?')) {
					e.preventDefault();
				}
			});
		});
	</script>
{% endblock %}
