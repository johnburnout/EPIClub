{
    "name": "epiclub/epiclub",
    "description": "Gestionnaire d'Equipements de Protection Individuelle (EPI)",
    "license": "LGPL-3.0-or-later",
    "require": {
        "php": ">=8.4",
        "ext-gd": "*",
        "ext-fileinfo": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-zip": "*",
        "symfony/http-foundation": "^7.3",
        "twig/twig": "^3.21",
        "symfony/routing": "^7.3",
        "tecnickcom/tc-lib-barcode": "^2.4",
        "symfony/mailer": "^7.3",
        "symfony/mime": "^7.3",
        "dompdf/dompdf": "^3.1",
        "endroid/qr-code": "^6.0",
        "phpoffice/phpspreadsheet": "^5.9",
        "erusev/parsedown": "^1.8"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Epiclub\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Epiclub\\Tests\\": "tests/"
        }
    }
}